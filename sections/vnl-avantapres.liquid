{%- comment -%} Comparaison avant / après à curseur (même pièce, plafonnier vs veilleuse). Masquée en ligne tant que les deux photos manquent. {%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign ba_show = request.design_mode -%}
{%- if s.before != blank and s.after != blank -%}{%- assign ba_show = true -%}{%- endif -%}
{%- if ba_show -%}
{% render 'vnl-head' %}
<style>
  #vnl-ba-{{ section.id }} .ba{position:relative;margin-top:32px;aspect-ratio:16/10;border-radius:var(--rl);overflow:hidden;background:var(--bg2);user-select:none;--x:50%}
  #vnl-ba-{{ section.id }} .ba>div{position:absolute;inset:0}
  #vnl-ba-{{ section.id }} .ba img{width:100%;height:100%;object-fit:cover}
  #vnl-ba-{{ section.id }} .ba .after{clip-path:inset(0 0 0 var(--x))}
  #vnl-ba-{{ section.id }} .lab{position:absolute;top:16px;z-index:2;padding:4px 12px;border-radius:6px;background:#fff;color:#000;font-size:13px}
  #vnl-ba-{{ section.id }} .line{position:absolute;top:0;bottom:0;left:var(--x);width:3px;margin-left:-1.5px;background:#fff;z-index:2;pointer-events:none}
  #vnl-ba-{{ section.id }} .line::after{content:"|||";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:40px;height:40px;border-radius:50%;background:#fff;color:#000;display:grid;place-items:center;font-size:11px;letter-spacing:1px}
  #vnl-ba-{{ section.id }} input[type=range]{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;z-index:3;margin:0}
</style>
<div class="vnl" id="vnl-ba-{{ section.id }}"><div class="vnl-wrap vnl-sec">
  <h2>{{ s.title }}</h2>
  <div class="ba" data-ba>
    <div class="before">{%- if s.before != blank -%}{{ s.before | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', alt: s.before_label }}{%- else -%}<div class="vnl-mock"><span>AVANT · PLAFONNIER ALLUMÉ, SALON · 16:10</span></div>{%- endif -%}</div>
    <div class="after">{%- if s.after != blank -%}{{ s.after | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', alt: s.after_label }}{%- else -%}<div class="vnl-mock" style="background:linear-gradient(150deg,#C26A1E,#8C4404)"><span style="color:#fff">APRÈS · VEILLEUSE SEULE, LUEUR AMBRÉE · 16:10</span></div>{%- endif -%}</div>
    <span class="lab" style="left:16px">{{ s.before_label }}</span>
    <span class="lab" style="right:16px">{{ s.after_label }}</span>
    <span class="line" aria-hidden="true"></span>
    <input type="range" min="0" max="100" value="50" aria-label="Comparer avant et après">
  </div>
  {%- if s.caption != blank -%}<p class="txt" style="text-align:center;max-width:560px;margin:22px auto 0">{{ s.caption }}</p>{%- endif -%}
</div></div>
<script>
(function () {
  var box = document.querySelector('#vnl-ba-{{ section.id }} [data-ba]'); if (!box) return;
  var r = box.querySelector('input');
  r.addEventListener('input', function () { box.style.setProperty('--x', r.value + '%'); });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Veilleuse · Avant / après",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Plafonnier ou petite lueur ?" },
    { "type": "textarea", "id": "caption", "label": "Texte sous le curseur (vide = masqué)", "default": "Même pièce, même soir. Seule la lumière a changé." },
    { "type": "image_picker", "id": "before", "label": "Photo avant (16:10)" },
    { "type": "text", "id": "before_label", "label": "Étiquette avant", "default": "Avant" },
    { "type": "image_picker", "id": "after", "label": "Photo après (16:10, même cadrage)" },
    { "type": "text", "id": "after_label", "label": "Étiquette après", "default": "Après" }
  ],
  "presets": [ { "name": "Veilleuse · Avant / après" } ]
}
{% endschema %}
