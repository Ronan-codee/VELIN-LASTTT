{%- comment -%}
  Image ou mock. Paramètres : image, label, width, first (1re image de la galerie : chargée tout de suite, prioritaire).
  Sans image, affiche un bloc gris étiqueté (emplacement à remplir depuis l'éditeur de thème).
{%- endcomment -%}
{%- if image -%}
  {%- assign lpn_alt = alt | default: label -%}
  {%- if first -%}
    {{ image | image_url: width: width | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400, 600, 800, 1000', sizes: '(max-width: 900px) 100vw, 50vw', alt: lpn_alt, class: 'lpn-img' }}
  {%- else -%}
    {{ image | image_url: width: width | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(max-width: 900px) 100vw, 50vw', alt: lpn_alt, class: 'lpn-img' }}
  {%- endif -%}
{%- else -%}
  <div class="lpn-mock" role="img" aria-label="{{ label | escape }}"><span>{{ label }}</span></div>
{%- endif -%}
