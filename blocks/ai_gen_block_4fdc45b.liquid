{% doc %}
  @prompt
    Modifier le bloc "Rotating announcement bar" existant (block ID: sections--29530246480255__blocks_WRXHdq__ai_gen_block_938a584_B8Pz9E) pour ajouter un 4ème champ de message appelé `message_4` avec la valeur par défaut "30 jours pour changer d'avis". Le bloc doit conserver les 3 messages existants (message_1, message_2, message_3) et afficher également ce nouveau message_4 dans la rotation.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-rotating-announcement-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding }}px 20px;
    text-align: center;
    overflow: hidden;
    position: relative;
    width: 100%;
    display: block;
  }

  .ai-rotating-announcement__message-{{ ai_gen_id }} {
    opacity: 0;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    transition: opacity {{ block.settings.transition_speed }}s ease-in-out;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
  }

  .ai-rotating-announcement__message-{{ ai_gen_id }}.active {
    opacity: 1;
    position: relative;
    top: auto;
    left: auto;
    transform: none;
  }
{% endstyle %}

<rotating-announcement-{{ ai_gen_id }}
  class="ai-rotating-announcement-{{ ai_gen_id }}"
  data-interval="{{ block.settings.rotation_interval }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.message_1 != blank %}
    <div class="ai-rotating-announcement__message-{{ ai_gen_id }} active">
      {{ block.settings.message_1 }}
    </div>
  {% endif %}

  {% if block.settings.message_2 != blank %}
    <div class="ai-rotating-announcement__message-{{ ai_gen_id }}">
      {{ block.settings.message_2 }}
    </div>
  {% endif %}

  {% if block.settings.message_3 != blank %}
    <div class="ai-rotating-announcement__message-{{ ai_gen_id }}">
      {{ block.settings.message_3 }}
    </div>
  {% endif %}

  {% if block.settings.message_4 != blank %}
    <div class="ai-rotating-announcement__message-{{ ai_gen_id }}">
      {{ block.settings.message_4 }}
    </div>
  {% endif %}
</rotating-announcement-{{ ai_gen_id }}>

<script>
  (function() {
    class RotatingAnnouncement{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.messages = [];
        this.intervalId = null;
      }

      connectedCallback() {
        this.messages = Array.from(
          this.querySelectorAll('.ai-rotating-announcement__message-{{ ai_gen_id }}')
        );
        
        if (this.messages.length > 1) {
          const interval = parseInt(this.dataset.interval) * 1000;
          this.startRotation(interval);
        }
      }

      startRotation(interval) {
        this.intervalId = setInterval(() => {
          this.messages[this.currentIndex].classList.remove('active');
          this.currentIndex = (this.currentIndex + 1) % this.messages.length;
          this.messages[this.currentIndex].classList.add('active');
        }, interval);
      }

      disconnectedCallback() {
        if (this.intervalId) {
          clearInterval(this.intervalId);
        }
      }
    }

    customElements.define('rotating-announcement-{{ ai_gen_id }}', RotatingAnnouncement{{ ai_gen_id }});
  })();
</script>

