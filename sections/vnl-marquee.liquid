{%- comment -%} Bandeau défilant de courtes phrases avec pictogramme (usages ou réassurance). Un bloc = une phrase. {%- endcomment -%}
{%- assign s = section.settings -%}
{%- if section.blocks.size > 0 -%}
{% render 'vnl-head' %}
<style>
  #vnl-mq-{{ section.id }}{background:{{ s.bg }};color:{{ s.fg }};padding:{{ s.pad }}px 0;overflow:hidden}
  #vnl-mq-{{ section.id }} .track{display:flex;width:max-content;animation:vnl-mq {{ s.speed }}s linear infinite}
  #vnl-mq-{{ section.id }} .row{display:flex;flex:none}
  #vnl-mq-{{ section.id }} .it{display:inline-flex;align-items:center;gap:10px;padding:0 34px;white-space:nowrap;font-family:{% if s.serif %}'Playfair Display',Georgia,serif{% else %}'Nunito Sans',sans-serif{% endif %};font-size:15px}
  #vnl-mq-{{ section.id }} svg{flex:none}
  @keyframes vnl-mq{to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion:reduce){#vnl-mq-{{ section.id }} .track{animation:none;flex-wrap:wrap;width:auto;justify-content:center}#vnl-mq-{{ section.id }} .row+.row{display:none}}
</style>
<div class="vnl" id="vnl-mq-{{ section.id }}" role="region" aria-label="{{ s.aria | escape }}">
  <div class="track">
    {%- for k in (1..2) -%}
    <div class="row"{% if k == 2 %} aria-hidden="true"{% endif %}>
      {%- for r in (1..3) -%}{%- for b in section.blocks -%}
        <span class="it"{% if k == 1 and r == 1 %} {{ b.shopify_attributes }}{% endif %}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {%- case b.settings.icon -%}
            {%- when 'heart' -%}<path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/>
            {%- when 'moon' -%}<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
            {%- when 'book' -%}<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>
            {%- when 'baby' -%}<path d="M9 12h.01"/><path d="M15 12h.01"/><path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"/><path d="M19 6.3a9 9 0 0 1 1.8 3.9 2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1"/>
            {%- when 'sun' -%}<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
            {%- when 'truck' -%}<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>
            {%- when 'shield' -%}<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>
            {%- when 'mail' -%}<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            {%- when 'card' -%}<rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/>
            {%- else -%}<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>
          {%- endcase -%}
          </svg>{{ b.settings.text }}</span>
      {%- endfor -%}{%- endfor -%}
    </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Veilleuse · Défilant",
  "settings": [
    { "type": "text", "id": "aria", "label": "Nom pour lecteurs d'écran", "default": "Usages" },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#8C4404" },
    { "type": "color", "id": "fg", "label": "Texte", "default": "#F3ECE5" },
    { "type": "checkbox", "id": "serif", "label": "Police à empattements", "default": true },
    { "type": "range", "id": "pad", "label": "Hauteur (marge haute et basse)", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "speed", "label": "Durée d'un tour", "min": 10, "max": 90, "step": 5, "unit": "s", "default": 45 }
  ],
  "blocks": [
    { "type": "item", "name": "Phrase", "settings": [
      { "type": "select", "id": "icon", "label": "Pictogramme", "default": "heart", "options": [
        { "value": "heart", "label": "Cœur" }, { "value": "moon", "label": "Lune" }, { "value": "book", "label": "Livre" }, { "value": "baby", "label": "Bébé" },
        { "value": "sun", "label": "Soleil" }, { "value": "truck", "label": "Camion" }, { "value": "shield", "label": "Bouclier" }, { "value": "mail", "label": "Enveloppe" },
        { "value": "card", "label": "Carte bancaire" }, { "value": "return", "label": "Retour" }
      ] },
      { "type": "text", "id": "text", "label": "Texte", "default": "Votre phrase" }
    ] }
  ],
  "presets": [ { "name": "Veilleuse · Défilant" } ]
}
{% endschema %}
