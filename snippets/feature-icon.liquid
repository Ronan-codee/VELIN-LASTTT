      <path d="M6 23h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'truck' -%}
    <svg width="26" height="22" viewBox="0 0 640 512" fill="currentColor" aria-hidden="true"><path d="M624 352h-16V243.9c0-12.7-5.1-24.9-14.1-33.9L494 110.1c-9-9-21.2-14.1-33.9-14.1H416V48c0-26.5-21.5-48-48-48H48C21.5 0 0 21.5 0 48v320c0 26.5 21.5 48 48 48h16c0 53 43 96 96 96s96-43 96-96h128c0 53 43 96 96 96s96-43 96-96h48c8.8 0 16-7.2 16-16v-32c0-8.8-7.2-16-16-16zM160 464c-26.5 0-48-21.5-48-48s21.5-48 48-48 48 21.5 48 48-21.5 48-48 48zm320 0c-26.5 0-48-21.5-48-48s21.5-48 48-48 48 21.5 48 48-21.5 48-48 48zm16-208H416V144h44.1L544 227.9V256z"/><path d="M32 160h96c8.8 0 16-7.2 16-16v-16c0-8.8-7.2-16-16-16H32c-8.8 0-16 7.2-16 16v16c0 8.8 7.2 16 16 16zm-16 64c0 8.8 7.2 16 16 16h128c8.8 0 16-7.2 16-16v-16c0-8.8-7.2-16-16-16H32c-8.8 0-16 7.2-16 16v16zm16 96h80c8.8 0 16-7.2 16-16v-16c0-8.8-7.2-16-16-16H32c-8.8 0-16 7.2-16 16v16c0 8.8 7.2 16 16 16z"/></svg>
