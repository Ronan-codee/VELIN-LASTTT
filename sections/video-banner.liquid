{% comment %} Velin - Video Banner Section (Gallery Video Select) {% endcomment %}
<div class="velin-video-banner" id="VideoBanner-{{ section.id }}" style="
  height: {{ section.settings.banner_height }}px;
  background-color: {{ section.settings.fallback_color }};
">

  <div class="velin-video-banner__overlay" style="background: rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }});"></div>

  {% if section.settings.banner_video != blank %}
    <div class="velin-video-banner__player">
      {{ section.settings.banner_video | video_tag: loop: true, controls: false, muted: true, autoplay: true, playsinline: true, image_size: '1600x' }}
    </div>
  {% elsif request.design_mode %}
    <p class="velin-video-banner__placeholder">Select a video in the theme customizer</p>
  {% endif %}
</div>

<style>
  .velin-video-banner {
    position: relative;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .velin-video-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    transition: opacity 0.3s ease;
  }

  .velin-video-banner:hover .velin-video-banner__overlay {
    opacity: 0.2;
  }

  .velin-video-banner__placeholder {
    position: relative;
    z-index: 2;
    color: #fff;
    font-size: 16px;
    text-align: center;
  }

  .velin-video-banner__player {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .velin-video-banner__player video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .velin-video-banner {
      height: 320px !important;
    }
  }
</style>

<script>
  (function() {
    var sectionId = "{{ section.id }}";
    var wrapper = document.getElementById("VideoBanner-" + sectionId);
    if (!wrapper) return;

    var videoEl = wrapper.querySelector(".velin-video-banner__player video");
    if (!videoEl) return;

    videoEl.muted = true;
    videoEl.loop = true;
    videoEl.play().catch(function () {});
  })();
</script>

{% schema %}
{
  "name": "Velin Video Banner",
  "settings": [
    {
      "type": "video",
      "id": "banner_video",
      "label": "Select Video",
      "info": "Gallery se video select karein ya naya upload karein"
    },
    {
      "type": "color",
      "id": "fallback_color",
      "label": "Fallback Background Color",
      "default": "#B1B1B1"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Dark Overlay Opacity (%)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 70
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner Height (px)",
      "min": 300,
      "max": 800,
      "step": 10,
      "default": 600
    }
  ],
  "presets": [
    {
      "name": "Velin Video Banner"
    }
  ]
}
{% endschema %}