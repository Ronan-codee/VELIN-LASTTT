{%- assign sec_id = section.id -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&family=Aldrich&display=swap" rel="stylesheet">

<div id="velin-gift-promo-{{ sec_id }}" class="velin-gift-promo" style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="velin-gift-promo__inner container">
    {%- if section.settings.gift_product != blank and section.settings.gift_product.featured_image -%}
      <a href="{{ section.settings.gift_product.url }}" class="velin-gift-promo__media" aria-label="{{ section.settings.gift_product.title | escape }}">
        <img
          src="{{ section.settings.gift_product.featured_image | image_url: width: 500 }}"
          alt="{{ section.settings.gift_product.title | escape }}"
          loading="lazy"
        >
      </a>
    {%- endif -%}

    <div class="velin-gift-promo__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="velin-gift-promo__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="velin-gift-promo__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="velin-gift-promo__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
      {%- if section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_link | default: '/collections/nos-produits' }}" class="velin-gift-promo__button">
          {{ section.settings.button_text }}
        </a>
      {%- endif -%}
      {%- if section.settings.note_text != blank -%}
        <p class="velin-gift-promo__note">{{ section.settings.note_text }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .velin-gift-promo {
    width: 100%;
  }

  .velin-gift-promo__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    padding: 36px 20px;
  }

  .velin-gift-promo__media {
    flex-shrink: 0;
    display: block;
    width: 96px;
    height: 96px;
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.25s ease;
  }

  .velin-gift-promo__media:hover {
    transform: scale(1.03);
  }

  .velin-gift-promo__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .velin-gift-promo__text {
    text-align: left;
    max-width: 640px;
  }

  .velin-gift-promo__eyebrow {
    font-family: "Manrope", sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0 0 6px;
  }

  .velin-gift-promo__heading {
    font-family: "Aldrich", sans-serif;
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1.2;
    text-transform: uppercase;
    margin: 0 0 6px;
  }

  .velin-gift-promo__subtext {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    opacity: 0.85;
    margin: 0 0 14px;
    max-width: 52ch;
  }

  .velin-gift-promo__button {
    display: inline-block;
    font-family: "Manrope", sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 12px 26px;
    border-radius: 6px;
    background: {{ section.settings.accent_color }};
    color: {{ section.settings.button_text_color }};
    transition: opacity 0.2s ease;
  }

  .velin-gift-promo__button:hover {
    opacity: 0.85;
  }

  .velin-gift-promo__note {
    font-family: "Manrope", sans-serif;
    font-size: 12px;
    font-weight: 400;
    opacity: 0.7;
    margin: 10px 0 0;
  }

  @media screen and (max-width: 749px) {
    .velin-gift-promo__inner {
      flex-direction: column;
      text-align: center;
      gap: 16px;
      padding: 28px 20px;
    }

    .velin-gift-promo__text {
      text-align: center;
    }

    .velin-gift-promo__subtext {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>

{% schema %}
{
  "name": "Gift promo banner",
  "settings": [
    { "type": "product", "id": "gift_product", "label": "Gift product (photo shown)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "OFFRE EXCLUSIVE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "1 SAC ACHETÉ = LE CROCO OFFERT" },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Le porte-monnaie en cuir verni Le Croco offert dès l'achat d'un sac, dans la couleur de votre choix."
    },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "DÉCOUVRIR LA COLLECTION" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Vide = /collections/nos-produits" },
    { "type": "text", "id": "note_text", "label": "Reassurance note (below button)", "default": "Appliqué automatiquement, aucun code à saisir." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#2B241D" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#F4F1EC" },
    { "type": "color", "id": "accent_color", "label": "Accent color (eyebrow, button)", "default": "#D9A441" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#2B241D" }
  ],
  "presets": [{ "name": "Gift promo banner" }]
}
{% endschema %}
