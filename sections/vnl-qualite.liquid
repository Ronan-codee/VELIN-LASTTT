{%- comment -%} Texte (liste ✘ de ce que font les veilleuses premier prix) + carte « Les autres / Velin » côte à côte. {%- endcomment -%}
{%- assign s = section.settings -%}
{% render 'vnl-head' %}
<style>
  #vnl-q-{{ section.id }} .grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;align-items:center}
  #vnl-q-{{ section.id }} h2{text-align:left;font-size:clamp(32px,4vw,48px)}
  #vnl-q-{{ section.id }} .intro{margin-top:18px}
  #vnl-q-{{ section.id }} ul{display:grid;gap:4px;margin-top:10px}
  #vnl-q-{{ section.id }} li::before{content:"✘ ";font-weight:800}
  #vnl-q-{{ section.id }} .out{margin-top:18px}
  #vnl-q-{{ section.id }} .card{display:grid;grid-template-columns:1fr 1fr;border-radius:var(--rl);overflow:hidden;aspect-ratio:5/4}
  #vnl-q-{{ section.id }} .card>div{position:relative;display:flex;flex-direction:column;align-items:center;padding-top:22px;min-width:0}
  #vnl-q-{{ section.id }} .them{background:var(--dark);color:#fff}
  #vnl-q-{{ section.id }} .us{background:linear-gradient(160deg,#C9772B,#8C4404 70%);color:#fff}
  #vnl-q-{{ section.id }} .card b{position:relative;z-index:2;font-family:'Playfair Display',Georgia,serif;font-weight:400;font-size:clamp(24px,2.8vw,36px)}
  #vnl-q-{{ section.id }} .us b{font-style:italic}
  #vnl-q-{{ section.id }} .pic{position:absolute;inset:0}
  #vnl-q-{{ section.id }} .pic img{width:100%;height:100%;object-fit:cover}
  #vnl-q-{{ section.id }} .pic .vnl-mock{background:transparent;color:#fff;padding-top:60px}
  @media (max-width:900px){#vnl-q-{{ section.id }} .grid{grid-template-columns:minmax(0,1fr);gap:28px}}
</style>
<div class="vnl" id="vnl-q-{{ section.id }}"><div class="vnl-wrap vnl-sec">
  <div class="grid">
    <div>
      <h2>{{ s.title }}</h2>
      {%- if s.intro != blank -%}<p class="intro">{{ s.intro }}</p>{%- endif -%}
      <ul>
        {%- if s.x_1 != blank -%}<li>{{ s.x_1 }}</li>{%- endif -%}
        {%- if s.x_2 != blank -%}<li>{{ s.x_2 }}</li>{%- endif -%}
        {%- if s.x_3 != blank -%}<li>{{ s.x_3 }}</li>{%- endif -%}
        {%- if s.x_4 != blank -%}<li>{{ s.x_4 }}</li>{%- endif -%}
      </ul>
      {%- if s.outro != blank -%}<p class="out">{{ s.outro }}</p>{%- endif -%}
    </div>
    <div class="card">
      <div class="them"><b>{{ s.label_other }}</b><div class="pic">{%- if s.image_other != blank -%}{{ s.image_other | image_url: width: 700 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}<div class="vnl-mock"><span>Veilleuse générique · 1:2</span></div>{%- endif -%}</div></div>
      <div class="us"><b>{{ s.label_us }}</b><div class="pic">{%- if s.image != blank -%}{{ s.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}<div class="vnl-mock"><span>Veilleuse Velin en main · 1:2</span></div>{%- endif -%}</div></div>
    </div>
  </div>
</div></div>

{% schema %}
{
  "name": "Veilleuse · Qualité",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Choisir la qualité." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Les veilleuses premier prix rognent sur :" },
    { "type": "text", "id": "x_1", "label": "✘ 1", "default": "Une lumière trop vive ou qui scintille" },
    { "type": "text", "id": "x_2", "label": "✘ 2", "default": "Un son qui grésille ou coupe en boucle" },
    { "type": "text", "id": "x_3", "label": "✘ 3", "default": "Un câble à brancher près du lit" },
    { "type": "text", "id": "x_4", "label": "✘ 4", "default": "Un plastique léger qui ne tient pas" },
    { "type": "text", "id": "outro", "label": "Conclusion", "default": "Velin, c'est la version faite pour durer." },
    { "type": "text", "id": "label_other", "label": "Étiquette gauche", "default": "Les autres" },
    { "type": "image_picker", "id": "image_other", "label": "Photo gauche (1:2)", "info": "Une veilleuse générique sans marque, jamais le produit d'une marque identifiable." },
    { "type": "text", "id": "label_us", "label": "Étiquette droite", "default": "Velin" },
    { "type": "image_picker", "id": "image", "label": "Photo droite, Velin (1:2)" }
  ],
  "presets": [ { "name": "Veilleuse · Qualité" } ]
}
{% endschema %}
