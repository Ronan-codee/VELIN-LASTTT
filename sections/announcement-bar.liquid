{% comment %}
  VELIN — Announcement Bar Section (Infinite Marquee Loop)
  Standalone section, Theme Customizer se editable. Works on all pages.
{% endcomment %}

{%- assign sec_id = section.id -%}

<style>
  #velin-announce-{{ sec_id }} .velin-top-section {
    width: 100%;
    min-height: 50px;
    display: flex;
    align-items: center;
    background-color: {{ section.settings.announce_bg }};
    padding: 8px 0;
    overflow: hidden; /* Text container se bahar na nikle */
    position: relative;
  }

  /* Marquee wrapper: single continuous strip, animated as one piece so it
     starts flush at the left edge and never jumps. */
  #velin-announce-{{ sec_id }} .velin-marquee-wrapper {
    display: flex;
    white-space: nowrap;
    width: max-content;
    animation: velinMarquee 22s linear infinite;
  }

  #velin-announce-{{ sec_id }} .velin-marquee-content {
    display: inline-block;
    padding-right: 50px; /* Do texts ke beech ka gap */
    font-size: 18px;
    font-family: "IBM Plex Mono", monospace;
    color: {{ section.settings.announce_color }};
    letter-spacing: 1px;
  }

  /* Wrapper has 4 identical copies, so shifting by exactly one copy's
     share (-25%) loops seamlessly starting right at position 0. */
  @keyframes velinMarquee {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-25%, 0, 0); }
  }

  @media (max-width: 600px) {
    #velin-announce-{{ sec_id }} .velin-marquee-wrapper {
      animation-duration: 16s;
    }
    #velin-announce-{{ sec_id }} .velin-marquee-content {
      font-size: 13px;
      padding-right: 30px;
    }
  }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">

{%- if section.settings.show_announcement -%}
  <div id="velin-announce-{{ sec_id }}">
    <div class="velin-top-section">
      <div class="velin-marquee-wrapper">
        <!-- Ek hi text ko 4 baar repeat kiya hai taake loop toote nahi -->
        <span class="velin-marquee-content">{{ section.settings.announce_text }}</span>
        <span class="velin-marquee-content">{{ section.settings.announce_text }}</span>
        <span class="velin-marquee-content">{{ section.settings.announce_text }}</span>
        <span class="velin-marquee-content">{{ section.settings.announce_text }}</span>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Velin Announcement Bar",
  "settings": [
    { "type": "checkbox", "id": "show_announcement", "label": "Show announcement bar", "default": true },
    { "type": "text", "id": "announce_text", "label": "Announcement text", "default": "LIVRAISON GRATUITE POUR TOUTE COMMANDE SUPÉRIEURE À €250" },
    { "type": "color", "id": "announce_bg", "label": "Announcement background", "default": "#705744" },
    { "type": "color", "id": "announce_color", "label": "Announcement text color", "default": "#ffffff" }
  ],
  "presets": [
    { "name": "Velin Announcement Bar" }
  ]
}
{% endschema %}