<script>
  (function () {
    var root = document.getElementById("VelinPDP-{{ section.id }}");
    if (!root) return;

    var productData = JSON.parse(root.querySelector("[data-pdp-product]").textContent);
    var colorMediaEl = root.querySelector("[data-pdp-color-media]");
    var colorMedia = colorMediaEl ? JSON.parse(colorMediaEl.textContent) : {};
    var colorIndex = {{ color_option_index }};
    var sizeIndex = {{ size_option_index }};
    var variantInput = root.querySelector("[data-variant-id]");
    var qtyInput = root.querySelector("[data-qty-input]");
    var priceEl = document.getElementById("VelinPDPPrice-{{ section.id }}");
    var installmentEl = document.getElementById("VelinPDPInstallment-{{ section.id }}");
    var installmentCount = {{ velin_installment_count | default: 3 }};
    var mainImg = document.getElementById("VelinPDPMainImg-{{ section.id }}");
    var mainVideo = document.getElementById("VelinPDPMainVideo-{{ section.id }}");
    var thumbsRow = root.querySelector(".velin-pdp__thumbs");
    var submitBtn = root.querySelector(".velin-pdp__atc");
    var mainImageWrap = root.querySelector(".velin-pdp__main-image");
    var stickyAtc = document.querySelector("[data-sticky-atc]");
    var stickyAtcPrice = stickyAtc ? stickyAtc.querySelector("[data-sticky-atc-price]") : null;

    // Places the free-shipping line immediately above the add-to-cart button.
    // One-shot (immediate + a single delayed retry in case the Unlimited
    // Bundles widget inserts itself slightly later) — deliberately NOT an
    // ongoing MutationObserver, since that previously fought with the app's
    // own DOM-watching logic and caused it to render its widget twice.
    if (submitBtn) {
      var freeShippingEl = document.querySelector("[data-free-shipping]");
      if (freeShippingEl) {
        var placeFreeShipping = function () {
          if (submitBtn.previousElementSibling !== freeShippingEl) {
            submitBtn.parentNode.insertBefore(freeShippingEl, submitBtn);
          }
        };
        placeFreeShipping();
        setTimeout(placeFreeShipping, 800);
      }

      // Moves the free-shipping line + Add to cart button below the
      // Unlimited Bundles widget, so the bundle picker is the first thing
      // shown and this pair sits just above the guarantee card. Same
      // one-shot-with-retries approach as above (no persistent observer),
      // run later since the bundle widget injects itself after the app's
      // own delayed render.
      var guaranteeEl = root.querySelector(".velin-pdp__trust-strip, .velin-pdp__guarantee");
      var buyForm = submitBtn.closest("form");
      if (guaranteeEl && buyForm) {
        var placeBuyBoxAboveGuarantee = function () {
          var parent = guaranteeEl.parentNode;
          if (freeShippingEl && freeShippingEl.nextElementSibling !== guaranteeEl) {
            parent.insertBefore(freeShippingEl, guaranteeEl);
          }
          if (buyForm.nextElementSibling !== guaranteeEl) {
            parent.insertBefore(buyForm, guaranteeEl);
          }
          // Cancels out the bundle widget's own bottom spacing so this
          // block sits close under it instead of leaving a large gap.
          if (freeShippingEl) freeShippingEl.style.marginTop = "-40px";
        };
        setTimeout(placeBuyBoxAboveGuarantee, 800);
        setTimeout(placeBuyBoxAboveGuarantee, 1800);
      }
    }

    function setAvailability(available) {
      if (submitBtn) {
        submitBtn.disabled = !available;
        submitBtn.textContent = available
          ? submitBtn.getAttribute("data-atc-text")
          : submitBtn.getAttribute("data-sold-out-text");
      }
      if (!mainImageWrap) return;
      mainImageWrap.classList.toggle("is-sold-out", !available);
      var badge = mainImageWrap.querySelector(".velin-pdp__sold-out-badge");
      if (!available && !badge) {
        badge = document.createElement("span");
        badge.className = "velin-pdp__sold-out-badge";
        badge.textContent = submitBtn ? submitBtn.getAttribute("data-sold-out-text") : "";
        mainImageWrap.insertBefore(badge, mainImageWrap.firstChild);
      } else if (available && badge) {
        badge.remove();
      }
    }

    // Thumbnails
    // Stops/clears any playing video and shows the plain image again.
    function showMainImage(src) {
      if (mainVideo) {
        mainVideo.innerHTML = "";
        mainVideo.hidden = true;
      }
      if (mainImg) {
        mainImg.hidden = false;
        mainImg.src = src;
      }
    }

    // Clones the hidden <template> for this media id into the video slot.
    function showMainVideo(mediaId) {
      var template = root.querySelector('[data-pdp-video-template="' + mediaId + '"]');
      if (!mainVideo || !template) return;
      mainVideo.innerHTML = "";
      mainVideo.appendChild(template.content.cloneNode(true));
      mainVideo.hidden = false;
      if (mainImg) mainImg.hidden = true;
    }

    function bindThumb(thumb) {
      thumb.addEventListener("click", function () {
        root.querySelectorAll(".velin-pdp__thumb").forEach(function (t) { t.classList.remove("is-active"); });
        thumb.classList.add("is-active");
        var videoId = thumb.getAttribute("data-video-id");
        if (videoId) {
          showMainVideo(videoId);
        } else {
          showMainImage(thumb.getAttribute("data-full"));
        }
      });
    }
    root.querySelectorAll(".velin-pdp__thumb").forEach(bindThumb);

    // Video thumbnails, captured once before any color-based rebuild, so they
    // can be re-appended every time showColorMedia() replaces the strip with
    // an images-only list (product.images excludes video by design — see
    // showColorMedia below — but the video itself should stay reachable
    // regardless of which color is selected).
    var videoThumbSources = Array.prototype.slice.call(
      root.querySelectorAll(".velin-pdp__thumb[data-video-id]")
    );

    // Inserts the video thumb(s) at the 3rd position (index 2) of the strip,
    // falling back to the end if there aren't enough photos ahead of it yet.
    function appendVideoThumbs() {
      if (!thumbsRow) return;
      var referenceNode = thumbsRow.children[2] || null;
      videoThumbSources.forEach(function (source) {
        var clone = source.cloneNode(true);
        clone.classList.remove("is-active");
        bindThumb(clone);
        thumbsRow.insertBefore(clone, referenceNode);
      });
    }

    // Swap the whole thumbnail strip to only this color's photos (matched by image alt text).
    // product.images (and therefore this color grouping) never includes video/model media —
    // that's a Shopify-level distinction, not something this theme filters — so the video
    // thumbnails are re-appended afterwards to stay visible no matter which color is active.
    function showColorMedia(value) {
      var group = colorMedia[value];
      if (!thumbsRow || !group || !group.length) return;
      thumbsRow.innerHTML = "";
      group.forEach(function (item, idx) {
        var thumb = document.createElement("button");
        thumb.type = "button";
        thumb.className = "velin-pdp__thumb" + (idx === 0 ? " is-active" : "");
        thumb.setAttribute("data-full", item.full);
        thumb.setAttribute("aria-label", "Image " + (idx + 1));
        var img = document.createElement("img");
        img.src = item.thumb;
        img.loading = "lazy";
        thumb.appendChild(img);
        bindThumb(thumb);
        thumbsRow.appendChild(thumb);
      });
      appendVideoThumbs();
      showMainImage(group[0].full);
    }

    function formatMoney(cents) {
      return (cents / 100).toLocaleString("fr-FR", {
        style: "currency",
        currency: (window.Shopify && Shopify.currency ? Shopify.currency.active : "EUR")
      });
    }

    // Color selection (swatches + selects stay in sync)
    function selectColor(value) {
      root.querySelectorAll(".velin-pdp__swatch").forEach(function (s) {
        s.classList.toggle("is-active", s.getAttribute("data-color-value") === value);
        if (s.getAttribute("data-color-value") === value) {
          root.style.setProperty("--velin-selected-color", getComputedStyle(s).backgroundColor);
        }
      });
      root.querySelectorAll("[data-color-select]").forEach(function (sel) { sel.value = value; });

      if (colorIndex >= 0) {
        var optionKey = "option" + (colorIndex + 1);
        var sizeValueForColor = sizeIndex >= 0 ? getActiveSizeValue() : null;
        var sizeKeyForColor = sizeIndex >= 0 ? "option" + (sizeIndex + 1) : null;
        var variant = productData.variants.find(function (v) {
          if (v[optionKey] !== value) return false;
          if (sizeKeyForColor && sizeValueForColor && v[sizeKeyForColor] !== sizeValueForColor) return false;
          return true;
        });
        if (variant && variantInput) {
          variantInput.value = variant.id;
          setAvailability(variant.available);
          if (stickyAtcPrice) stickyAtcPrice.textContent = formatMoney(variant.price);
          if (priceEl) priceEl.textContent = formatMoney(variant.price);
          if (installmentEl) installmentEl.textContent = formatMoney(variant.price / installmentCount);
var compareEl = root.querySelector(".velin-pdp__compare");

if (compareEl) {
  if (variant.compare_at_price > variant.price) {
    compareEl.textContent = formatMoney(variant.compare_at_price);
    compareEl.style.display = "";
  } else {
    compareEl.style.display = "none";
  }
}
          // Offer boxes with automatic price follow the selected variant
          root.querySelectorAll("[data-offer-live-price]").forEach(function (el) {
            var qty = parseInt(el.getAttribute("data-offer-qty") || "1", 10);
            el.textContent = formatMoney(variant.price * qty);
          });

          // Prefer this color's full photo set (grouped by image alt text); fall back to the single variant image
          if (colorMedia[value] && colorMedia[value].length) {
            showColorMedia(value);
          } else if (mainImg && variant.featured_image && variant.featured_image.src) {
            showMainImage(variant.featured_image.src);
            root.querySelectorAll(".velin-pdp__thumb").forEach(function (t) { t.classList.remove("is-active"); });
          }
        }
      }
    }

    // On phone, the photo sits above the color swatches in the stacked layout,
    // so it's already out of view by the time someone scrolls down to tap a
    // color — the photo does change, but nobody sees it happen. Scroll it back
    // into view on selection so the color change is actually visible.
    function scrollToMainImageOnMobile() {
      if (mainImageWrap && window.matchMedia("(max-width: 749px)").matches) {
        mainImageWrap.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    root.querySelectorAll(".velin-pdp__swatch").forEach(function (swatch) {
      swatch.addEventListener("click", function () {
        selectColor(swatch.getAttribute("data-color-value"));
        scrollToMainImageOnMobile();
      });
    });

    root.querySelectorAll("[data-color-select]").forEach(function (sel) {
      sel.addEventListener("change", function () {
        selectColor(sel.value);
        scrollToMainImageOnMobile();
      });
    });

    // Collection mode: dropdown navigates to the chosen color's product page
    root.querySelectorAll("[data-color-nav]").forEach(function (sel) {
      sel.addEventListener("change", function () { window.location.href = sel.value; });
    });

    // On load, sync the dot, dropdown, and check mark to the selected color
    var initialSwatch = root.querySelector(".velin-pdp__swatch.is-active") || root.querySelector(".velin-pdp__swatch");
    if (initialSwatch) selectColor(initialSwatch.getAttribute("data-color-value"));

    function getActiveSizeValue() {
      var activePill = root.querySelector(".velin-pdp__size-pill.is-active");
      return activePill ? activePill.getAttribute("data-size-value") : null;
    }

    function getActiveColorValue() {
      var activeSwatch = root.querySelector(".velin-pdp__swatch.is-active");
      return activeSwatch ? activeSwatch.getAttribute("data-color-value") : null;
    }

    // Size selection (pills stay in sync). Mirrors selectColor's variant-matching
    // and price/availability side effects, combined with the active color when
    // the product also has a color option.
    function selectSize(value) {
      root.querySelectorAll(".velin-pdp__size-pill").forEach(function (p) {
        p.classList.toggle("is-active", p.getAttribute("data-size-value") === value);
      });
      root.querySelectorAll("[data-size-select]").forEach(function (sel) { sel.value = value; });

      if (sizeIndex < 0) return;
      var sizeKey = "option" + (sizeIndex + 1);
      var colorValue = colorIndex >= 0 ? getActiveColorValue() : null;
      var colorKey = colorIndex >= 0 ? "option" + (colorIndex + 1) : null;
      var variant = productData.variants.find(function (v) {
        if (v[sizeKey] !== value) return false;
        if (colorKey && colorValue && v[colorKey] !== colorValue) return false;
        return true;
      });
      if (!variant || !variantInput) return;

      variantInput.value = variant.id;
      setAvailability(variant.available);
      if (stickyAtcPrice) stickyAtcPrice.textContent = formatMoney(variant.price);
      if (priceEl) priceEl.textContent = formatMoney(variant.price);
      if (installmentEl) installmentEl.textContent = formatMoney(variant.price / installmentCount);

      var compareEl = root.querySelector(".velin-pdp__compare");
      if (compareEl) {
        if (variant.compare_at_price > variant.price) {
          compareEl.textContent = formatMoney(variant.compare_at_price);
          compareEl.style.display = "";
        } else {
          compareEl.style.display = "none";
        }
      }

      root.querySelectorAll("[data-offer-live-price]").forEach(function (el) {
        var qty = parseInt(el.getAttribute("data-offer-qty") || "1", 10);
        el.textContent = formatMoney(variant.price * qty);
      });

      if (mainImg && variant.featured_image && variant.featured_image.src) {
        showMainImage(variant.featured_image.src);
        root.querySelectorAll(".velin-pdp__thumb").forEach(function (t) { t.classList.remove("is-active"); });
      }
    }

    root.querySelectorAll(".velin-pdp__size-pill").forEach(function (pill) {
      pill.addEventListener("click", function () {
        selectSize(pill.getAttribute("data-size-value"));
      });
    });

    root.querySelectorAll("[data-size-select]").forEach(function (sel) {
      sel.addEventListener("change", function () { selectSize(sel.value); });
    });

    var initialSizePill = root.querySelector(".velin-pdp__size-pill.is-active") || root.querySelector(".velin-pdp__size-pill");
    if (initialSizePill) selectSize(initialSizePill.getAttribute("data-size-value"));

    // Offers → quantity
    root.querySelectorAll("[data-offer]").forEach(function (offer) {
      offer.addEventListener("click", function () {
        root.querySelectorAll("[data-offer]").forEach(function (o) { o.classList.remove("is-selected"); });
        offer.classList.add("is-selected");
        if (qtyInput) qtyInput.value = offer.getAttribute("data-qty") || "1";
      });
    });
    var initial = root.querySelector("[data-offer].is-selected");
    if (initial && qtyInput) qtyInput.value = initial.getAttribute("data-qty") || "1";

    // Countdown
    var cd = root.querySelector("[data-countdown]");
    if (cd) {
      var remaining = parseFloat(cd.getAttribute("data-hours") || "18") * 3600;
      setInterval(function () {
        remaining = Math.max(0, remaining - 1);
        var h = Math.floor(remaining / 3600);
        var m = Math.floor((remaining % 3600) / 60);
        var s = Math.floor(remaining % 60);
        cd.textContent = String(h).padStart(2, "0") + ":" + String(m).padStart(2, "0") + ":" + String(s).padStart(2, "0");
      }, 1000);
    }
    // FAQ accordion
    var defaultOpenFaq = root.querySelector("[data-faq-default-open]");
    if (defaultOpenFaq) {
      var defaultOpenAnswer = defaultOpenFaq.querySelector("[data-faq-answer]");
      defaultOpenFaq.classList.add("is-open");
      if (defaultOpenAnswer) {
        defaultOpenAnswer.style.maxHeight = defaultOpenAnswer.scrollHeight + "px";
        // Images/fonts inside the answer can still be loading when the line above
        // runs, locking max-height in at an under-measured value. Re-measure once
        // everything has finished loading.
        window.addEventListener("load", function () {
          if (defaultOpenFaq.classList.contains("is-open")) {
            defaultOpenAnswer.style.maxHeight = defaultOpenAnswer.scrollHeight + "px";
          }
        });
      }
    }

    root.querySelectorAll("[data-faq-toggle]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var item = btn.closest(".velin-faq__item");
        var answer = item.querySelector("[data-faq-answer]");
        var isOpen = item.classList.contains("is-open");

        root.querySelectorAll(".velin-faq__item").forEach(function (i) {
          i.classList.remove("is-open");
          i.querySelector("[data-faq-answer]").style.maxHeight = null;
        });

        if (!isOpen) {
          item.classList.add("is-open");
          answer.style.maxHeight = answer.scrollHeight + "px";
        }
      });
    });
    // Approved videos - prev/next arrows
    root.querySelectorAll(".velin-pdp__approved-wrap").forEach(function (wrap) {
      var grid = wrap.querySelector(".velin-pdp__approved-grid");
      var prevBtn = wrap.querySelector("[data-approved-prev]");
      var nextBtn = wrap.querySelector("[data-approved-next]");
      if (!grid) return;
      var firstItem = grid.querySelector(".velin-pdp__approved-item");
      var scrollAmount = firstItem ? firstItem.offsetWidth + {{ section.settings.video_gap }} : 200;

      if (prevBtn) {
        prevBtn.addEventListener("click", function () {
          grid.scrollBy({ left: -scrollAmount, behavior: "smooth" });
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener("click", function () {
          grid.scrollBy({ left: scrollAmount, behavior: "smooth" });
        });
      }
    });
    // Approved videos — lazy load. Each card's real <video> (multi-MB source)
    // sits inert inside a <template> — the browser never fetches it — until
    // the card scrolls within ~400px of the viewport. Swaps in for the poster
    // at that point; nothing changes visually until then.
    function wireVideoCardClick(card) {
      var video = card.querySelector("video");
      var btn = card.querySelector(".velin-video-play");
      if (!video || !btn) return;
      card.addEventListener("click", function () {
        if (video.paused) {
          video.play();
          btn.classList.add("is-playing");
        } else {
          video.pause();
          btn.classList.remove("is-playing");
        }
      });
    }

    function loadLazyVideoCard(card) {
      var template = card.querySelector("[data-lazy-video-template]");
      var poster = card.querySelector(".velin-video-poster");
      if (!template) return;
      var videoNode = template.content.cloneNode(true);
      if (poster) {
        poster.replaceWith(videoNode);
      } else {
        card.insertBefore(videoNode, template);
      }
      template.remove();
      wireVideoCardClick(card);
    }

    var lazyVideoCards = root.querySelectorAll("[data-lazy-video-card]");
    if (lazyVideoCards.length) {
      if ("IntersectionObserver" in window) {
        var lazyVideoObserver = new IntersectionObserver(function (entries, observer) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              loadLazyVideoCard(entry.target);
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: "400px 0px", threshold: 0.01 });
        lazyVideoCards.forEach(function (card) {
          lazyVideoObserver.observe(card);
        });
      } else {
        // No IntersectionObserver support — load everything immediately rather than never.
        lazyVideoCards.forEach(loadLazyVideoCard);
      }
    }

    // Sticky add-to-cart bar — shown once the main add-to-cart button scrolls above the viewport.
    // Uses a plain scroll listener (rather than IntersectionObserver) so it reacts immediately
    // on both mobile and desktop regardless of layout/column height differences.
    if (stickyAtc && submitBtn) {
      var stickyAtcTicking = false;
      function updateStickyAtcVisibility() {
        stickyAtcTicking = false;
        var scrolledPast = submitBtn.getBoundingClientRect().bottom < 0;
        stickyAtc.classList.toggle("is-visible", scrolledPast);
      }
      window.addEventListener("scroll", function () {
        if (stickyAtcTicking) return;
        stickyAtcTicking = true;
        window.requestAnimationFrame(updateStickyAtcVisibility);
      }, { passive: true });
      window.addEventListener("resize", updateStickyAtcVisibility);
      updateStickyAtcVisibility();
    }

    var stickyAtcBtn = stickyAtc ? stickyAtc.querySelector("[data-sticky-atc-btn]") : null;
    if (stickyAtcBtn) {
      stickyAtcBtn.addEventListener("click", function () {
        var form = document.getElementById("VelinPDPForm");
        if (!form) return;
        if (form.requestSubmit) {
          form.requestSubmit();
        } else {
          form.dispatchEvent(new Event("submit", { cancelable: true }));
        }
      });
    }

    // Add to cart via AJAX so it opens the sliding cart instead of navigating to /cart.
    var atcForm = document.getElementById("VelinPDPForm");
    if (atcForm) {
      atcForm.addEventListener("submit", function (e) {
        e.preventDefault();
        var submitBtn = atcForm.querySelector('[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;

        fetch("/cart/add.js", {
          method: "POST",
          body: new FormData(atcForm),
          headers: { Accept: "application/json" },
        })
          .then(function (res) {
            if (!res.ok) throw new Error("Add to cart failed");
            return fetch("/cart.js");
          })
          .then(function (res) { return res.json(); })
          .then(function (cart) {
            if (window.VelinCartDrawer) {
              return window.VelinCartDrawer.refresh(cart).then(function () {
                window.VelinCartDrawer.open();
              });
            }
            document.querySelectorAll("[data-cart-count]").forEach(function (el) {
              el.textContent = cart.item_count;
              el.classList.toggle("is-empty", cart.item_count === 0);
            });
          })
          .catch(function () {
            atcForm.submit();
          })
          .finally(function () {
            if (submitBtn) submitBtn.disabled = false;
          });
      });
    }
  })();
</script>

{%- comment -%}
  Lazy-load the AirReviews review-carousel images (class "AirReviews-Carousel__Image").
  That carousel is injected client-side by the AirReviews app itself — its markup
  isn't part of this theme, so it can't be edited directly and none of its own
  code is touched here. This only watches for its <img> tags appearing anywhere
  on the page and defers each one's real download until it's about to scroll
  into view, the same way the approved-videos carousel above already defers its
  <video> sources. Purely additive: doesn't touch AirReviews or any other image.
{%- endcomment -%}
<script>
  (function () {
    var LAZY_CLASS = "AirReviews-Carousel__Image";
    var ROOT_MARGIN = "500px 0px";
    var FALLBACK_DELAY_MS = 8000;

    if (!("IntersectionObserver" in window)) return; // let these images load normally

    var pending = [];

    var observer = new IntersectionObserver(function (entries, obs) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          restoreImage(entry.target);
          obs.unobserve(entry.target);
        }
      });
    }, { rootMargin: ROOT_MARGIN, threshold: 0.01 });

    function restoreImage(img) {
      if (img.dataset.lazySrcset) {
        img.setAttribute("srcset", img.dataset.lazySrcset);
        delete img.dataset.lazySrcset;
      }
      if (img.dataset.lazySrc) {
        img.setAttribute("src", img.dataset.lazySrc);
        delete img.dataset.lazySrc;
      }
    }

    function deferImage(img) {
      if (img.dataset.lazyHandled) return;
      var realSrc = img.getAttribute("src");
      if (!realSrc || realSrc.indexOf("data:") === 0) return;
      img.dataset.lazyHandled = "1";
      img.dataset.lazySrc = realSrc;
      img.removeAttribute("src");
      var realSrcset = img.getAttribute("srcset");
      if (realSrcset) {
        img.dataset.lazySrcset = realSrcset;
        img.removeAttribute("srcset");
      }
      if ("loading" in HTMLImageElement.prototype) img.loading = "lazy";
      pending.push(img);
      observer.observe(img);
    }

    function scan(node) {
      if (node.nodeType !== 1) return;
      if (node.classList && node.classList.contains(LAZY_CLASS)) deferImage(node);
      if (node.querySelectorAll) {
        node.querySelectorAll("." + LAZY_CLASS).forEach(deferImage);
      }
    }

    document.querySelectorAll("." + LAZY_CLASS).forEach(deferImage);

    var mo = new MutationObserver(function (mutations) {
      mutations.forEach(function (m) {
        m.addedNodes.forEach(scan);
      });
    });
    mo.observe(document.documentElement, { childList: true, subtree: true });

    // Safety net: if anything about the carousel prevents the observer from
    // ever reporting an image as visible (e.g. it's revealed via a mechanism
    // IntersectionObserver can't see), force-load whatever is still pending
    // rather than leave a review photo permanently blank.
    setTimeout(function () {
      pending.forEach(function (img) {
        if (img.dataset.lazySrc) {
          observer.unobserve(img);
          restoreImage(img);
        }
      });
    }, FALLBACK_DELAY_MS);
  })();
</script>

{% schema %}
{
  "name": "Velin Product Page",
  "settings": [
    {
      "type": "select",
      "id": "header_style",
      "label": "Header color (logo, text, icons) on this page",
      "options": [
        { "value": "auto", "label": "Automatic" },
        { "value": "black", "label": "Black" },
        { "value": "white", "label": "White" }
      ],
      "default": "auto"
    },
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_v", "label": "Padding top/bottom (px)", "min": 0, "max": 150, "step": 5, "default": 80 },
    { "type": "range", "id": "padding_h", "label": "Padding left/right (px)", "min": 0, "max": 150, "step": 5, "default": 100 },
    { "type": "range", "id": "column_gap", "label": "Gap image/text (px)", "min": 20, "max": 200, "step": 2, "default": 122 },
    { "type": "header", "content": "Images (left)" },
    { "type": "range", "id": "media_width", "label": "Image column width (px)", "min": 300, "max": 800, "step": 5, "default": 610 },
    { "type": "range", "id": "image_height", "label": "Main image height (px)", "min": 200, "max": 800, "step": 10, "default": 480 },
    { "type": "color", "id": "image_bg", "label": "Image background", "default": "#F7F8F6" },
    { "type": "range", "id": "media_gap", "label": "Gap image to thumbnails (px)", "min": 0, "max": 80, "step": 2, "default": 40 },
    { "type": "range", "id": "thumbs_height", "label": "Thumbnails height (px)", "min": 60, "max": 200, "step": 5, "default": 105 },
    { "type": "range", "id": "thumbs_gap", "label": "Gap between thumbnails (px)", "min": 0, "max": 60, "step": 1, "default": 21 },
    { "type": "checkbox", "id": "show_media_grid", "label": "Show extra photos in a grid below (desktop)", "default": false },
    { "type": "header", "content": "Text column (right)" },
    { "type": "range", "id": "info_width", "label": "Text column width (px)", "min": 300, "max": 800, "step": 5, "default": 610 },
    { "type": "range", "id": "info_gap", "label": "Gap between elements (px)", "min": 0, "max": 80, "step": 2, "default": 6 },
    { "type": "header", "content": "Top badge" },
