{% render 'header-color-override', style: section.settings.header_style %}

{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}

<section class="velin-collection-page container">

  <div class="velin-collection-page__toolbar">
    <button type="button" class="velin-collection-page__filter-btn" data-collection-filter-toggle>
      {% render 'icon-filter' %}
      {{ 'collections.filtering.filter_button' | t: default: 'Filter' }}
    </button>

    <h1 class="velin-collection-page__title">{{ collection.title }}</h1>

    <div class="velin-collection-page__sort">
      <label for="VelinSortBy-{{ section.id }}" class="visually-hidden">{{ 'collections.sorting.title' | t: default: 'Sort' }}</label>
      <select id="VelinSortBy-{{ section.id }}" name="sort_by" data-collection-sort>
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </div>
  </div>

  {%- if collection.description != blank -%}
    <div class="velin-collection-page__description rte">{{ collection.description }}</div>
  {%- endif -%}

  <div class="velin-collection-page__body">

    <aside class="velin-collection-page__filters" data-collection-filter-panel hidden>
      <form id="VelinFilterForm-{{ section.id }}">
        <input type="hidden" name="sort_by" value="{{ sort_by }}">
        {%- for filter in collection.filters -%}
          <div class="velin-collection-page__filter-group">
            <h3>{{ filter.label }}</h3>
            {%- case filter.type -%}
              {%- when 'price_range' -%}
                <div class="velin-collection-page__price-range">
                  <input
                    type="number"
                    name="{{ filter.min_value.param_name }}"
                    value="{{ filter.min_value.value }}"
                    placeholder="{{ filter.min_value.value | default: 0 }}"
                  >
                  <span>–</span>
                  <input
                    type="number"
                    name="{{ filter.max_value.param_name }}"
                    value="{{ filter.max_value.value }}"
                    placeholder="{{ filter.range_max }}"
                  >
                </div>
              {%- else -%}
                {%- for value in filter.values -%}
                  <label class="velin-collection-page__filter-option">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      {% if value.count == 0 and value.active == false %}disabled{% endif %}
                    >
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
        <button type="submit" class="velin-collection-page__apply-btn">{{ 'collections.filtering.apply' | t: default: 'Apply' }}</button>
        {%- if collection.filters != blank -%}
          <a href="{{ collection.url }}" class="velin-collection-page__clear-btn">{{ 'collections.filtering.clear_all' | t: default: 'Clear all' }}</a>
        {%- endif -%}
      </form>
    </aside>

    {%- paginate collection.products by 12 -%}
      <div class="velin-collection-page__grid">
        {%- for product in collection.products -%}
          {%- liquid
            assign card_variant = product.selected_or_first_available_variant
            assign discount_percent = 0
            if card_variant.compare_at_price > card_variant.price
              assign discount_percent = card_variant.compare_at_price | minus: card_variant.price | times: 100.0 | divided_by: card_variant.compare_at_price | round
            endif
          -%}
          <a href="{{ product.url }}" class="velin-sale-card">
            <div class="velin-sale-card__media">
              {%- if product.featured_media -%}
                <img class="velin-sale-card__image--primary" src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.featured_media.alt | escape }}" loading="lazy">
                {%- if product.images[1] -%}
                  <img class="velin-sale-card__image--secondary" src="{{ product.images[1] | image_url: width: 600 }}" alt="{{ product.images[1].alt | escape }}" loading="lazy">
                {%- endif -%}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'velin-sale-card__placeholder' }}
              {%- endif -%}
              {%- if discount_percent > 0 -%}
                <span class="velin-sale-card__badge">{{ discount_percent }}% OFF</span>
              {%- endif -%}
            </div>

            <div class="velin-sale-card__info">
              <div class="velin-sale-card__head">
                <p class="velin-sale-card__title">{{ product.title }}</p>
              </div>

              {%- if product.description != blank -%}
                <p class="velin-sale-card__desc">{{ product.description | strip_html | truncatewords: 8 }}</p>
              {%- endif -%}

              <p class="velin-sale-card__price">
                {%- if discount_percent > 0 -%}
                  <s>{{ card_variant.compare_at_price | money }}</s>
                {%- endif -%}
                {{ card_variant.price | money }}
              </p>
            </div>
          </a>
        {%- else -%}
          <p class="velin-collection-page__empty">{{ 'collections.general.no_matches' | t }}</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination">
          {{ paginate | default_pagination }}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}

  </div>
</section>

<style>
  .velin-collection-page .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .velin-collection-page {
    padding: 40px 0 60px;
  }

  .velin-collection-page__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 30px;
  }

  .velin-collection-page__filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    background: #fff;
    font-size: 14px;
    cursor: pointer;
    white-space: nowrap;
  }

  .velin-collection-page__filter-btn svg {
    width: 16px;
    height: 16px;
  }

  .velin-collection-page__title {
    flex: 1 1 auto;
    text-align: center;
    margin: 0;
    font-size: 34px;
    font-family: var(--font-heading-family), serif;
  }

  .velin-collection-page__sort select {
    padding: 10px 14px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    background: #fff;
    font-size: 14px;
  }

  .velin-collection-page__description {
    max-width: 720px;
    margin: 0 auto 30px;
    text-align: center;
    opacity: 0.8;
  }

  .velin-collection-page__body {
    display: flex;
    align-items: flex-start;
    gap: 30px;
  }

  .velin-collection-page__filters {
    flex: 0 0 240px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    padding: 20px;
  }

  .velin-collection-page__filters[hidden] {
    display: none;
  }

  .velin-collection-page__filter-group {
    margin-bottom: 20px;
  }

  .velin-collection-page__filter-group h3 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 10px;
  }

  .velin-collection-page__filter-option {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    margin-bottom: 8px;
    cursor: pointer;
  }

  .velin-collection-page__price-range {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .velin-collection-page__price-range input {
    width: 100%;
    padding: 8px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 4px;
  }

  .velin-collection-page__apply-btn {
    width: 100%;
    padding: 10px;
    border: none;
    border-radius: 6px;
    background: var(--color-brown, #634e40);
    color: #fff;
    cursor: pointer;
    margin-top: 8px;
  }

  .velin-collection-page__clear-btn {
    display: block;
    text-align: center;
    margin-top: 10px;
    font-size: 13px;
    text-decoration: underline;
  }

  .velin-collection-page__grid {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .velin-sale-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .velin-sale-card__media {
    position: relative;
    aspect-ratio: 15 / 14;
    border-radius: 8px;
    overflow: hidden;
    background: #f1f1f0;
  }

  .velin-sale-card__media img,
  .velin-sale-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .velin-sale-card__image--secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  @media (hover: hover) {
    .velin-sale-card:hover .velin-sale-card__image--secondary {
      opacity: 1;
    }
  }

  .velin-sale-card__badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.85);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 4px 8px;
    border-radius: 4px;
  }

  .velin-sale-card__info {
    padding-top: 12px;
  }

  .velin-sale-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .velin-sale-card__title {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }

  .velin-sale-card__rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    flex-shrink: 0;
  }

  .velin-sale-card__rating svg {
    width: 13px;
    height: 13px;
  }

  .velin-sale-card__desc {
    margin: 4px 0 0;
    font-size: 12px;
    opacity: 0.65;
    line-height: 1.5;
  }

  .velin-sale-card__price {
    margin: 8px 0 0;
    font-size: 15px;
    font-weight: 600;
  }

  .velin-sale-card__price s {
    margin-right: 6px;
    color: #999;
    font-weight: 400;
  }

  @media (max-width: 1024px) {
    .velin-collection-page__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 860px) {
    .velin-collection-page__body {
      flex-direction: column;
    }
    .velin-collection-page__filters {
      flex: 1 1 auto;
      width: 100%;
      box-sizing: border-box;
    }
    .velin-collection-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .velin-collection-page__toolbar {
      flex-wrap: wrap;
    }
    .velin-collection-page__title {
      order: -1;
      flex: 1 1 100%;
      font-size: 26px;
    }
    .velin-collection-page__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function () {
    var section = document.querySelector('.velin-collection-page');
    if (!section) return;

    var filterBtn = section.querySelector('[data-collection-filter-toggle]');
    var filterPanel = section.querySelector('[data-collection-filter-panel]');
    if (filterBtn && filterPanel) {
      filterBtn.addEventListener('click', function () {
        filterPanel.hidden = !filterPanel.hidden;
      });
    }

    var sortSelect = section.querySelector('[data-collection-sort]');
    if (sortSelect) {
      sortSelect.addEventListener('change', function () {
        var url = new URL(window.location.href);
        url.searchParams.set('sort_by', sortSelect.value);
        window.location.href = url.toString();
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "select",
      "id": "header_style",
      "label": "Header color (logo, text, icons) on this page",
      "options": [
        { "value": "auto", "label": "Automatic" },
        { "value": "black", "label": "Black" },
        { "value": "white", "label": "White" }
      ],
      "default": "auto"
    }
  ]
}
{% endschema %}