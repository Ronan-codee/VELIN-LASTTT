{% comment %}
  Velin - Collection Filter Tabs + Product Grid
  Place this section on your Collection page template.
  - "Filter tabs" are just links to different collections (Tote Bags, Shoulder Bags, etc).
  - Clicking a product card takes the customer to that product's page automatically.
  - The tab matching the CURRENT collection gets highlighted automatically.
{% endcomment %}

<div class="velin-collection-wrap">

  <!-- FILTER TABS LINE -->
  <div class="velin-filter-tabs">
    {% for block in section.blocks %}
      {% if block.type == 'filter_tab' %}
        {% assign tab_collection = block.settings.tab_collection %}
        {% if tab_collection != blank and tab_collection.products_count > 0 %}
          <a
            href="{{ tab_collection.url }}"
            class="velin-filter-tab {% if collection.handle == tab_collection.handle %}is-active{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.tab_label }}
          </a>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>

  <!-- PRODUCT GRID -->
  <div class="velin-products-grid">
    {% for product in collection.products limit: section.settings.products_limit %}
      {%- liquid
        assign grid_variant = product.selected_or_first_available_variant
        assign grid_discount = 0
        if grid_variant.compare_at_price > grid_variant.price
          assign grid_discount = grid_variant.compare_at_price | minus: grid_variant.price | times: 100.0 | divided_by: grid_variant.compare_at_price | round
        endif
      -%}
      <a href="{{ product.url }}" class="velin-product-card">

        <div class="velin-product-image">
          {% if grid_discount > 0 %}
            <span class="velin-product-image__badge">-{{ grid_discount }}%</span>
          {% endif %}
          {% if product.featured_image %}
            <div class="velin-product-image__scroller" data-velin-image-scroller>
              <img
                class="velin-product-image__slide"
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.featured_image.alt | escape }}"
                width="295"
                height="275"
                loading="lazy"
              >
              {% if product.images[1] %}
                <img
                  class="velin-product-image__slide"
                  src="{{ product.images[1] | image_url: width: 600 }}"
                  alt="{{ product.images[1].alt | escape }}"
                  width="295"
                  height="275"
                  loading="lazy"
                >
              {% endif %}
            </div>
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'velin-placeholder-img' }}
          {% endif %}
        </div>

        <div class="velin-product-info {% if section.settings.title_bold %}is-bold-title{% endif %}">
          <div class="velin-title-row">
            <span class="velin-product-title" style="font-size: {{ section.settings.title_font_size }}px;">{{ product.title }}</span>
          </div>

          <p class="velin-product-price" style="font-size: {{ section.settings.price_font_size }}px;">
            {%- if grid_discount > 0 -%}
              <s class="velin-product-price__compare">{{ grid_variant.compare_at_price | money }}</s>
            {%- endif -%}
            {{ grid_variant.price | money }}
          </p>
        </div>

      </a>
    {% else %}
      <p class="velin-empty">No products found in this collection.</p>
    {% endfor %}
  </div>

</div>

{% schema %}
{
  "name": "Velin Collection Grid",
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Number of products to show",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 20
    },
    {
      "type": "header",
      "content": "Text under image"
    },
    {
      "type": "checkbox",
      "id": "title_bold",
      "label": "Make product title bold",
      "default": false
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Product title size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "price_font_size",
      "label": "Price size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "filter_tab",
      "name": "Filter Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "default": "ALL"
        },
        {
          "type": "collection",
          "id": "tab_collection",
          "label": "Collection this tab links to"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Velin Collection Grid",
      "blocks": [
        { "type": "filter_tab", "settings": { "tab_label": "ALL" } },
        { "type": "filter_tab", "settings": { "tab_label": "TOTE BAGS" } },
        { "type": "filter_tab", "settings": { "tab_label": "SHOULDER BAGS" } },
        { "type": "filter_tab", "settings": { "tab_label": "CROSSBODY" } },
        { "type": "filter_tab", "settings": { "tab_label": "TOP HANDLE" } },
        { "type": "filter_tab", "settings": { "tab_label": "MINI BAGS" } }
      ]
    }
  ]
}
{% endschema %}

<style>
  /* Outer container — from your Figma: 1440 x 1562, padding 100, gap 40 */
  .velin-collection-wrap {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 100px;
    display: flex;
    flex-direction: column;
    gap: 40px;
    box-sizing: border-box;
  }

  /* Filter tabs line — 942 x 30, gap 60 */
  .velin-filter-tabs {
    display: flex;
    align-items: center;
    gap: 60px;
    width: 100%;
    max-width: 942px;
    height: 30px;
  }

  .velin-filter-tab {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    text-decoration: none;
    color: #666;
    white-space: nowrap;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .velin-filter-tab:hover {
    color: #1c1c1c;
  }

  .velin-filter-tab.is-active {
    color: #1c1c1c;
    border-bottom: 1px solid #1c1c1c;
  }

  .velin-product-info.is-bold-title .velin-product-title {
    font-weight: 700;
  }

  /* Products container — 1240 x 1292, gap 40 */
  .velin-products-grid {
    width: 100%;
    max-width: 1240px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 295px));
    gap: 20px;
  }

  /* Individual card — matches the "Nos produits" card (image to text gap) */
  .velin-product-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 295px;
    text-decoration: none;
    color: inherit;
  }

  /* Image — same 15:14 ratio as the homepage "ALL COLLECTION" cards, radius 8 */
  .velin-product-image {
    width: 100%;
    aspect-ratio: 15 / 14;
    border-radius: 8px;
    overflow: hidden;
    background: #f3f3f3;
    position: relative;
  }

  .velin-placeholder-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 8px;
  }

  /* Image scroller — swipeable on touch, glides to the 2nd photo on desktop hover */
  .velin-product-image__scroller {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .velin-product-image__scroller::-webkit-scrollbar {
    display: none;
  }

  .velin-product-image__slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    scroll-snap-align: start;
    display: block;
  }

  .velin-product-image__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
    background: #b3001b;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 4px 8px;
    border-radius: 4px;
  }

  .velin-product-price__compare {
    color: #999;
    margin-right: 6px;
    font-weight: 400;
    text-decoration: line-through;
  }

  /* Text block under image */
  .velin-product-info {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .velin-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .velin-product-title {
    font-size: 15px;
    font-weight: 400;
    color: #1c1c1c;
    line-height: 1.3;
  }

  .velin-rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: #1c1c1c;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .velin-rating .icon-star {
    width: 12px;
    height: 12px;
  }

  .velin-product-price {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #000;
    margin: 0;
  }

  .velin-empty {
    grid-column: 1 / -1;
    text-align: center;
    color: #888;
    padding: 60px 0;
  }

  /* Responsive fallback for smaller screens */
  @media (max-width: 989px) {
    .velin-collection-wrap {
      padding: 40px 20px;
    }
    .velin-products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .velin-products-grid {
      grid-template-columns: 1fr;
    }
    .velin-filter-tabs {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }
</style>

<script>
  (function () {
    var scrollers = document.querySelectorAll('.velin-collection-wrap [data-velin-image-scroller]');
    var canHover = window.matchMedia('(hover: hover)').matches;
    if (!canHover) return;

    scrollers.forEach(function (scroller) {
      if (scroller.children.length < 2) return;
      var card = scroller.closest('.velin-product-card');
      if (!card) return;

      card.addEventListener('mouseenter', function () {
        scroller.scrollTo({ left: scroller.clientWidth, behavior: 'smooth' });
      });
      card.addEventListener('mouseleave', function () {
        scroller.scrollTo({ left: 0, behavior: 'smooth' });
      });
    });
  })();
</script>
