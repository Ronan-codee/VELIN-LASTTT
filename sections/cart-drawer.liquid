{% comment %} Velin - Sliding cart drawer, opened from the header cart icon (or after a quick add). Re-fetched via the Section Rendering API (?section_id=cart-drawer) after any cart change, so it always reflects the live cart. {% endcomment %}

<div class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-drawer-close></div>
  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Panier">
    <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="Fermer le panier">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>

    <div class="cart-drawer__brand">
      <span class="cart-drawer__brand-badge">+3000 Clients Satisfaits</span>
      <p class="cart-drawer__brand-trust">Livraison Gratuite&nbsp;&nbsp;·&nbsp;&nbsp;Retours Sous 30 Jours</p>
    </div>

    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">Votre panier {% if cart.item_count > 0 %}({{ cart.item_count }}){% endif %}</h2>
    </div>

    <div class="cart-drawer__body">
      {% if cart.item_count == 0 %}
        <div class="cart-drawer__empty">
          <p>Votre panier est vide.</p>
          <a href="/collections/nos-produits" class="cart-drawer__empty-btn" data-cart-drawer-close>Continuer vos achats</a>
        </div>
      {% else %}
        {%- liquid
          assign paid_html = ''
          assign gift_html = ''
        -%}
        {% for item in cart.items %}
          {%- assign cd_is_gift = false -%}
          {%- if item.final_price == 0 -%}{%- assign cd_is_gift = true -%}{%- endif -%}
          {%- capture cd_item_html -%}
            <li class="cart-drawer__item" data-cart-drawer-line="{{ forloop.index }}">
              <a href="{{ item.url }}" class="cart-drawer__item-image" data-cart-drawer-close>
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" loading="lazy">
              </a>
              <div class="cart-drawer__item-info">
                <div class="cart-drawer__item-head">
                  <a href="{{ item.url }}" class="cart-drawer__item-title" data-cart-drawer-close>{{ item.product.title }}</a>
                  <button type="button" class="cart-drawer__item-remove" data-cart-drawer-remove aria-label="Supprimer {{ item.product.title | escape }}">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                      <path d="M3 6h18" stroke="#999" stroke-width="2" stroke-linecap="round"/>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
                {% if item.variant.title != 'Default Title' %}
                  <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
                {% endif %}
                {% unless cd_is_gift %}
                  {% if item.product.handle == 'velin-housse-de-couette-2-en-1' %}
                    <p class="cart-drawer__item-included">🎁 {{ item.quantity | times: 2 }} taies d'oreiller offertes incluses</p>
                  {% endif %}
                {% endunless %}
                <div class="cart-drawer__item-foot">
                  {% if cd_is_gift %}
                    <span class="cart-drawer__gift-label">Cadeau offert · Qté {{ item.quantity }}</span>
                    <span class="cart-drawer__item-price">Offert</span>
                  {% else %}
                    <div class="cart-drawer__qty">
                      <button type="button" class="cart-drawer__qty-btn" data-cart-drawer-decrease aria-label="Diminuer la quantité">−</button>
                      <span class="cart-drawer__qty-value" data-cart-drawer-qty-value>{{ item.quantity }}</span>
                      <button type="button" class="cart-drawer__qty-btn" data-cart-drawer-increase aria-label="Augmenter la quantité">+</button>
                    </div>
                    <span class="cart-drawer__item-price" data-cart-drawer-line-price="{{ item.final_price }}">{{ item.final_price | money }}</span>
                  {% endif %}
                </div>
              </div>
            </li>
          {%- endcapture -%}
          {%- if cd_is_gift -%}
            {%- assign gift_html = gift_html | append: cd_item_html -%}
          {%- else -%}
            {%- assign paid_html = paid_html | append: cd_item_html -%}
          {%- endif -%}
        {% endfor %}

        {% if paid_html != blank %}
          <p class="cart-drawer__group-label">Produits</p>
          <ul class="cart-drawer__items">{{ paid_html }}</ul>
        {% endif %}
        {% if gift_html != blank %}
          <p class="cart-drawer__group-label cart-drawer__group-label--gift">Cadeau offert</p>
          <ul class="cart-drawer__items cart-drawer__items--gifts">{{ gift_html }}</ul>
        {% endif %}

        {%- assign cd_wallet = all_products['le-croco-portefeuille-cuir-verni'] -%}
        {%- assign cd_wallet_in_cart = false -%}
        {%- for item in cart.items -%}
          {%- if item.product_id == cd_wallet.id -%}{%- assign cd_wallet_in_cart = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if cd_wallet != blank and cd_wallet_in_cart == false -%}
          <div class="cart-drawer__upsell-line" data-cart-drawer-upsell-line data-variant-id="{{ cd_wallet.variants.first.id }}">
            <img src="{{ cd_wallet.featured_image | image_url: width: 96 }}" alt="{{ cd_wallet.title | escape }}" class="cart-drawer__upsell-line-thumb" loading="lazy">
            <span class="cart-drawer__upsell-line-text">Portefeuille cuir — <strong>29,00&nbsp;€</strong> au lieu de {{ cd_wallet.price | money }}</span>
            <button type="button" class="cart-drawer__upsell-line-add" data-cart-drawer-upsell-line-add aria-label="Ajouter le portefeuille au panier">+</button>
          </div>
        {%- endif -%}
      {% endif %}
    </div>

    {% if cart.item_count > 0 %}
      <div class="cart-drawer__footer">
        <div class="cart-drawer__trust">
          <p class="cart-drawer__trust-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M7 10V7a5 5 0 0 1 10 0v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="15" r="1.3" fill="currentColor"/></svg>
            Paiement 100&nbsp;% sécurisé
          </p>
          <p class="cart-drawer__trust-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 13v-1a8 8 0 0 1 16 0v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="2.5" y="13" width="5" height="7" rx="2" stroke="currentColor" stroke-width="1.5"/><rect x="16.5" y="13" width="5" height="7" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M19 20v.5a3 3 0 0 1-3 3h-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            Support disponible 24/7
          </p>
        </div>
        {% if cart.total_discount > 0 %}
          <div class="cart-drawer__summary-row">
            <span>Remise</span>
            <span class="cart-drawer__discount-amount">−{{ cart.total_discount | money }}</span>
          </div>
        {% endif %}
        <div class="cart-drawer__summary-row">
          <span>Expédition</span>
          <span class="cart-drawer__shipping-free">Gratuite</span>
        </div>
        <div class="cart-drawer__subtotal-row">
          <span>Sous-total</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-drawer__taxes-note">Taxes incluses.</p>
        <form action="/cart" method="post">
          <button type="submit" name="checkout" class="cart-drawer__checkout-btn">Acheter maintenant</button>
        </form>
      </div>
    {% endif %}
  </aside>
</div>

<style>
  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 1000;
    visibility: hidden;
    pointer-events: none;
    font-family: 'Merriweather', serif;
    color: #000;
  }

  .cart-drawer.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .cart-drawer__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .cart-drawer.is-open .cart-drawer__overlay {
    opacity: 1;
  }

  .cart-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: 420px;
    max-width: 92vw;
    background: #fff;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.12);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }

  .cart-drawer.is-open .cart-drawer__panel {
    transform: translateX(0);
  }

  .cart-drawer__close {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 1;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: #000;
  }

  .cart-drawer__brand {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 32px 24px 20px;
    text-align: center;
  }

  .cart-drawer__brand-badge {
    display: inline-block;
    padding: 8px 20px;
    border-radius: 999px;
    background: #FFE791;
    color: #201e50;
    font-family: 'Merriweather', serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .cart-drawer__brand-trust {
    margin: 2px 0 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #201e50;
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 24px 16px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .cart-drawer__title {
    margin: 0;
    font-family: 'Lusitana', serif;
    font-weight: 400;
    font-size: 20px;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .cart-drawer__body {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 16px 24px;
  }

  .cart-drawer__empty {
    text-align: center;
    padding: 60px 0;
  }

  .cart-drawer__empty-btn {
    display: inline-block;
    margin-top: 20px;
    padding: 14px 28px;
    background: #FFE791;
    color: #201e50;
    text-decoration: none;
    border-radius: 6px;
    text-transform: uppercase;
    font-size: 14px;
  }

  .cart-drawer__group-label {
    margin: 0 0 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.5);
  }

  .cart-drawer__group-label:not(:first-child) {
    margin-top: 24px;
  }

  .cart-drawer__group-label--gift {
    color: #201e50;
  }

  .cart-drawer__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .cart-drawer__items--gifts {
    padding: 12px;
    background: #f8f5f0;
    border-radius: 8px;
  }

  .cart-drawer__item {
    display: flex;
    gap: 14px;
  }

  .cart-drawer__item-image {
    flex: 0 0 auto;
    width: 84px;
    height: 84px;
    border-radius: 8px;
    overflow: hidden;
    background: #f4f1ec;
    display: block;
  }

  .cart-drawer__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-drawer__item-info {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cart-drawer__item-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .cart-drawer__item-title {
    margin: 0;
    font-size: 14px;
    text-transform: uppercase;
    color: #000;
    text-decoration: none;
    line-height: 1.3;
  }

  .cart-drawer__item-remove {
    flex: 0 0 auto;
    background: none;
    border: none;
    cursor: pointer;
    padding: 2px;
  }

  .cart-drawer__item-variant {
    margin: 0;
    font-size: 12px;
    color: rgba(0, 0, 0, 0.6);
  }

  .cart-drawer__item-included {
    margin: 4px 0 0;
    font-size: 12px;
    font-weight: 600;
    color: #201e50;
  }

  .cart-drawer__item-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .cart-drawer__qty {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 10px;
    border-radius: 6px;
    border: 0.5px solid rgba(17, 17, 17, 0.4);
  }

  .cart-drawer__qty-btn {
    width: 16px;
    height: 16px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 14px;
    line-height: 1;
    color: #111;
    padding: 0;
  }

  .cart-drawer__qty-value {
    min-width: 14px;
    text-align: center;
    font-size: 13px;
  }

  .cart-drawer__item-price {
    font-size: 14px;
    white-space: nowrap;
  }

  .cart-drawer__gift-label {
    font-size: 12px;
    color: rgba(0, 0, 0, 0.6);
    text-transform: uppercase;
  }

  .cart-drawer__upsell-line {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    padding: 10px 12px;
    background: #f8f5f0;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .cart-drawer__upsell-line-thumb {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border-radius: 6px;
    object-fit: cover;
    background: #fff;
  }

  .cart-drawer__upsell-line-text {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 12.5px;
    line-height: 1.35;
    color: rgba(0, 0, 0, 0.75);
  }

  .cart-drawer__upsell-line-text strong {
    color: #201e50;
  }

  .cart-drawer__upsell-line-add {
    flex: 0 0 auto;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.18);
    background: #fff;
    color: #201e50;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .cart-drawer__upsell-line-add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .cart-drawer__footer {
    flex: 0 0 auto;
    padding: 16px 24px 24px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cart-drawer__trust {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cart-drawer__trust-item {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: #000;
  }

  .cart-drawer__trust-item svg {
    flex: 0 0 auto;
  }

  .cart-drawer__summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    color: #201e50;
  }

  .cart-drawer__discount-amount {
    font-weight: 600;
  }

  .cart-drawer__shipping-free {
    font-weight: 700;
    color: #1F6D3B;
  }

  .cart-drawer__subtotal-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 18px;
    text-transform: uppercase;
  }

  .cart-drawer__taxes-note {
    margin: 0;
    font-size: 12px;
    color: rgba(0, 0, 0, 0.6);
  }

  .cart-drawer__checkout-btn {
    width: 100%;
    height: 52px;
    border: none;
    cursor: pointer;
    background: #201E4D;
    color: #FFFFFF;
    font-size: 15px;
    text-transform: uppercase;
  }

  @media screen and (max-width: 480px) {
    .cart-drawer__panel {
      width: 100%;
      max-width: 100vw;
    }
  }

</style>

<script>
  (function () {
    function drawerRoot() {
      return document.querySelector('[data-cart-drawer]');
    }

    function updateCounts(cart) {
      document.querySelectorAll('[data-cart-count]').forEach(function (el) {
        el.textContent = cart.item_count;
        el.classList.toggle('is-empty', cart.item_count === 0);
      });
    }

    function formatMoney(cents) {
      return (cents / 100).toLocaleString('fr-FR', {
        style: 'currency',
        currency: window.Shopify && Shopify.currency ? Shopify.currency.active : 'EUR',
      });
    }

    function open() {
      var root = drawerRoot();
      if (!root) return;
      root.classList.add('is-open');
      root.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden';
    }

    function close() {
      var root = drawerRoot();
      if (!root) return;
      root.classList.remove('is-open');
      root.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
    }

    function refresh(cart) {
      if (cart) updateCounts(cart);
      return fetch(window.location.pathname + '?section_id=cart-drawer', { cache: 'no-store' })
        .then(function (res) { return res.text(); })
        .then(function (html) {
          var tmp = document.createElement('div');
          tmp.innerHTML = html;
          var fresh = tmp.querySelector('[data-cart-drawer]');
          var root = drawerRoot();
          if (!fresh || !root) return;
          var wasOpen = root.classList.contains('is-open');
          root.replaceWith(fresh);
          if (wasOpen) open();
        });
    }

    function changeLine(line, quantity) {
      return fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ line: line, quantity: quantity }),
      })
        .then(function (res) { return res.json(); })
        .then(function (cart) { return refresh(cart); });
    }

    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-cart-drawer-toggle]')) {
        e.preventDefault();
        open();
        return;
      }

      if (e.target.closest('[data-cart-drawer-close]')) {
        var link = e.target.closest('a[data-cart-drawer-close]');
        if (!link) e.preventDefault();
        close();
        return;
      }

      var incBtn = e.target.closest('[data-cart-drawer-increase]');
      if (incBtn) {
        var incRow = incBtn.closest('[data-cart-drawer-line]');
        var incQtyEl = incRow.querySelector('[data-cart-drawer-qty-value]');
        var incPriceEl = incRow.querySelector('[data-cart-drawer-line-price]');
        var newIncQty = parseInt(incQtyEl.textContent, 10) + 1;
        incQtyEl.textContent = newIncQty;
        if (incPriceEl) {
          var incUnit = parseFloat(incPriceEl.getAttribute('data-cart-drawer-line-price'));
          incPriceEl.textContent = formatMoney(incUnit * newIncQty);
        }
        changeLine(parseInt(incRow.getAttribute('data-cart-drawer-line'), 10), newIncQty);
        return;
      }

      var decBtn = e.target.closest('[data-cart-drawer-decrease]');
      if (decBtn) {
        var decRow = decBtn.closest('[data-cart-drawer-line]');
        var decQtyEl = decRow.querySelector('[data-cart-drawer-qty-value]');
        var nextQty = parseInt(decQtyEl.textContent, 10) - 1;
        if (nextQty < 1) return;
        decQtyEl.textContent = nextQty;
        var decPriceEl = decRow.querySelector('[data-cart-drawer-line-price]');
        if (decPriceEl) {
          var decUnit = parseFloat(decPriceEl.getAttribute('data-cart-drawer-line-price'));
          decPriceEl.textContent = formatMoney(decUnit * nextQty);
        }
        changeLine(parseInt(decRow.getAttribute('data-cart-drawer-line'), 10), nextQty);
        return;
      }

      var rmBtn = e.target.closest('[data-cart-drawer-remove]');
      if (rmBtn) {
        var rmRow = rmBtn.closest('[data-cart-drawer-line]');
        var rmLine = parseInt(rmRow.getAttribute('data-cart-drawer-line'), 10);
        rmRow.remove();
        changeLine(rmLine, 0);
        return;
      }

      var wLineAdd = e.target.closest('[data-cart-drawer-upsell-line-add]');
      if (wLineAdd) {
        var wLineWrap = wLineAdd.closest('[data-cart-drawer-upsell-line]');
        var wVariantId = wLineWrap.getAttribute('data-variant-id');
        wLineAdd.disabled = true;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: wVariantId, quantity: 1 }] }),
        })
          .then(function (res) { return res.json(); })
          .then(function () { return fetch('/cart.js'); })
          .then(function (res) { return res.json(); })
          .then(function (cart) { return refresh(cart); })
          .finally(function () { wLineAdd.disabled = false; });
        return;
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });

    window.VelinCartDrawer = { open: open, close: close, refresh: refresh };
  })();
</script>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
