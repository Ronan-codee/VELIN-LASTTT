  }

  .cart-drawer__group-label--gift {
    color: #201e50;
  }

  .cart-drawer__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .cart-drawer__items--gifts {
    padding: 12px;
    background: #f8f5f0;
