<section class="search container">
  <h1 class="search__title">{{ 'general.search.title' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search__form">
    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'general.search.placeholder' | t }}"
      aria-label="{{ 'general.search.title' | t }}"
    >
    <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 12 -%}
      {%- if search.results_count == 0 -%}
        <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- else -%}
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a href="{{ item.url }}" class="search__result">{{ item.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="pagination">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
