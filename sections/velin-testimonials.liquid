{% comment %} Velin - Testimonials (Figma: 1434 container, 4 cards, 295px each) {% endcomment %}

<div class="velin-testi" style="
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_v }}px {{ section.settings.padding_h }}px;
  gap: {{ section.settings.row_gap }}px;
">

  {% if section.settings.heading != blank %}
    <h2 class="velin-testi__heading" style="font-size: {{ section.settings.heading_size }}px;">
      {{ section.settings.heading }}
    </h2>
  {% endif %}

  <div class="velin-testi__grid" style="gap: {{ section.settings.card_gap }}px;">
    {% for block in section.blocks %}
      {% if block.type == 'review' %}
        <div class="velin-testi__card" style="width: {{ section.settings.card_width }}px;" {{ block.shopify_attributes }}>

          <div class="velin-testi__image" style="height: {{ section.settings.image_height }}px;">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
            {% endif %}
          </div>

          <div class="velin-testi__text">
            <div class="velin-testi__header">
              <div class="velin-testi__name-row">
                <span class="velin-testi__name">{{ block.settings.name }}</span>
                <span class="velin-testi__stars">
                  {% for i in (1..5) %}
                    <span class="velin-testi__star{% if i > block.settings.rating %} is-empty{% endif %}">
                      <svg width="16" height="14" viewBox="0 0 16 14" fill="currentColor"><path d="M8 0l2.1 4.5 5 .6-3.6 3.3 1 4.9L8 10.9l-4.5 2.4 1-4.9L1 5.1l5-.6L8 0z"/></svg>
                    </span>
                  {% endfor %}
                </span>
              </div>
              <div class="velin-testi__verified">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="#000"/><path d="M7 12.5l3 3 7-7" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {{ block.settings.verified_text }}
              </div>
            </div>

            <div class="velin-testi__body" data-testi-body>
              <p class="velin-testi__review" data-testi-review>{{ block.settings.review_text }}</p>
              <button type="button" class="velin-testi__readmore" data-testi-toggle style="display: none;">{{ block.settings.readmore_text }}</button>
            </div>
          </div>

        </div>
      {% endif %}
    {% endfor %}
  </div>

</div>

<style>
  .velin-testi {
    display: flex;
    flex-direction: column;
    max-width: 1634px;
    margin: 0 auto;
    box-sizing: border-box;
    font-family: 'Merriweather', serif;
  }

  .velin-testi__heading {
    max-width: 1234px;
    width: 100%;
    margin: 0 auto;
    font-family: 'Lusitana', serif;
    font-weight: 400;
    line-height: 100%;
    text-align: center;
    text-transform: uppercase;
    color: #000;
  }

  .velin-testi__grid {
    display: flex;
    max-width: 1234px;
    width: 100%;
    margin: 0 auto;
    flex-wrap: wrap;
    justify-content: center;
  }

  .velin-testi__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-radius: 12px;
    overflow: hidden;
    background: #FFFFFF;
    box-shadow: 1px 1px 4.2px 0px rgba(0,0,0,0.25);
  }

  .velin-testi__image {
    width: 100%;
    background: #F7F8F6;
  }

  .velin-testi__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .velin-testi__text {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 0 12px 44px 12px;
  }

  .velin-testi__header {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .velin-testi__name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .velin-testi__name {
    font-size: 20px;
    font-weight: 400;
    line-height: 100%;
    text-transform: capitalize;
    color: #000;
  }

  .velin-testi__stars {
    display: flex;
    gap: 2px;
  }

  .velin-testi__star {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(0,0,0,0.9);
  }

  .velin-testi__star.is-empty {
    color: rgba(0,0,0,0.2);
  }

  .velin-testi__verified {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 400;
    line-height: 100%;
    text-transform: uppercase;
    color: #000;
  }

  .velin-testi__body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    flex: 1;
  }

  .velin-testi__review {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 170%;
    letter-spacing: 0.02em;
    text-align: center;
    color: rgba(0,0,0,0.7);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
  }

  .velin-testi__review.is-expanded {
    -webkit-line-clamp: unset;
    display: block;
  }

  .velin-testi__readmore {
    background: none;
    border: none;
    padding: 0;
  }

  .velin-testi__readmore {
    margin: 0;
    font-size: 10px;
    font-weight: 500;
    line-height: 100%;
    text-align: center;
    text-transform: capitalize;
    color: #000;
    cursor: pointer;
  }

  @media screen and (max-width: 1100px) {
    .velin-testi {
      padding: 40px 20px !important;
    }
    .velin-testi__grid {
      flex-wrap: nowrap;
      overflow-x: auto;
    }
    .velin-testi__card {
      flex: 0 0 auto;
    }
  }
</style>

{% schema %}
{
  "name": "Velin Testimonials",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F7F7F7" },
    { "type": "range", "id": "padding_v", "label": "Padding top/bottom (px)", "min": 0, "max": 150, "step": 5, "default": 100 },
    { "type": "range", "id": "padding_h", "label": "Padding left/right (px)", "min": 0, "max": 150, "step": 5, "default": 100 },
    { "type": "range", "id": "row_gap", "label": "Gap heading to cards (px)", "min": 0, "max": 80, "step": 2, "default": 40 },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading text", "default": "Adoré par 60 000+" },
    { "type": "range", "id": "heading_size", "label": "Heading size (px)", "min": 20, "max": 70, "step": 1, "default": 48 },
    { "type": "header", "content": "Cards" },
    { "type": "range", "id": "card_width", "label": "Card width (px)", "min": 200, "max": 400, "step": 5, "default": 295 },
    { "type": "range", "id": "image_height", "label": "Image height (px)", "min": 150, "max": 400, "step": 5, "default": 230 },
    { "type": "range", "id": "card_gap", "label": "Gap between cards (px)", "min": 0, "max": 50, "step": 1, "default": 18 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Gigi K." },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "verified_text", "label": "Verified label", "default": "Achat vérifié" },
        { "type": "textarea", "id": "review_text", "label": "Review text", "default": "Ce sac est exactement ce que je cherchais. Il est élégant, léger et offre beaucoup d'espace pour mes essentiels du quotidien. Le cuir est très agréable au toucher" },
        { "type": "text", "id": "readmore_text", "label": "Read more text", "default": "Lire la suite" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Velin Testimonials",
      "blocks": [
        { "type": "review", "settings": { "name": "Gigi K.", "rating": 5 } },
        { "type": "review", "settings": { "name": "Valeri B.", "rating": 5, "review_text": "Le savoir-faire est remarquable ! J'utilise ce sac tous les jours depuis des semaines et il a toujours l'air neuf. Il est durable, confortable à porter et" } },
        { "type": "review", "settings": { "name": "Danique M.", "rating": 5, "review_text": "La qualité de fabrication est exceptionnelle ! J'utilise ce sac quotidiennement depuis plusieurs semaines et il est toujours comme neuf. Il est durable, confortable à porter et" } },
        { "type": "review", "settings": { "name": "Danique M.", "rating": 5, "review_text": "La qualité de fabrication est exceptionnelle ! J'utilise ce sac quotidiennement depuis plusieurs semaines et il est toujours comme neuf. Il est durable, confortable à porter et" } }
      ]
    }
  ]
}
{% endschema %}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("[data-testi-body]").forEach(function (body) {
      var review = body.querySelector("[data-testi-review]");
      var btn = body.querySelector("[data-testi-toggle]");
      if (!review || !btn) return;

      // Check if text overflows (needs clamping)
      if (review.scrollHeight > review.clientHeight + 2) {
        btn.style.display = "block";
      }

      var originalText = btn.textContent;

      btn.addEventListener("click", function () {
        var isExpanded = review.classList.toggle("is-expanded");
        btn.textContent = isExpanded ? "Lire moins" : originalText;
      });
    });
  });
</script>