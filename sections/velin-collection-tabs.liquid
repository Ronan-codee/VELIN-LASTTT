{% comment %} Velin - Collection Tabs + Product Grid (Figma: 1440 container, 942 tabs row, 1240 grid, 295x404 cards) {% endcomment %}

<div class="velin-collection-tabs" id="VelinTabs-{{ section.id }}" style="
  background-color: {{ section.settings.bg_color }};
  padding: {{ section.settings.section_padding }}px;
  gap: {{ section.settings.content_gap }}px;
">

  <div class="velin-collection-tabs__nav" style="gap: {{ section.settings.tabs_gap }}px;">
    {% for block in section.blocks %}
      <button
        type="button"
        class="velin-collection-tabs__tab{% if forloop.first %} is-active{% endif %}"
        data-tab-target="panel-{{ forloop.index }}"
        style="
          font-size: {{ section.settings.tab_size }}px;
          font-weight: {% if section.settings.tab_bold %}700{% else %}400{% endif %};
          color: {{ section.settings.tab_color }};
        "
        {{ block.shopify_attributes }}
      >{{ block.settings.label }}</button>
    {% endfor %}
  </div>

  {% for block in section.blocks %}
    {%- liquid
      if block.settings.collection != blank
        assign tab_collection = block.settings.collection
      else
        assign tab_collection = collection
      endif
    -%}
    <div
      class="velin-collection-tabs__panel"
      data-tab-panel="panel-{{ forloop.index }}"
      {% unless forloop.first %}style="display: none;"{% endunless %}
    >
      <div class="velin-collection-tabs__grid" style="column-gap: {{ section.settings.card_gap }}px; row-gap: {{ section.settings.row_gap }}px;">
        {% for product in tab_collection.products limit: section.settings.products_to_show %}
          <div class="velin-tab-card" style="width: {{ section.settings.card_width }}px; gap: {{ section.settings.card_inner_gap }}px;">
            <a href="{{ product.url }}" class="velin-tab-card__image-wrap" style="height: {{ section.settings.image_height }}px; border-radius: {{ section.settings.image_radius }}px;">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                >
              {% endif %}
            </a>
            <div class="velin-tab-card__info">
              <div class="velin-tab-card__top">
                <a href="{{ product.url }}" class="velin-tab-card__title" style="
                  font-size: {{ section.settings.title_size }}px;
                  font-weight: {% if section.settings.title_bold %}700{% else %}400{% endif %};
                ">{{ product.title }}</a>
                {% if section.settings.show_rating %}
                  {%- assign rating = product.metafields.reviews.rating.value -%}
                  <span class="velin-tab-card__rating" style="font-size: {{ section.settings.rating_size }}px;">
                    &#9733; {% if rating %}{{ rating.rating }}{% else %}{{ section.settings.default_rating }}{% endif %}
                  </span>
                {% endif %}
              </div>
              {% unless product.has_only_default_variant %}
                <div class="velin-tab-card__options" style="font-size: {{ section.settings.option_size }}px;">
                  {% for option in product.options %}
                    <span class="velin-tab-card__option">{{ option }} <span class="velin-tab-caret">&#9662;</span></span>
                  {% endfor %}
                </div>
              {% endunless %}
              <div class="velin-tab-card__price" style="font-size: {{ section.settings.price_size }}px;">
                {{ product.price | money }}
              </div>
            </div>
          </div>
        {% else %}
          <p class="velin-collection-tabs__empty">Is tab ke liye collection select karein (theme editor &rarr; tab block).</p>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>

<style>
  .velin-collection-tabs {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  .velin-collection-tabs__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    max-width: 942px;
  }

  .velin-collection-tabs__tab {
    background: none;
    border: none;
    padding: 0 0 6px;
    cursor: pointer;
    font-family: var(--font-heading, serif);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
  }

  .velin-collection-tabs__tab.is-active {
    border-bottom-color: currentColor;
  }

  .velin-collection-tabs__grid {
    display: flex;
    flex-wrap: wrap;
    max-width: 1240px;
    margin: 0 auto;
    width: 100%;
    justify-content: flex-start;
  }

  .velin-tab-card {
    display: flex;
    flex-direction: column;
  }

  .velin-tab-card__image-wrap {
    display: block;
    overflow: hidden;
    background: #eee;
  }

  .velin-tab-card__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .velin-tab-card__info {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .velin-tab-card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }

  .velin-tab-card__title {
    color: #1c1c1c;
    text-decoration: none;
    line-height: 1.3;
  }

  .velin-tab-card__rating {
    white-space: nowrap;
    color: #1c1c1c;
  }

  .velin-tab-card__options {
    display: flex;
    gap: 16px;
    color: #555;
  }

  .velin-tab-card__option {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .velin-tab-caret {
    font-size: 11px;
  }

  .velin-tab-card__price {
    font-weight: 500;
    color: #1c1c1c;
  }

  .velin-collection-tabs__empty {
    color: #777;
    font-size: 14px;
  }

  @media screen and (max-width: 999px) {
    .velin-collection-tabs {
      padding: 40px 20px !important;
    }

    .velin-collection-tabs__grid {
      justify-content: center;
    }

    .velin-tab-card {
      width: calc(50% - 10px) !important;
    }
  }

  @media screen and (max-width: 560px) {
    .velin-tab-card {
      width: 100% !important;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById("VelinTabs-{{ section.id }}");
    if (!root) return;

    var tabs = root.querySelectorAll("[data-tab-target]");
    var panels = root.querySelectorAll("[data-tab-panel]");

    tabs.forEach(function (tab) {
      tab.addEventListener("click", function () {
        tabs.forEach(function (t) { t.classList.remove("is-active"); });
        tab.classList.add("is-active");

        var target = tab.getAttribute("data-tab-target");
        panels.forEach(function (panel) {
          panel.style.display = panel.getAttribute("data-tab-panel") === target ? "" : "none";
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Velin Collection Tabs",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FFFFFF" },
    { "type": "range", "id": "section_padding", "label": "Section Padding (px)", "min": 0, "max": 150, "step": 5, "default": 100 },
    { "type": "range", "id": "content_gap", "label": "Gap: tabs row to grid (px)", "min": 0, "max": 100, "step": 5, "default": 40 },
    { "type": "header", "content": "Tabs" },
    { "type": "range", "id": "tabs_gap", "label": "Gap between tab names (px)", "min": 10, "max": 100, "step": 5, "default": 60 },
    { "type": "range", "id": "tab_size", "label": "Tab text size (px)", "min": 10, "max": 24, "step": 1, "default": 13 },
    { "type": "checkbox", "id": "tab_bold", "label": "Bold tab text", "default": false },
    { "type": "color", "id": "tab_color", "label": "Tab text color", "default": "#1C1C1C" },
    { "type": "header", "content": "Products" },
    { "type": "range", "id": "products_to_show", "label": "Products to show per tab", "min": 4, "max": 24, "step": 1, "default": 20 },
    { "type": "range", "id": "card_width", "label": "Card width (px)", "min": 150, "max": 400, "step": 5, "default": 295 },
    { "type": "range", "id": "card_gap", "label": "Gap between cards (px)", "min": 0, "max": 80, "step": 5, "default": 20 },
    { "type": "range", "id": "row_gap", "label": "Gap between rows (px)", "min": 0, "max": 100, "step": 5, "default": 40 },
    { "type": "range", "id": "card_inner_gap", "label": "Gap: image to text (px)", "min": 0, "max": 60, "step": 2, "default": 20 },
    { "type": "range", "id": "image_height", "label": "Image height (px)", "min": 100, "max": 500, "step": 5, "default": 250 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius (px)", "min": 0, "max": 40, "step": 1, "default": 8 },
    { "type": "header", "content": "Card text" },
    { "type": "range", "id": "title_size", "label": "Title size (px)", "min": 10, "max": 30, "step": 1, "default": 15 },
    { "type": "checkbox", "id": "title_bold", "label": "Bold title", "default": false },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "text", "id": "default_rating", "label": "Default rating (when product has none)", "default": "4.5" },
    { "type": "range", "id": "rating_size", "label": "Rating size (px)", "min": 10, "max": 24, "step": 1, "default": 13 },
    { "type": "range", "id": "option_size", "label": "Options text size (px)", "min": 10, "max": 24, "step": 1, "default": 13 },
    { "type": "range", "id": "price_size", "label": "Price size (px)", "min": 10, "max": 30, "step": 1, "default": 15 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab name", "default": "ALL" },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Is tab par click karne se iss collection ke products dikhenge. Khali chhodne par current collection use hogi."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Velin Collection Tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "ALL" } },
        { "type": "tab", "settings": { "label": "TOTE BAGS" } },
        { "type": "tab", "settings": { "label": "SHOULDER BAGS" } },
        { "type": "tab", "settings": { "label": "CROSSBODY" } },
        { "type": "tab", "settings": { "label": "TOP HANDLE" } },
        { "type": "tab", "settings": { "label": "MINI BAGS" } }
      ]
    }
  ]
}
{% endschema %}
