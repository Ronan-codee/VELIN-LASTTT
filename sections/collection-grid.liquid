{% comment %}
  VELIN — Custom Premium Product / Collection Grid Section (Marquee, linked to real products)
  sync-retry-marker
{% endcomment %}

{%- assign sec_id = section.id -%}
{%- assign marquee_duration = 100 | minus: section.settings.marquee_speed -%}

<style>
  #velin-collection-{{ sec_id }} {
    width: 100%;
    padding: 60px 0;
    background-color: #F9F9F9;
    font-family: "Manrope", sans-serif;
  }

  #velin-collection-{{ sec_id }} .section-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #velin-collection-{{ sec_id }} .section-heading {
    font-size: 28px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 40px;
    color: #000000;
    text-align: left;
  }

  /* Marquee — infinite auto-scroll, full-bleed edge to edge with the browser window */
  #velin-collection-{{ sec_id }} .products-marquee {
    overflow: hidden;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  #velin-collection-{{ sec_id }} .products-marquee__track {
    display: flex;
    width: max-content;
    animation: velin-collection-marquee-{{ sec_id }} {{ marquee_duration }}s linear infinite;
  }

  #velin-collection-{{ sec_id }} .products-marquee:hover .products-marquee__track {
    animation-play-state: paused;
  }

  @keyframes velin-collection-marquee-{{ sec_id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  #velin-collection-{{ sec_id }} .products-marquee__set {
    display: flex;
    flex-shrink: 0;
    gap: 24px;
    padding-right: 24px;
  }

  /* ---------- Product Card Design ---------- */
  #velin-collection-{{ sec_id }} .product-card {
    width: 300px;
    flex: 0 0 auto;
    background: transparent;
    border-radius: 12px;
    padding: 24px 0;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #velin-collection-{{ sec_id }} .product-card:hover {
    transform: translateY(-4px);
  }

  #velin-collection-{{ sec_id }} .card-header-info {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 15px;
  }

  #velin-collection-{{ sec_id }} .text-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #velin-collection-{{ sec_id }} .product-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  #velin-collection-{{ sec_id }} .product-title {
    font-size: 14px;
    font-weight: 500;
    color: #222;
    margin: 0;
    text-align: left;
  }

  #velin-collection-{{ sec_id }} .product-rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: #1c1c1c;
    white-space: nowrap;
    flex-shrink: 0;
  }

  #velin-collection-{{ sec_id }} .product-rating .icon-star {
    width: 12px;
    height: 12px;
  }

  #velin-collection-{{ sec_id }} .product-price {
    font-size: 14px;
    font-weight: 400;
    color: #000;
    margin: 0;
    text-align: left;
  }

  #velin-collection-{{ sec_id }} .image-wrapper {
    width: 100%;
    height: 280px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 15px;
    overflow: hidden;
    background-color: #f7f7f7;
    border-radius: 8px;
    position: relative;
  }

  #velin-collection-{{ sec_id }} .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #velin-collection-{{ sec_id }} .image-wrapper__secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  @media (hover: hover) {
    #velin-collection-{{ sec_id }} .product-card:hover .image-wrapper__secondary {
      opacity: 1;
    }
  }

  #velin-collection-{{ sec_id }} .image-wrapper__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
    background: #b3001b;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 4px 8px;
    border-radius: 4px;
  }

  #velin-collection-{{ sec_id }} .product-price__compare {
    color: #999;
    margin-right: 6px;
    font-weight: 400;
    text-decoration: line-through;
  }

  @media (max-width: 600px) {
    #velin-collection-{{ sec_id }} .section-heading {
      font-size: 22px;
      margin-bottom: 25px;
    }
  }

  #velin-collection-{{ sec_id }} .section-cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  #velin-collection-{{ sec_id }} .section-cta {
    display: inline-block;
    padding: 14px 32px;
    background: #674E35;
    color: #ffffff;
    text-decoration: none;
    font-family: "Merriweather", serif;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 6px;
    transition: opacity 0.2s ease;
  }

  #velin-collection-{{ sec_id }} .section-cta:hover {
    opacity: 0.85;
  }
</style>

<div id="velin-collection-{{ sec_id }}">
  <div class="section-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="products-marquee">
      <div class="products-marquee__track">
        {%- assign grid_collection_products = section.settings.collection.products -%}
        {%- for i in (1..2) -%}
          <div class="products-marquee__set" aria-hidden="{% if i == 1 %}false{% else %}true{% endif %}">
            {%- if grid_collection_products != blank -%}
              {%- comment -%} Collection selected: show every product in it automatically, ignoring the manual blocks below. {%- endcomment -%}
              {%- for linked_product in grid_collection_products -%}
                {%- liquid
                  assign marquee_variant = linked_product.selected_or_first_available_variant
                  assign marquee_discount = 0
                  if marquee_variant.compare_at_price > marquee_variant.price
                    assign marquee_discount = marquee_variant.compare_at_price | minus: marquee_variant.price | times: 100.0 | divided_by: marquee_variant.compare_at_price | round
                  endif
                -%}
                <a href="{{ linked_product.url }}" class="product-card">
                  <div class="card-header-info">
                    <div class="text-details">
                      <div class="product-title-row">
                        <h3 class="product-title">{{ linked_product.title }}</h3>
                      </div>

                      <p class="product-price">
                        {%- if marquee_discount > 0 -%}
                          <s class="product-price__compare">{{ marquee_variant.compare_at_price | money }}</s>
                        {%- endif -%}
                        {{ marquee_variant.price | money }}
                      </p>
                    </div>
                  </div>

                  <div class="image-wrapper">
                    {%- if marquee_discount > 0 -%}
                      <span class="image-wrapper__badge">-{{ marquee_discount }}%</span>
                    {%- endif -%}
                    {%- if linked_product.featured_image -%}
                      <img class="image-wrapper__primary" src="{{ linked_product.featured_image | image_url: width: 600 }}" alt="{{ linked_product.featured_image.alt | escape }}" loading="lazy">
                      {%- if linked_product.images[1] -%}
                        <img class="image-wrapper__secondary" src="{{ linked_product.images[1] | image_url: width: 600 }}" alt="{{ linked_product.images[1].alt | escape }}" loading="lazy">
                      {%- endif -%}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                </a>
              {%- endfor -%}
            {%- else -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'product_item' -%}
                  {%- assign linked_product = block.settings.product -%}

                  {%- if linked_product != blank -%}
                    {%- liquid
                      assign marquee_variant = linked_product.selected_or_first_available_variant
                      assign marquee_discount = 0
                      if marquee_variant.compare_at_price > marquee_variant.price
                        assign marquee_discount = marquee_variant.compare_at_price | minus: marquee_variant.price | times: 100.0 | divided_by: marquee_variant.compare_at_price | round
                      endif
                    -%}
                    <a
                      href="{{ linked_product.url }}"
                      class="product-card"
                      {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}
                    >
                      <div class="card-header-info">
                        <div class="text-details">
                          <div class="product-title-row">
                            <h3 class="product-title">{{ linked_product.title }}</h3>
                          </div>

                          <p class="product-price">
                            {%- if marquee_discount > 0 -%}
                              <s class="product-price__compare">{{ marquee_variant.compare_at_price | money }}</s>
                            {%- endif -%}
                            {{ marquee_variant.price | money }}
                          </p>
                        </div>
                      </div>

                      <div class="image-wrapper">
                        {%- if marquee_discount > 0 -%}
                          <span class="image-wrapper__badge">-{{ marquee_discount }}%</span>
                        {%- endif -%}
                        {%- if linked_product.featured_image -%}
                          <img class="image-wrapper__primary" src="{{ linked_product.featured_image | image_url: width: 600 }}" alt="{{ linked_product.featured_image.alt | escape }}" loading="lazy">
                          {%- if linked_product.images[1] -%}
                            <img class="image-wrapper__secondary" src="{{ linked_product.images[1] | image_url: width: 600 }}" alt="{{ linked_product.images[1].alt | escape }}" loading="lazy">
                          {%- endif -%}
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </div>
                    </a>
                  {%- else -%}
                    <div class="product-card" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}>
                      <div class="card-header-info">
                        <div class="text-details">
                          <h3 class="product-title">{{ block.settings.title | default: "Product Title" }}</h3>
                          <p class="product-price">{{ block.settings.price | default: "$2355" }}</p>
                        </div>
                      </div>

                      <div class="image-wrapper">
                        {%- if block.settings.image != blank -%}
                          <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}" loading="lazy">
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="section-cta-wrap">
        <a href="{{ section.settings.cta_link | default: '/collections/nos-produits' }}" class="section-cta">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom Collection Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "TOUTE LA COLLECTION"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (automatique)",
      "info": "Quand une collection est choisie, tous ses produits s'affichent automatiquement et les blocs \"Product Item\" ci-dessous sont ignorés. Laissez vide pour choisir les produits manuellement avec les blocs."
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee speed",
      "info": "Higher = faster",
      "min": 10,
      "max": 90,
      "step": 5,
      "default": 65
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Bouton (texte)",
      "info": "Laissez vide pour masquer le bouton.",
      "default": "Voir toute la collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Bouton (lien)",
      "info": "Laissez vide pour pointer vers /collections/nos-produits."
    }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product Item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Select a real product — its title, price, image and page link will be used automatically."
        },
        {
          "type": "header",
          "content": "Fallback (if no product selected)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "Leadleader bag"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Product Price",
          "default": "$2355"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Collection Grid",
      "blocks": [
        { "type": "product_item" },
        { "type": "product_item" },
        { "type": "product_item" },
        { "type": "product_item" },
        { "type": "product_item" },
        { "type": "product_item" }
      ]
    }
  ]
}
{% endschema %}
