    <svg width="20" height="23" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M448,209.91a210.06,210.06,0,0,1-122.77-39.25V349.38A162.55,162.55,0,1,1,185,188.31V278.2a74.62,74.62,0,1,0,52.23,71.18V0l88,0a121.18,121.18,0,0,0,1.86,22.17h0A122.18,122.18,0,0,0,381,102.39a121.43,121.43,0,0,0,67,20.14Z"/></svg>
  {%- when 'thumbs_up' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 11v9H4v-9h3Zm0 0 4-7c1.2 0 2 .9 2 2v4h5.2c1 0 1.8 1 1.6 2l-1 6c-.2.9-.9 1.5-1.8 1.5H7" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
  {%- when 'phone' -%}
