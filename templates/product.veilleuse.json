    "faq": {
      "type": "vnl-faq",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "q": "Combien de temps tient la batterie ?",
            "a": "De 4 à 12 heures selon la luminosité et le volume. Elle se recharge en moins d'une heure en USB-C et peut rester branchée en permanence."
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "q": "Combien de couleurs ?",
            "a": "18 couleurs, en lumière fixe, animée, en dégradé ou rythmée sur votre musique, dont un mode rouge pour la nuit."
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "q": "Peut-on l'utiliser dans la salle de bain ?",
            "a": "Oui, elle supporte la vapeur d'une douche. Posez-la débranchée sur une surface sèche, à l'écart des projections d'eau. Elle n'est pas étanche."
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "q": "Peut-on l'utiliser sans le son ?",
            "a": "Oui. Lumière seule, son seul, ou les deux."
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "q": "Comment marche le Bluetooth ?",
            "a": "Connectez votre téléphone comme à n'importe quelle enceinte, puis diffusez votre musique, un podcast ou un livre audio."
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "q": "La lumière fatigue-t-elle les yeux ?",
            "a": "Les LED sont sans scintillement et la luminosité descend très bas, jusqu'à une simple lueur."
          }
        },
        "faq_7": {
          "type": "faq",
          "settings": {
            "q": "Peut-on l'utiliser dans une chambre d'enfant ?",
            "a": "Oui, pour l'histoire du soir ou comme veilleuse. Placez-la hors de portée, à environ 2 m du lit, volume bas, jamais dans le lit."
          }
        },
        "faq_8": {
          "type": "faq",
          "settings": {
            "q": "Est-ce une bonne idée cadeau ?",
            "a": "Oui : elle se pose partout, ne demande aucune installation et plaît autant pour une chambre que pour une salle de bain. Le pack de deux permet d'en garder une et d'en offrir une."
          }
        },
        "faq_9": {
          "type": "faq",
          "settings": {
            "q": "Quand vais-je recevoir ma commande ?",
            "a": "Expédiée sous 24 h ouvrées, livrée en 5 à 9 jours ouvrés. Vous recevez le numéro de suivi par e-mail."
          }
        },
        "faq_10": {
          "type": "faq",
          "settings": {
            "q": "Et si elle ne me convient pas ?",
            "a": "Écrivez-nous dans les 30 nuits suivant la réception, nous vous remboursons."
          }
        }
