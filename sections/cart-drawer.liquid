  .cart-drawer__brand-trust {
    margin: 8px 0 0;
    font-size: 12px;
    font-weight: 500;
    color: #201e50;
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 24px 16px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .cart-drawer__title {
    margin: 0;
    font-family: 'Lusitana', serif;
    font-weight: 400;
    font-size: 20px;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .cart-drawer__body {
