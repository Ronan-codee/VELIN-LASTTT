{%- if section.settings.heading != blank -%}
  <link href="https://fonts.googleapis.com/css2?family=Aldrich&display=swap" rel="stylesheet">
{%- endif -%}
<section class="video-section{% if section.settings.video == blank and section.settings.cover_image == blank %} video-section--placeholder{% endif %}">
  {%- if section.settings.video != blank -%}
    {{
      section.settings.video
      | video_tag:
        image_size: '1200x',
        autoplay: section.settings.autoplay,
        loop: section.settings.loop,
        muted: section.settings.autoplay,
        controls: section.settings.controls,
        preload: 'metadata',
        class: 'video-section__video'
    }}
  {%- elsif section.settings.cover_image != blank -%}
    <img
      src="{{ section.settings.cover_image | image_url: width: 2400 }}"
      alt="{{ section.settings.cover_image.alt | escape }}"
      loading="lazy"
    >
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    <div class="video-section__overlay" style="background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});">
      <h2 class="video-section__heading" style="color: {{ section.settings.text_color }}; font-size: clamp(24px, 4vw, {{ section.settings.heading_size }}px);">
        {{ section.settings.heading }}
      </h2>
    </div>
  {%- endif -%}
</section>

<style>
  .video-section {
    position: relative;
  }

  .video-section__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
  }

  .video-section__heading {
    margin: 0;
    max-width: 900px;
    font-family: "Aldrich", sans-serif;
    font-weight: 400;
    line-height: 1.15;
    text-transform: uppercase;
  }
</style>

{% schema %}
{
  "name": "Video",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Uploaded directly here in the theme editor."
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Fallback image",
      "info": "Shown if no video is uploaded."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay (muted)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "controls",
      "label": "Show controls",
      "default": false
    },
    { "type": "header", "content": "Overlay text (optional)" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "heading_size", "label": "Heading size (px, desktop)", "min": 20, "max": 72, "step": 2, "default": 42 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "range", "id": "overlay_opacity", "label": "Dark overlay opacity (%)", "min": 0, "max": 80, "step": 5, "default": 30 }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}
