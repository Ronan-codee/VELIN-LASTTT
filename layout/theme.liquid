<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {%- comment -%}
      Must render before content_for_header: Revy Bundle's app-embed script
      reads window.revyBundleThemeSettings on load, and Revy's own docs say
      the app works with its defaults if this snippet is absent — it's only
      being added now to set disableFacebookTracker: true, since the app's
      own Facebook tracker was firing a duplicate AddToCart/InitiateCheckout
      alongside Shopify's native Pixel + Conversions API integration.
    {%- endcomment -%}
    {% render 'revy-bundle-script' %}

    {{ content_for_header }}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manuale:wght@400;500&family=Merriweather:wght@300;400&family=Lusitana:wght@400;700&display=swap" rel="stylesheet">

    {% style %}
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      {{ settings.font_body | font_face: font_display: 'swap' }}

      :root {
        --color-background: {{ settings.color_background }};
        --color-text: {{ settings.color_text }};
        --color-brown: {{ settings.color_brown }};
        --color-dark: {{ settings.color_dark }};
        --color-beige: {{ settings.color_beige }};
        --color-gold: {{ settings.color_gold }};
        --color-cream: {{ settings.color_cream }};
        --color-button: {{ settings.color_button }};
        --color-button-text: {{ settings.color_button_text }};
        --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>var _learnq = window._learnq || [];</script>
    <script async type="text/javascript" src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=SSbiN6"></script>
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}-{{ template.suffix | handle }}{% endif %}">
    {% sections 'header-group' %}
    {% section 'cart-drawer' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {{ 'global.js' | asset_url | script_tag }}
  </body>
</html>
