{% comment %} Velin - Brand Story (Figma: 1441 container, 706 text / 505 image, 30px gap) {% endcomment %}

<div class="velin-story" style="
  padding: {{ section.settings.padding_v }}px {{ section.settings.padding_h }}px;
  gap: {{ section.settings.column_gap }}px;
">

  <div class="velin-story__text" style="gap: {{ section.settings.text_gap }}px;">

    <h2 class="velin-story__heading" style="font-size: {{ section.settings.heading_size }}px;">
      {{ section.settings.heading_before }}
      <span class="velin-story__highlight" style="background: {{ section.settings.highlight_bg }};">{{ section.settings.heading_highlight }}</span>
      {{ section.settings.heading_after }}
    </h2>

    {% if section.settings.body_text != blank %}
      <p class="velin-story__body" style="font-size: {{ section.settings.body_size }}px;">
        {{ section.settings.body_text }}
      </p>
    {% endif %}

    {%- assign has_features = false -%}
    {% for block in section.blocks %}{% if block.type == 'feature_item' %}{% assign has_features = true %}{% endif %}{% endfor %}
    {% if has_features %}
      <div class="velin-story__features" style="gap: {{ section.settings.feature_gap }}px;">
        {% for block in section.blocks %}
          {% if block.type == 'feature_item' %}
            <div class="velin-story__feature" {{ block.shopify_attributes }}>
              <span class="velin-story__feature-icon">
                {% if block.settings.icon_type == 'check' %}
                  <svg width="20" height="14" viewBox="0 0 20 14" fill="none"><path d="M1 7L7 13L19 1" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {% else %}
                  👜
                {% endif %}
              </span>
              <span class="velin-story__feature-text">{{ block.settings.text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

  </div>

  <div class="velin-story__image">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading_highlight | escape }}" loading="lazy">
    {% endif %}
  </div>

</div>

<style>
  .velin-story {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 1641px;
    margin: 0 auto;
    box-sizing: border-box;
    font-family: 'Merriweather', serif;
  }

  .velin-story__text {
    display: flex;
    flex-direction: column;
    flex: 1 1 706px;
    max-width: 706px;
  }

  .velin-story__heading {
    margin: 0;
    font-family: 'Lusitana', serif;
    font-weight: 400;
    line-height: 150%;
    letter-spacing: -0.04em;
    text-transform: capitalize;
    color: #000;
  }

  .velin-story__highlight {
    padding: 2px 10px;
    border-radius: 6px;
    color: {{ section.settings.highlight_text_color }};
  }

  .velin-story__body {
    margin: 0;
    max-width: 690px;
    font-weight: 500;
    line-height: 150%;
    letter-spacing: 0.02em;
    text-transform: capitalize;
    color: rgba(0,0,0,0.7);
  }

  .velin-story__features {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .velin-story__feature {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .velin-story__feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    font-size: 25px;
    flex: 0 0 30px;
  }

  .velin-story__feature-text {
    font-weight: 500;
    font-size: 28px;
    line-height: 100%;
    text-transform: capitalize;
    color: #000;
    white-space: nowrap;
  }

  .velin-story__image {
    flex: 1 1 505px;
    max-width: 505px;
  }

  .velin-story__image img {
    width: 100%;
    height: {{ section.settings.image_height }}px;
    object-fit: cover;
    border-radius: {{ section.settings.image_radius }}px;
    display: block;
  }

  @media screen and (max-width: 1100px) {
    .velin-story {
      flex-direction: column;
      padding: 40px 20px !important;
      gap: 32px !important;
    }
    .velin-story__text,
    .velin-story__image {
      max-width: 100%;
      flex: 1 1 auto;
    }
    .velin-story__feature-text {
      font-size: 18px;
      white-space: normal;
    }
  }
</style>

{% schema %}
{
  "name": "Velin Brand Story",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_v", "label": "Padding top/bottom (px)", "min": 0, "max": 150, "step": 5, "default": 100 },
    { "type": "range", "id": "padding_h", "label": "Padding left/right (px)", "min": 0, "max": 150, "step": 5, "default": 100 },
    { "type": "range", "id": "column_gap", "label": "Gap text/image (px)", "min": 0, "max": 80, "step": 2, "default": 30 },
    { "type": "range", "id": "text_gap", "label": "Gap inside text column (px)", "min": 0, "max": 80, "step": 2, "default": 40 },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading_before", "label": "Heading - before highlight", "default": "Le" },
    { "type": "text", "id": "heading_highlight", "label": "Heading - highlighted word", "default": "Sac Iconique" },
    { "type": "text", "id": "heading_after", "label": "Heading - after highlight", "default": "Bag-Off" },
    { "type": "range", "id": "heading_size", "label": "Heading size (px)", "min": 20, "max": 60, "step": 1, "default": 40 },
    { "type": "color", "id": "highlight_bg", "label": "Highlight background", "default": "#AA8870" },
{ "type": "color", "id": "highlight_text_color", "label": "Highlight text color", "default": "#FFFFFF" },
    { "type": "header", "content": "Body text" },
    { "type": "textarea", "id": "body_text", "label": "Body text", "default": "Nos sacs en cuir premium sont plébiscités pour leur design intemporel, leur savoir-faire exceptionnel et leur fonctionnalité au quotidien. Élégants, durables, ils subliment chaque occasion." },
    { "type": "range", "id": "body_size", "label": "Body text size (px)", "min": 14, "max": 36, "step": 1, "default": 28 },
    { "type": "header", "content": "Features" },
    { "type": "range", "id": "feature_gap", "label": "Gap between features (px)", "min": 0, "max": 60, "step": 1, "default": 28 },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "image_height", "label": "Image height (px)", "min": 300, "max": 800, "step": 5, "default": 600 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius (px)", "min": 0, "max": 40, "step": 1, "default": 14 }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature item",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Checkmark" },
            { "value": "bag", "label": "Bag emoji" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Cuir Premium" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Velin Brand Story",
      "blocks": [
        { "type": "feature_item", "settings": { "icon_type": "check", "text": "Cuir Premium" } },
        { "type": "feature_item", "settings": { "icon_type": "bag", "text": "Design Spacieux" } }
      ]
    }
  ]
}
{% endschema %}