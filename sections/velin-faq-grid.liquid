{% comment %} Velin - FAQ Grid (Figma: 1439 container, 610px per card, 2 columns) {% endcomment %}

<div class="velin-faqg" style="
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_v }}px {{ section.settings.padding_h }}px;
  gap: {{ section.settings.row_gap }}px;
">

  {% if section.settings.heading != blank %}
    <h2 class="velin-faqg__heading" style="font-size: {{ section.settings.heading_size }}px;">
      {{ section.settings.heading }}
    </h2>
  {% endif %}

  <div class="velin-faqg__grid" style="gap: {{ section.settings.grid_gap }}px;">
    {% for block in section.blocks %}
      {% if block.type == 'faq_grid_item' %}
        <div class="velin-faqg__item" {{ block.shopify_attributes }}>
          <button type="button" class="velin-faqg__row" data-faqg-toggle>
            <p class="velin-faqg__question">{{ block.settings.question }}</p>
            <span class="velin-faqg__plus" data-faqg-plus></span>
          </button>
          <div class="velin-faqg__answer" data-faqg-answer>
            <div class="velin-faqg__answer-inner">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

</div>

<style>
  .velin-faqg {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    font-family: 'Merriweather', serif;
  }

  .velin-faqg__heading {
    margin: 0;
    max-width: 1239px;
    width: 100%;
    align-self: center;
    font-family: 'Lusitana', serif;
    font-weight: 400;
    line-height: 100%;
    text-align: center;
    text-transform: uppercase;
    color: #000;
  }

  .velin-faqg__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    max-width: 1239px;
    width: 100%;
    align-self: center;
  }

  .velin-faqg__item {
    display: flex;
    flex-direction: column;
    background: #FFFFFF;
    border-radius: 10px;
  }

  .velin-faqg__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 10px;
    padding: {{ section.settings.card_padding_v }}px {{ section.settings.card_padding_h }}px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }

  .velin-faqg__question {
    margin: 0;
    font-weight: {{ section.settings.question_weight }};
    font-size: {{ section.settings.question_size }}px;
    text-transform: capitalize;
    color: rgba(0,0,0,0.7);
  }

  .velin-faqg__plus {
    position: relative;
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
  }

  .velin-faqg__plus::before,
  .velin-faqg__plus::after {
    content: '';
    position: absolute;
    background: #000;
  }

  .velin-faqg__plus::before {
    width: 16.33px;
    height: 2px;
    top: 13px;
    left: 5.83px;
  }

  .velin-faqg__plus::after {
    width: 2px;
    height: 16.33px;
    top: 5.83px;
    left: 13px;
    transition: opacity 0.2s ease;
  }

  .velin-faqg__item.is-open .velin-faqg__plus::after {
    opacity: 0;
  }

  .velin-faqg__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .velin-faqg__answer-inner {
    padding: 0 {{ section.settings.card_padding_h }}px {{ section.settings.card_padding_v }}px;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(0,0,0,0.6);
  }

  @media screen and (max-width: 900px) {
    .velin-faqg {
      padding: 40px 20px !important;
    }
    .velin-faqg__grid {
      grid-template-columns: 1fr !important;
    }
    .velin-faqg__question {
      font-size: 14px !important;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".velin-faqg").forEach(function (section) {
      section.querySelectorAll("[data-faqg-toggle]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var item = btn.closest(".velin-faqg__item");
          var answer = item.querySelector("[data-faqg-answer]");
          var isOpen = item.classList.contains("is-open");

          item.classList.toggle("is-open");
          answer.style.maxHeight = isOpen ? null : answer.scrollHeight + "px";
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Velin FAQ Grid",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F7F7F7" },
    { "type": "range", "id": "padding_v", "label": "Padding top/bottom (px)", "min": 0, "max": 150, "step": 5, "default": 100 },
    { "type": "range", "id": "padding_h", "label": "Padding left/right (px)", "min": 0, "max": 150, "step": 5, "default": 100 },
    { "type": "range", "id": "row_gap", "label": "Gap heading to grid (px)", "min": 0, "max": 80, "step": 2, "default": 40 },
    { "type": "range", "id": "grid_gap", "label": "Gap between cards (px)", "min": 0, "max": 40, "step": 1, "default": 19 },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading text", "default": "Questions Fréquentes" },
    { "type": "range", "id": "heading_size", "label": "Heading size (px)", "min": 20, "max": 60, "step": 1, "default": 40 },
    { "type": "header", "content": "Cards" },
    { "type": "range", "id": "card_padding_v", "label": "Card padding top/bottom (px)", "min": 10, "max": 60, "step": 1, "default": 40 },
    { "type": "range", "id": "card_padding_h", "label": "Card padding left/right (px)", "min": 10, "max": 60, "step": 1, "default": 20 },
    { "type": "range", "id": "question_size", "label": "Question text size (px)", "min": 12, "max": 30, "step": 1, "default": 20 },
{
  "type": "select",
  "id": "question_weight",
  "label": "Question text weight",
  "options": [
    { "value": "400", "label": "Regular" },
    { "value": "500", "label": "Medium" },
    { "value": "600", "label": "Semi Bold" },
    { "value": "700", "label": "Bold" }
  ],
  "default": "600"
}
  ],
  "blocks": [
    {
      "type": "faq_grid_item",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Cuir Premium" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Notre cuir est sélectionné avec soin pour sa qualité et sa durabilité." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Velin FAQ Grid",
      "blocks": [
        { "type": "faq_grid_item", "settings": { "question": "Cuir Premium" } },
        { "type": "faq_grid_item", "settings": { "question": "Le sac peut-il  mes essentiels du quotidien ?" } },
        { "type": "faq_grid_item", "settings": { "question": "De quelle matière le sac est-il fabriqué ?" } },
        { "type": "faq_grid_item", "settings": { "question": "Comment nettoyer et entretenir le sac ?" } },
        { "type": "faq_grid_item", "settings": { "question": "Adapté à un usage quotidien ?" } },
        { "type": "faq_grid_item", "settings": { "question": "Différents coloris ?" } }
      ]
    }
  ]
}
{% endschema %}