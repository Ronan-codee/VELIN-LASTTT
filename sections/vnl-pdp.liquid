{%- comment -%}
  Velin — fiche produit « veilleuse ». Structure inspirée d'un funnel à packs (galerie, promesse, packs 1/2/3, accordéons), copy Velin.
  Reprend le style des fiches oreiller (lpn-head) sans modifier leurs fichiers.
  Packs = quantités : le panier reçoit N lignes de vraies variantes. Les prix des lots doivent être identiques aux remises
  automatiques Shopify (quantité minimale 2 / 3) ; ceux saisis ici servent uniquement à l'affichage.
  Si le produit a plusieurs variantes (ex. coloris), chaque unité du pack a son menu de choix.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign slide_blocks = section.blocks | where: 'type', 'slide' -%}
{%- assign clip_blocks = section.blocks | where: 'type', 'clip' -%}
{%- assign info_blocks = section.blocks | where: 'type', 'info' -%}
{%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
{%- assign unit = product.price -%}
{%- assign multi = true -%}
{%- if product.has_only_default_variant -%}{%- assign multi = false -%}{%- endif -%}

{% render 'lpn-head' %}
<style>
  .vnl .vnl-tagline{margin:6px 0 0;font-size:13px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  .vnl .vnl-promise{display:grid;gap:8px;margin:18px 0 6px;padding:14px 16px;border-radius:var(--r);background:var(--ice)}
  .vnl .vnl-promise li{display:flex;gap:10px;align-items:center;font-size:14.5px;font-weight:600}
  .vnl .vnl-promise li::before{content:"✓";flex:none;width:20px;height:20px;border-radius:50%;display:grid;place-items:center;background:var(--yellow);color:var(--navy);font-size:12px;font-weight:800}
  .vnl .vnl-sold{margin:10px 0 0;font-size:13.5px;font-weight:700;color:var(--navy)}
  .vnl .vnl-acc-text{white-space:normal}
  .vnl .vnl-clips{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;margin:16px 0 4px}
  .vnl .vnl-clips::-webkit-scrollbar{display:none}
  .vnl .vnl-clip{position:relative;flex:0 0 calc(33.333% - 7px);min-width:110px;aspect-ratio:9/14;border-radius:var(--r);overflow:hidden;background:#E8EAF3;scroll-snap-align:start}
  .vnl .vnl-clip video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
</style>

<div class="lpn vnl" id="lpn-{{ section.id }}">
<div class="lpn-buy">
  <div class="lpn-wrap">
    <div class="lpn-gallery">
      <div class="lpn-stagewrap">
        <button type="button" class="lpn-arrow prev" aria-label="Image précédente"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
        <div class="lpn-stage" data-stage>
          {%- assign block_has_img = false -%}
          {%- for b in slide_blocks -%}{%- if b.settings.image != blank -%}{%- assign block_has_img = true -%}{%- endif -%}{%- endfor -%}
          {%- if block_has_img -%}
            {%- for b in slide_blocks -%}
              {%- if b.settings.image != blank -%}<div class="lpn-slide" {{ b.shopify_attributes }}>{% render 'lpn-media', image: b.settings.image, label: 'Image galerie', width: 1000, first: forloop.first %}</div>{%- endif -%}
            {%- endfor -%}
          {%- elsif product.media.size > 0 -%}
            {%- for m in product.media -%}
              {%- if m.media_type == 'image' -%}
                <div class="lpn-slide">{% render 'lpn-media', image: m, label: m.alt, alt: m.alt, width: 1000, first: forloop.first %}</div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- assign mock_labels = "Veilleuse allumée, tenue en main · 1:1|Démo des ambiances lumineuses · 1:1|Chambre d'enfant, lumière douce · 1:1|Sur la table de nuit, avec télécommande · 1:1|Deux veilleuses, chambre de fratrie · 1:1|Récapitulatif des fonctions · 1:1" | split: '|' -%}
            {%- for l in mock_labels -%}
              <div class="lpn-slide">{% render 'lpn-media', image: nil, label: l, width: 1000 %}</div>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <button type="button" class="lpn-arrow next" aria-label="Image suivante"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
      </div>
      <div class="lpn-thumbs" data-thumbs></div>
    </div>

    <div class="lpn-info">
      {% render 'lpn-note', product: product, app_blocks: app_blocks %}
      <h1>{{ s.title }}</h1>
      {%- if s.tagline != blank -%}<p class="vnl-tagline">{{ s.tagline }}</p>{%- endif -%}
      {%- if s.subtitle != blank -%}<p class="lpn-sub">{{ s.subtitle }}</p>{%- endif -%}

      <ul class="vnl-promise">
        {%- if s.promise_1 != blank -%}<li>{{ s.promise_1 }}</li>{%- endif -%}
        {%- if s.promise_2 != blank -%}<li>{{ s.promise_2 }}</li>{%- endif -%}
        {%- if s.promise_3 != blank -%}<li>{{ s.promise_3 }}</li>{%- endif -%}
      </ul>

      {%- assign clip_any = false -%}
      {%- for b in clip_blocks -%}{%- if b.settings.video != blank -%}{%- assign clip_any = true -%}{%- endif -%}{%- endfor -%}
      {%- if clip_any or request.design_mode and clip_blocks.size > 0 -%}
      <div class="vnl-clips">
        {%- for b in clip_blocks -%}
          <div class="vnl-clip" {{ b.shopify_attributes }}>
            {%- if b.settings.video != blank -%}
              {{ b.settings.video | video_tag: image_size: '400x', autoplay: true, muted: true, loop: true, playsinline: true, controls: false, preload: 'none' }}
            {%- else -%}
              <div class="lpn-mock"><span>Vidéo courte · 9:14</span></div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- endif -%}

      <div id="acheter" style="scroll-margin-top:96px"></div>
      <div class="lpn-eyebrow">{{ s.packs_eyebrow }}</div>
      <h3 class="lpn-packs-title">{{ s.packs_title }}</h3>

      <div class="lpn-packs" role="radiogroup" aria-label="{{ s.packs_title | escape }}">
        {%- for n in (1..3) -%}
          {%- assign total = unit | times: n -%}
          {%- assign price = total -%}
          {%- if n == 2 and s.pack2_price != blank -%}{%- assign price = s.pack2_price | replace: ',', '.' | times: 100 | round -%}{%- endif -%}
          {%- if n == 3 and s.pack3_price != blank -%}{%- assign price = s.pack3_price | replace: ',', '.' | times: 100 | round -%}{%- endif -%}
          {%- case n -%}
            {%- when 1 -%}{%- assign p_name = s.pack1_name -%}{%- assign p_sub = s.pack1_sub -%}
            {%- when 2 -%}{%- assign p_name = s.pack2_name -%}{%- assign p_sub = s.pack2_sub -%}
            {%- when 3 -%}{%- assign p_name = s.pack3_name -%}{%- assign p_sub = s.pack3_sub -%}
          {%- endcase -%}
          <div class="lpn-pack{% if n == 2 %} is-active{% endif %}" data-n="{{ n }}" data-price="{{ price | money }}">
            <span class="lpn-tag">{{ n }} {% if n > 1 %}{{ s.unit_plural }}{% else %}{{ s.unit_singular }}{% endif %}</span>
            {%- if n == 2 and s.pack2_badge != blank -%}<span class="lpn-badge">{{ s.pack2_badge }}</span>{%- elsif n == 3 and s.pack3_badge != blank -%}<span class="lpn-badge">{{ s.pack3_badge }}</span>{%- endif -%}
            <label class="lpn-pack-head">
              <input type="radio" name="lpn-pack-{{ section.id }}" value="{{ n }}"{% if n == 2 %} checked{% endif %}>
              <span class="lpn-radio" aria-hidden="true"></span>
              <span class="lpn-stack" aria-hidden="true">{%- assign pack_img = s.pack_img | default: product.featured_image -%}{% for i in (1..n) %}<span class="lpn-mini">{% if pack_img %}<img src="{{ pack_img | image_url: width: 120 }}" alt="" width="44" height="44" loading="lazy">{% endif %}</span>{% endfor %}</span>
              <span class="lpn-pack-id">
                <b>{{ p_name }}</b>{%- if p_sub != blank -%}<small>{{ p_sub }}</small>{%- endif -%}
                {%- if n > 1 -%}<em>soit {{ price | times: 1.0 | divided_by: n | round | money }} l'unité</em>{%- endif -%}
              </span>
              <span class="lpn-pack-price">{{ price | money }}{% if price < total %}<s>{{ total | money }}</s>{% endif %}</span>
            </label>
            <div class="lpn-pack-body">
              {%- if s.klarna_on -%}
              <p class="lpn-klarna">ou <strong>3 × {{ price | divided_by: 3.0 | round | money }}</strong> sans frais avec <em>Klarna</em></p>
              {%- endif -%}
              <p class="lpn-stock" data-stock hidden></p>
              {%- if multi -%}
              <span class="lpn-label">{% if n > 1 %}{{ s.variant_label_multi }}{% else %}{{ s.variant_label }}{% endif %}</span>
              <div class="lpn-selects">
                {%- for i in (1..n) -%}
                  <label class="lpn-select">{% if n > 1 %}<span>{{ i }}</span>{% endif %}
                    <select data-variant-select aria-label="{{ s.variant_label | escape }} {{ i }}">
                      {%- for v in product.variants -%}<option value="{{ v.id }}"{% unless v.available %} disabled{% endunless %}>{{ v.title }}{% unless v.available %} (épuisé){% endunless %}</option>{%- endfor -%}
                    </select>
                  </label>
                {%- endfor -%}
              </div>
              {%- endif -%}
              {%- if n == 1 and s.pack1_tip != blank -%}<p class="lpn-tip">{{ s.pack1_tip }}</p>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="lpn-cta">
        {%- if s.ship_banner != blank -%}
        <div class="lpn-ship"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>{{ s.ship_banner }}</div>
        {%- endif -%}
        <button type="button" class="lpn-btn lpn-btn--stack" data-atc><span>Ajouter au panier</span><span class="lpn-btn-p" data-atc-price>{{ unit | money }}</span></button>
      </div>
      {%- if s.sold_line != blank -%}<p class="vnl-sold">{{ s.sold_line }}</p>{%- endif -%}

      {%- if s.trial_title != blank -%}
      <div class="lpn-card lpn-card--cream" style="margin-top:18px">
        <span class="ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg></span>
        <div><b>{{ s.trial_title }}</b>{%- if s.trial_text != blank -%}<p>{{ s.trial_text }}</p>{%- endif -%}</div>
      </div>
      {%- endif -%}

      <p class="lpn-secure"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Paiement 100 % sécurisé</p>
      <div class="lpn-pay">{%- for type in shop.enabled_payment_types -%}{%- unless type == 'american_express' -%}{{ type | payment_type_svg_tag }}{%- endunless -%}{%- endfor -%}</div>

      <div class="lpn-acc">
        {%- for b in info_blocks -%}
        <details {{ b.shopify_attributes }}><summary>{{ b.settings.title }}</summary><div class="vnl-acc-text">{{ b.settings.text }}</div></details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<div class="lpn-sticky" data-sticky>
  <div class="info"><span class="th"></span><div><b>{{ product.title }}</b><span class="sub" data-sticky-sub>1 {{ s.unit_singular }}</span></div></div>
  <button type="button" class="lpn-btn lpn-btn--stack" data-atc-sticky><span>Ajouter au panier</span><span class="lpn-btn-p" data-sticky-price>{{ unit | money }}</span></button>
</div>
<div class="lpn-sticky-m" data-sticky-m><a class="lpn-btn lpn-btn--yellow" href="#acheter">{{ s.sticky_mobile }}</a></div>

<script type="application/json" id="vnl-data-{{ section.id }}">{"default":{{ product.selected_or_first_available_variant.id | default: 0 }},"variants":[{% for v in product.variants %}{"id":{{ v.id }},"title":{{ v.title | json }},"a":{{ v.available }},"q":{% if v.inventory_management != blank and v.inventory_policy != 'continue' %}{{ v.inventory_quantity | at_least: 0 }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]}</script>
<script>
(function () {
  var root = document.getElementById('lpn-{{ section.id }}');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';
  var data = JSON.parse(document.getElementById('vnl-data-{{ section.id }}').textContent);
  var UNIT = {{ s.unit_singular | json }}, UNITS = {{ s.unit_plural | json }}, LOW = 10;
  var $ = function (q, c) { return (c || root).querySelector(q); };
  var $$ = function (q, c) { return [].slice.call((c || root).querySelectorAll(q)); };
  function byId(id) { return data.variants.filter(function (v) { return v.id === id; })[0]; }

  /* Galerie */
  var stage = $('[data-stage]'), slides = $$('.lpn-slide', stage), thumbs = $('[data-thumbs]'), cur = 0;
  function mark() { $$('.lpn-thumb', thumbs).forEach(function (t, k) { t.classList.toggle('is-active', k === cur); }); }
  function go(i) { if (!slides.length) return; cur = Math.max(0, Math.min(slides.length - 1, i)); stage.scrollTo({ left: slides[cur].offsetLeft, behavior: 'smooth' }); mark(); }
  slides.forEach(function (sl, i) {
    var b = document.createElement('button'); b.type = 'button'; b.className = 'lpn-thumb';
    b.setAttribute('aria-label', 'Voir l’image ' + (i + 1)); b.innerHTML = sl.innerHTML;
    $$('img', b).forEach(function (im) { im.loading = 'lazy'; im.removeAttribute('fetchpriority'); im.sizes = '70px'; });
    b.addEventListener('click', function () { go(i); }); thumbs.appendChild(b);
  });
  mark();
  $('.lpn-arrow.prev').addEventListener('click', function () { go(cur - 1); });
  $('.lpn-arrow.next').addEventListener('click', function () { go(cur + 1); });
  stage.addEventListener('scroll', function () {
    if (!slides.length) return;
    var w = slides[0].offsetWidth + (parseFloat(getComputedStyle(stage).columnGap) || 0);
    var i = Math.round(stage.scrollLeft / w); if (i !== cur) { cur = i; mark(); }
  }, { passive: true });

  /* Packs */
  var packs = $$('.lpn-pack'), active = $('.lpn-pack.is-active') || packs[0], cta = $('.lpn-cta');
  var atc = $('[data-atc]'), atcPrice = $('[data-atc-price]');
  function place() { var b = $('.lpn-pack-body', active); if (cta && b) b.appendChild(cta); }
  function picks() {
    var sel = $$('[data-variant-select]', active);
    if (sel.length) return sel.map(function (x) { return +x.value; });
    var out = []; for (var i = 0; i < +active.dataset.n; i++) out.push(data.default); return out;
  }
  function lines() {
    var q = {}, order = [];
    picks().forEach(function (id) { if (!q[id]) { q[id] = 0; order.push(id); } q[id]++; });
    return order.map(function (id) { return { id: id, quantity: q[id] }; });
  }
  function ok() { return lines().every(function (l) { var v = byId(l.id); return v && v.a && (v.q === null || l.quantity <= v.q); }); }
  function stockMsg() {
    var el = $('[data-stock]', active); if (!el) return;
    var msg = '', alert = false;
    lines().forEach(function (l) {
      var v = byId(l.id); if (!v || msg) return;
      if (!v.a || (v.q !== null && l.quantity > v.q)) { alert = true; msg = v.q > 0 ? 'Il ne reste que ' + v.q + ' en stock. Choisissez un pack plus petit.' : 'Épuisé pour le moment.'; }
      else if (v.q !== null && v.q <= LOW) { msg = 'Plus que ' + v.q + ' en stock'; }
    });
    el.classList.toggle('is-alert', alert);
    el.textContent = '';
    if (msg) { var row = document.createElement('span'); row.className = 'lpn-stock-l'; row.appendChild(document.createElement('i')); row.appendChild(document.createTextNode(msg)); el.appendChild(row); }
    el.hidden = !msg;
  }
  function sync() {
    var n = +active.dataset.n, names = $$('[data-variant-select]', active).map(function (x) { return byId(+x.value).title; });
    atcPrice.textContent = active.dataset.price;
    $('[data-sticky-price]').textContent = active.dataset.price;
    $('[data-sticky-sub]').textContent = n + ' ' + (n > 1 ? UNITS : UNIT) + (names.length ? ' · ' + names.join(' + ') : '');
    stockMsg();
    atc.disabled = !ok();
  }
  function setActive(p) {
    var first = $('[data-variant-select]', active), firstVal = first && first.value;
    packs.forEach(function (x) { x.classList.toggle('is-active', x === p); });
    active = p; active.querySelector('input').checked = true; place();
    var f = $('[data-variant-select]', active); if (f && firstVal) f.value = firstVal;
    sync();
  }
  packs.forEach(function (p) {
    p.querySelector('input').addEventListener('change', function () { setActive(p); });
    $$('[data-variant-select]', p).forEach(function (x) { x.addEventListener('change', sync); });
  });
  place(); sync();

  /* Ajout au panier : le thème ouvre le tiroir panier via son hook sur fetch('/cart/add') */
  function add(btn) {
    if (!ok()) return;
    btn.classList.add('is-loading');
    fetch('/cart/add.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: lines() })
    }).then(function (r) { return r.json().then(function (d) { if (!r.ok) throw d; return d; }); })
      .then(function () { var e = $('.lpn-add-err'); if (e) e.remove(); if (!window.VelinCartDrawer) window.location.href = '/cart'; })
      .catch(function (err) {
        var m = $('.lpn-add-err');
        if (!m) { m = document.createElement('p'); m.className = 'lpn-add-err'; m.style.cssText = 'margin:8px 0 0;font-size:13px;font-weight:700;color:#B3261E'; cta.appendChild(m); }
        m.textContent = (err && err.description) || "Impossible d'ajouter au panier pour le moment. Réessayez ou écrivez-nous.";
      })
      .then(function () { btn.classList.remove('is-loading'); });
  }
  atc.addEventListener('click', function () { add(atc); });
  $('[data-atc-sticky]').addEventListener('click', function () { add($('[data-atc-sticky]')); });

  /* Barres sticky : visibles quand le bouton d'ajout est hors écran, une fois la zone d'achat dépassée */
  var st = $('[data-sticky]'), stm = $('[data-sticky-m]');
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        var show = !e.isIntersecting && e.boundingClientRect.top < 0;
        st.classList.toggle('show', show); stm.classList.toggle('show', show);
      });
    }).observe(atc);
  }
})();
</script>
</div>

{% schema %}
{
  "name": "Velin · Fiche veilleuse",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Titre" },
    { "type": "text", "id": "title", "label": "Titre (H1)", "default": "La veilleuse qui apaise le coucher" },
    { "type": "text", "id": "tagline", "label": "Ligne fonctions", "default": "Lumière douce · sons apaisants · minuteur" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Une lumière tamisée et un fond sonore régulier pour transformer le coucher en rituel calme, dans sa chambre comme en vacances." },
    { "type": "header", "content": "Promesses (3 lignes, vide = masquée)" },
    { "type": "text", "id": "promise_1", "label": "Ligne 1", "default": "Sans fil et rechargeable : elle le suit partout" },
    { "type": "text", "id": "promise_2", "label": "Ligne 2", "default": "Essayez-la 30 nuits, satisfait ou remboursé" },
    { "type": "text", "id": "promise_3", "label": "Ligne 3", "default": "Expédiée de France sous 24 h" },
    { "type": "header", "content": "Packs" },
    { "type": "text", "id": "packs_eyebrow", "label": "Petit titre", "default": "Économisez avec les packs" },
    { "type": "text", "id": "packs_title", "label": "Titre", "default": "Choisissez votre pack" },
    { "type": "text", "id": "unit_singular", "label": "Unité (singulier)", "default": "veilleuse" },
    { "type": "text", "id": "unit_plural", "label": "Unité (pluriel)", "default": "veilleuses" },
    { "type": "image_picker", "id": "pack_img", "label": "Vignette des packs (carrée)", "info": "Vide = image principale du produit." },
    { "type": "text", "id": "pack1_name", "label": "Pack 1 · nom", "default": "Pour sa chambre" },
    { "type": "text", "id": "pack1_sub", "label": "Pack 1 · détail", "default": "pour un enfant" },
    { "type": "text", "id": "pack1_tip", "label": "Pack 1 · conseil (vide = masqué)", "default": "💡 Beaucoup de parents en prennent une deuxième pour les nuits chez les grands-parents." },
    { "type": "text", "id": "pack2_name", "label": "Pack 2 · nom", "default": "Le duo" },
    { "type": "text", "id": "pack2_sub", "label": "Pack 2 · détail", "default": "une par chambre, ou une pour les vacances" },
    { "type": "text", "id": "pack2_badge", "label": "Pack 2 · badge", "default": "⭐ Notre conseil" },
    { "type": "text", "id": "pack2_price", "label": "Prix du lot de 2 (ex. 99,90)", "info": "Identique à la remise automatique Shopify. Vide = 2 × prix unitaire." },
    { "type": "text", "id": "pack3_name", "label": "Pack 3 · nom", "default": "La fratrie" },
    { "type": "text", "id": "pack3_sub", "label": "Pack 3 · détail", "default": "une par enfant, ou à offrir" },
