    "faq": {
      "type": "vnl-faq",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "q": "Dès quel âge peut-on l'utiliser ?",
            "a": "Dès la naissance, comme veilleuse et fond sonore. Placez-la hors de portée, à environ 2 m du lit, jamais dans le lit. Ce n'est pas un jouet."
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "q": "Où la placer et à quel volume ?",
            "a": "Sur une commode ou une étagère, à environ 2 m du lit. Gardez un volume bas, proche d'une pluie fine. Programmez le minuteur pour couper le son après l'endormissement."
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "q": "Combien de temps tient la batterie ?",
            "a": "De 4 à 12 heures selon la luminosité et le volume. Elle se recharge en moins d'une heure en USB-C et peut rester branchée."
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "q": "Combien de couleurs ?",
            "a": "18 couleurs, dont un mode rouge pour la nuit, en lumière fixe, animée ou en dégradé."
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "q": "Peut-on l'utiliser sans le son ?",
            "a": "Oui. Lumière seule, son seul, ou les deux."
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "q": "La lumière fatigue-t-elle les yeux ?",
            "a": "Les LED sont sans scintillement et la luminosité descend très bas. En mode rouge, elle éclaire juste assez pour voir."
          }
        },
        "faq_7": {
          "type": "faq",
          "settings": {
            "q": "Résiste-t-elle à l'eau ?",
            "a": "Non. Elle supporte l'humidité d'une salle de bain mais ne doit pas être mouillée."
          }
        },
        "faq_8": {
          "type": "faq",
          "settings": {
            "q": "Va-t-il mieux dormir ?",
            "a": "On ne promet pas de miracle : chaque enfant est différent. Ce qu'elle apporte, c'est un rituel identique chaque soir, une lumière douce et un fond sonore qui masque les bruits de la maison. Si elle ne change rien chez vous, vous avez 30 nuits pour être remboursé."
          }
        },
        "faq_9": {
          "type": "faq",
          "settings": {
            "q": "Quand vais-je recevoir ma commande ?",
            "a": "Expédiée sous 24 h ouvrées, livrée en 5 à 9 jours ouvrés. Vous recevez le numéro de suivi par e-mail."
          }
        },
        "faq_10": {
          "type": "faq",
          "settings": {
            "q": "Et si elle ne nous convient pas ?",
            "a": "Écrivez-nous dans les 30 nuits suivant la réception, nous vous remboursons."
          }
        }
      },
