    "faq": {
      "type": "vnl-faq",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "q": "Dès quel âge peut-on l'utiliser ?",
            "a": "Dès la naissance, comme veilleuse. Posez-la hors de portée de l'enfant, jamais dans le lit ni le berceau, et ne la laissez pas entre ses mains sans surveillance."
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "q": "Où la placer et à quel volume ?",
            "a": "À distance du lit, idéalement à 2 mètres, avec un volume bas : le son doit couvrir les bruits de la maison, pas les dépasser. Le minuteur l'éteint une fois qu'il dort."
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "q": "Combien de temps tient la batterie ?",
            "a": "De 4 à 12 heures selon la luminosité et le volume (environ 4 heures au maximum). Elle se recharge en moins d'une heure et peut rester branchée : la charge s'arrête seule quand la batterie est pleine."
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "q": "Combien de couleurs ?",
            "a": "18 couleurs, dont un mode lumière rouge, plus des modes animés. Vous pouvez associer n'importe quelle couleur à n'importe quel son."
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "q": "Peut-on l'utiliser sans le son ?",
            "a": "Oui. Par défaut, elle s'allume en lumière seule. Le bruit blanc ou le Bluetooth s'activent seulement si vous le souhaitez."
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "q": "La lumière fatigue-t-elle les yeux ?",
            "a": "Les LED ne scintillent pas et la luminosité descend jusqu'à une lueur très faible, pensée pour la nuit."
          }
        },
        "faq_7": {
          "type": "faq",
          "settings": {
            "q": "Résiste-t-elle à l'eau ?",
            "a": "Non, elle n'est pas étanche. Elle supporte la vapeur d'une salle de bain, posée débranchée sur une surface sèche, loin des éclaboussures."
          }
        },
        "faq_8": {
          "type": "faq",
          "settings": {
            "q": "Va-t-il mieux dormir ?",
            "a": "On ne peut pas le promettre : chaque enfant est différent. La veilleuse aide à installer un rituel calme et régulier. Si ses nuits vous inquiètent, parlez-en à votre pédiatre."
          }
        },
        "faq_9": {
          "type": "faq",
          "settings": {
            "q": "Quand vais-je recevoir ma commande ?",
            "a": "Expédiée sous 24 h ouvrées depuis la France, livrée en 72 h ouvrées en France métropolitaine. Vous recevez un numéro de suivi dès le départ du colis."
          }
        },
        "faq_10": {
          "type": "faq",
          "settings": {
            "q": "Et si elle ne nous convient pas ?",
            "a": "Vous avez 30 nuits pour l'essayer. Écrivez-nous et nous vous remboursons."
          }
        }
      },
