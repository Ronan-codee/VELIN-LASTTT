{%- style -%}
  #Banner-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.banner_height_desktop }}px;
    display: flex;
    align-items: center;
    background-image: url('{{ section.settings.image | image_url: width: 2000 }}');
    background-size: cover;
    background-position: center;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} {
      min-height: {{ section.settings.banner_height_mobile }}px;
    }
  }

  .banner__content-custom {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: {% if section.settings.text_position == 'left' %}flex-start{% elsif section.settings.text_position == 'center' %}center{% else %}flex-end{% endif %};
  }

  .banner__box-custom {
    max-width: {{ section.settings.box_max_width }}px;
    text-align: {{ section.settings.text_alignment }};
    color: {{ section.settings.text_color }};
  }

  .banner__heading-custom {
    font-size: {{ section.settings.title_font_size }}px;
    line-height: 1.2;
    margin: 0 0 {{ section.settings.gap_below_title }}px 0;
    color: {{ section.settings.text_color }};
  }

  .banner__text-custom {
    font-size: 16px;
    line-height: 1.6;
    margin-top: {{ section.settings.gap_subheading }}px;
    color: {{ section.settings.text_color }};
  }
{%- endstyle -%}

<div id="Banner-{{ section.id }}" class="about-hero-banner">
  <div class="banner__content-custom">
    <div class="banner__box-custom">
      {%- if section.settings.heading != blank -%}
        <h2 class="banner__heading-custom">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="banner__text-custom">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Layout Controls"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text Box Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "box_max_width",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Text Box Max Width",
      "default": 550
    },
    {
      "type": "header",
      "content": "Spacing & Heights (Figma Control Sliders)"
    },
    {
      "type": "range",
      "id": "banner_height_desktop",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Banner Height (Desktop)",
      "default": 700
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Banner Height (Mobile)",
      "default": 450
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding Top (Gap from Header)",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 50
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Title Font Size",
      "default": 66
    },
    {
      "type": "range",
      "id": "gap_subheading",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap below Subheading",
      "default": 40
    },
    {
      "type": "range",
      "id": "gap_below_title",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap below Title",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NOUS CROYONS QUE NOUS POUVONS TOUS FAIRE LA DIFFÉRENCE."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subheading Text",
      "default": "Qualité exceptionnelle, ateliers éthiques, transparence radicale."
    }
  ],
  "presets": [
    {
      "name": "About Hero Banner"
    }
  ]
}
{% endschema %}