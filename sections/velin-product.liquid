{% comment %} Velin - Product Page (Figma: 1445 container, 612 media / 611 info, 122px gap) {% endcomment %}

{%- liquid
  assign color_option_index = -1
  for option in product.options_with_values
    assign opt_down = option.name | downcase
    if opt_down == section.settings.color_option_name or opt_down == 'couleur' or opt_down == 'color'
      assign color_option_index = forloop.index0
      assign color_option = option
    endif 
  endfor
  assign map_lines = section.settings.color_map | strip | newline_to_br | split: '<br />'

  assign size_option_index = -1
  for option in product.options_with_values
    assign opt_down = option.name | downcase
    if opt_down == section.settings.size_option_name or opt_down == 'taille' or opt_down == 'size'
      assign size_option_index = forloop.index0
      assign size_option = option
    endif
  endfor


  comment
    Color collection: ONLY the per-product metafield (custom.color_collection)
    decides this. No global fallback — a product with no metafield set shows
    no cross-product color swatches at all, so bags never inherit another
    bag's colors.
  endcomment
  assign color_coll = blank
  if product.metafields.custom.color_collection.value != blank
    assign color_coll = product.metafields.custom.color_collection.value
  endif
-%}

{%- comment -%}
  Per-color thumbnail groups: an image belongs to a color if its ALT TEXT
  matches that color's option value exactly (set alt text when uploading,
  e.g. "Black", "Stone Grey"). Used to swap the whole thumbnail strip when
  a swatch is clicked, not just the single featured image.
{%- endcomment -%}
{%- capture color_media_map -%}
  {
    {%- if color_option_index >= 0 -%}
      {%- for value in color_option.values -%}
        {%- assign color_group = product.images | where: 'alt', value -%}
        {{ value | json }}: [
          {%- for img in color_group -%}
            { "full": {{ img | image_url: width: 1200 | json }}, "thumb": {{ img | image_url: width: 240 | json }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- endif -%}
  }
{%- endcapture -%}

{% render 'header-color-override', style: section.settings.header_style %}
<div class="velin-pdp" id="VelinPDP-{{ section.id }}" style="
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_v }}px {{ section.settings.padding_h }}px;
  gap: {{ section.settings.column_gap }}px;
">

  {%- comment -%} ---------- LEFT: media ---------- {%- endcomment -%}
  <div class="velin-pdp__media" style="width: {{ section.settings.media_width }}px; gap: {{ section.settings.media_gap }}px;">
    <div class="velin-pdp__main-image{% unless product.selected_or_first_available_variant.available %} is-sold-out{% endunless %}" style="height: {{ section.settings.image_height }}px; background: {{ section.settings.image_bg }};">
      {% unless product.selected_or_first_available_variant.available %}
        <span class="velin-pdp__sold-out-badge">{{ 'products.product.sold_out' | t }}</span>
      {% endunless %}
      {% if product.featured_media %}
        <img
          id="VelinPDPMainImg-{{ section.id }}"
          src="{{ product.featured_media | image_url: width: 1200 }}"
          alt="{{ product.featured_media.alt | escape }}"
          loading="eager"
        >
      {% endif %}
      <div class="velin-pdp__main-video" id="VelinPDPMainVideo-{{ section.id }}" hidden></div>
    </div>
    {% if product.media.size > 1 %}
      <div class="velin-pdp__thumbs" style="height: {{ section.settings.thumbs_height }}px; gap: {{ section.settings.thumbs_gap }}px;">
        {% for media in product.media %}
          {%- liquid
            assign thumb_is_video = false
            if media.media_type == 'video' or media.media_type == 'external_video'
              assign thumb_is_video = true
            endif
            if thumb_is_video
              assign thumb_full = media.preview_image | image_url: width: 1200
              assign thumb_small = media.preview_image | image_url: width: 240
            else
              assign thumb_full = media | image_url: width: 1200
              assign thumb_small = media | image_url: width: 240
            endif
          -%}
          <button
            type="button"
            class="velin-pdp__thumb{% if forloop.first %} is-active{% endif %}"
            data-full="{{ thumb_full }}"
            {% if thumb_is_video %}data-video-id="{{ media.id }}"{% endif %}
            aria-label="{% if thumb_is_video %}Vidéo{% else %}Image{% endif %} {{ forloop.index }}"
          >
            <img src="{{ thumb_small }}" alt="{{ media.alt | escape }}" loading="lazy">
            {% if thumb_is_video %}
              <span class="velin-pdp__thumb-play" aria-hidden="true">
                <svg width="8" height="10" viewBox="0 0 10 12" fill="none"><path d="M10 6L0 12V0L10 6Z" fill="#fff"/></svg>
              </span>
            {% endif %}
          </button>
        {% endfor %}
      </div>
    {% endif %}
    <div hidden aria-hidden="true">
      {% for media in product.media %}
        {% if media.media_type == 'video' %}
          <template data-pdp-video-template="{{ media.id }}">
            {{ media | video_tag: image_size: '1200x', autoplay: false, loop: false, controls: true, muted: false, playsinline: true, preload: 'metadata', class: 'velin-pdp__main-video-el' }}
          </template>
        {% elsif media.media_type == 'external_video' %}
          <template data-pdp-video-template="{{ media.id }}">
            {{ media | external_video_tag: autoplay: false, class: 'velin-pdp__main-video-el' }}
          </template>
        {% endif %}
      {% endfor %}
    </div>

    {%- comment -%} ---------- Extra photos grid (desktop only), shown below the main image as the page scrolls ---------- {%- endcomment -%}
    {% if section.settings.show_media_grid and product.media.size > 1 %}
      <div class="velin-pdp__media-grid" style="gap: {{ section.settings.media_gap }}px;">
        {% for media in product.media offset: 1 %}
          {% if media.media_type == 'image' %}
            <img src="{{ media | image_url: width: 1200 }}" alt="{{ media.alt | escape }}" loading="lazy" class="velin-pdp__media-grid-img">
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {%- comment -%} ---------- RIGHT: info ---------- {%- endcomment -%}
  <div class="velin-pdp__info" style="width: {{ section.settings.info_width }}px; gap: {{ section.settings.info_gap }}px;">

    {% if section.settings.badge_text != blank %}
      <div class="velin-pdp__badge" style="background: {{ section.settings.badge_bg }}; font-size: {{ section.settings.badge_size }}px;">
        {{ section.settings.badge_text }}
      </div>
    {% endif %}

    {% if section.settings.social_text != blank %}
      <div class="velin-pdp__social">
        <span class="velin-pdp__avatars">
          {% if section.settings.avatar_1 != blank %}<img src="{{ section.settings.avatar_1 | image_url: width: 56 }}" alt="">{% endif %}
          {% if section.settings.avatar_2 != blank %}<img src="{{ section.settings.avatar_2 | image_url: width: 56 }}" alt="">{% endif %}
          {% if section.settings.avatar_3 != blank %}<img src="{{ section.settings.avatar_3 | image_url: width: 56 }}" alt="">{% endif %}
        </span>
        <svg class="velin-verified-badge" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path fill="#1DA1F2" d="M12 0l2.3 1.6 2.8-.4 1.6 2.3 2.8.8.4 2.8 2.3 1.6-.8 2.8.8 2.8-2.3 1.6-.4 2.8-2.8.8-1.6 2.3-2.8-.4L12 24l-2.3-1.6-2.8.4-1.6-2.3-2.8-.8-.4-2.8L0 15.2l.8-2.8L0 9.6 2.3 8l.4-2.8 2.8-.8L7.1 2l2.8.4L12 0z"/>
          <path d="M8.8 12.3l2.1 2.1 4.6-4.6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="velin-pdp__social-text"><span>+3 000 Clients</span><span>dorment mieux avec Velin</span></span>
      </div>
    {% endif %}

    <div class="velin-pdp__title-price-group">
      <h1 class="velin-pdp__title" style="font-size: {{ section.settings.title_size }}px;">{{ product.title }}</h1>

      <div class="velin-pdp__price-row">
        {% if product.compare_at_price > product.price %}
          <s class="velin-pdp__compare" style="color: {{ section.settings.compare_color }};">{{ product.compare_at_price | money }}</s>
        {% elsif section.settings.compare_text != blank %}
          <s class="velin-pdp__compare" style="color: {{ section.settings.compare_color }};">{{ section.settings.compare_text }}</s>
        {% endif %}
        <span class="velin-pdp__price" id="VelinPDPPrice-{{ section.id }}">{{ product.price | money }}</span>
        <!-- Air reviews star rating -->
        <div class="AirReviews-Widget AirReviews-Widget--Stars"></div>
      </div>

      {% if section.settings.launch_offer_text != blank %}
        {%- liquid
          assign velin_offer_month_num = 'now' | date: '%-m'
          case velin_offer_month_num
            when '1'
              assign velin_offer_month_fr = 'janvier'
            when '2'
              assign velin_offer_month_fr = 'février'
            when '3'
              assign velin_offer_month_fr = 'mars'
            when '4'
              assign velin_offer_month_fr = 'avril'
            when '5'
              assign velin_offer_month_fr = 'mai'
            when '6'
              assign velin_offer_month_fr = 'juin'
            when '7'
              assign velin_offer_month_fr = 'juillet'
            when '8'
              assign velin_offer_month_fr = 'août'
            when '9'
              assign velin_offer_month_fr = 'septembre'
            when '10'
              assign velin_offer_month_fr = 'octobre'
            when '11'
              assign velin_offer_month_fr = 'novembre'
            when '12'
              assign velin_offer_month_fr = 'décembre'
          endcase
          assign velin_offer_day = 'now' | date: '%-d'
        -%}
        <p class="velin-pdp__launch-badge" style="background: {{ section.settings.launch_offer_bg }}; color: {{ section.settings.launch_offer_color }};">
          {{ section.settings.launch_offer_text }} {{ velin_offer_day }} {{ velin_offer_month_fr }}
        </p>
      {% endif %}
    </div>

    {% if section.settings.show_installments %}
      {%- liquid
        assign velin_installment_count = section.settings.installment_count | default: 3
        assign velin_installment_amount = product.price | times: 1.0 | divided_by: velin_installment_count
        assign velin_klarna_h = section.settings.payment_icon_size | default: 24
        assign velin_klarna_w = velin_klarna_h | times: 64 | divided_by: 27.0 | round
      -%}
      <div class="velin-pdp__installments">
        <span class="velin-pdp__installments-text">Ou {{ velin_installment_count }}x sans frais de <span id="VelinPDPInstallment-{{ section.id }}">{{ velin_installment_amount | money }}</span> avec</span>
        <svg class="velin-pdp__klarna" width="{{ velin_klarna_w }}" height="{{ velin_klarna_h }}" viewBox="0 0 64 27" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Klarna">
          <rect width="64" height="27" rx="6" fill="#FFB3C7"></rect>
          <text x="32" y="18.5" text-anchor="middle" font-family="Helvetica Neue, Arial, sans-serif" font-weight="700" font-size="13" fill="#17120F">Klarna</text>
        </svg>
      </div>
    {% endif %}

    {%- assign has_chips = false -%}
    {% for block in section.blocks %}{% if block.type == 'chip' %}{% assign has_chips = true %}{% endif %}{% endfor %}
    {% if has_chips %}
      <div class="velin-pdp__chips" style="gap: {{ section.settings.chip_gap }}px;">
        {% for block in section.blocks %}
          {% if block.type == 'chip' %}
            {%- assign chip_state = block.settings.state | default: 'positive' -%}
            <div class="velin-pdp__chip velin-pdp__chip--{{ chip_state }}" style="font-size: {{ section.settings.chip_size }}px;" {{ block.shopify_attributes }}>
              <span class="velin-pdp__chip-icon">
                {% if chip_state == 'negative' %}
                  <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="12" fill="#E7E9F6"/><path d="M7 12h10" stroke="#4A4E78" stroke-width="2" stroke-linecap="round"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="12" fill="#DCEFE1"/><path d="M12 7v10M7 12h10" stroke="#1F6D3B" stroke-width="2" stroke-linecap="round"/></svg>
                {% endif %}
              </span>
              <span class="velin-pdp__chip-text">{{ block.settings.text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {%- assign has_included_gifts = false -%}
    {% for block in section.blocks %}{% if block.type == 'included_gift' %}{% assign has_included_gifts = true %}{% endif %}{% endfor %}
    {% if has_included_gifts %}
      <div class="velin-pdp__included-gifts">
        {% for block in section.blocks %}
          {% if block.type == 'included_gift' %}
            <div class="velin-pdp__included-gift" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="velin-pdp__included-gift-img">
              {% endif %}
              <div class="velin-pdp__included-gift-text">
                <p class="velin-pdp__included-gift-title">
                  {{ block.settings.title }}
                  <span class="velin-pdp__included-gift-tag">{{ block.settings.tag_text }}</span>
                </p>
                {% if block.settings.text != blank %}
                  <p class="velin-pdp__included-gift-desc">{{ block.settings.text }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if color_coll != blank %}
      {%- comment -%} Colors from a collection: same bag as separate products, one per color {%- endcomment -%}
      <div class="velin-pdp__colors">
        <p class="velin-pdp__colors-label">{{ section.settings.color_label }}</p>
        <div class="velin-pdp__swatches">
          {% for p in color_coll.products %}
            {%- assign p_color = '' -%}
            {%- for opt in p.options_with_values -%}
              {%- assign od = opt.name | downcase -%}
              {%- if od == section.settings.color_option_name or od == 'couleur' or od == 'color' -%}
                {%- assign p_color = opt.values | first -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if p_color == '' -%}{%- assign p_color = p.title -%}{%- endif -%}
            {%- assign swatch_hex = '' -%}
            {%- for line in map_lines -%}
              {%- assign pair = line | strip | split: ':' -%}
              {%- assign pair_name = pair[0] | strip | downcase -%}
              {%- assign val_down = p_color | downcase -%}
              {%- if pair_name == val_down -%}{%- assign swatch_hex = pair[1] | strip -%}{%- endif -%}
            {%- endfor -%}
            {%- if swatch_hex == '' -%}{%- assign swatch_hex = '#cccccc' -%}{%- endif -%}
            <a
              href="{{ p.url }}"
              class="velin-pdp__swatch{% if p.id == product.id %} is-active{% endif %}"
              data-color-value="{{ p_color | escape }}"
              style="background: {{ swatch_hex }};"
              aria-label="{{ p_color | escape }}"
              title="{{ p_color | escape }}"
            ></a>
          {% endfor %}
        </div>
      </div>
    {% elsif color_option_index >= 0 %}
      <div class="velin-pdp__colors">
        <p class="velin-pdp__colors-label">{{ section.settings.color_label }}</p>
        <div class="velin-pdp__swatches">
          {% for value in color_option.values %}
            {%- assign swatch_hex = '' -%}
            {%- for line in map_lines -%}
              {%- assign pair = line | strip | split: ':' -%}
              {%- assign pair_name = pair[0] | strip | downcase -%}
              {%- assign val_down = value | downcase -%}
              {%- if pair_name == val_down -%}{%- assign swatch_hex = pair[1] | strip -%}{%- endif -%}
            {%- endfor -%}
            {%- if swatch_hex == '' -%}{%- assign swatch_hex = '#cccccc' -%}{%- endif -%}
            <button
              type="button"
              class="velin-pdp__swatch{% if value == color_option.selected_value %} is-active{% endif %}"
              data-color-value="{{ value | escape }}"
              style="background: {{ swatch_hex }};"
              aria-label="{{ value | escape }}"
            ></button>
          {% endfor %}
        </div>
      </div>
    {% elsif product.metafields.shopify['color-pattern'].value != blank %}
      {%- comment -%} This product's own color(s), tagged directly via Shopify's Category metafields (no sibling products / no variant option) {%- endcomment -%}
      <div class="velin-pdp__colors">
        <p class="velin-pdp__colors-label">{{ section.settings.color_label }}</p>
        <div class="velin-pdp__swatches">
          {% for color_ref in product.metafields.shopify['color-pattern'].value %}
            <span
              class="velin-pdp__swatch is-active"
              style="background: {{ color_ref.color }};"
              aria-label="{{ color_ref.label | escape }}"
              title="{{ color_ref.label | escape }}"
            ></span>
          {% endfor %}
        </div>
      </div>
    {% elsif product.metafields.custom.bag_color.value != blank %}
      {%- comment -%} This product's own color, from the simple "Couleur du sac" text field {%- endcomment -%}
      {%- assign own_color = product.metafields.custom.bag_color.value -%}
      {%- assign own_color_down = own_color | downcase -%}
      {%- assign swatch_hex = '' -%}
      {%- for line in map_lines -%}
        {%- assign pair = line | strip | split: ':' -%}
        {%- assign pair_name = pair[0] | strip | downcase -%}
        {%- if pair_name == own_color_down -%}{%- assign swatch_hex = pair[1] | strip -%}{%- endif -%}
      {%- endfor -%}
      {%- if swatch_hex == '' -%}{%- assign swatch_hex = '#cccccc' -%}{%- endif -%}
      <div class="velin-pdp__colors">
        <p class="velin-pdp__colors-label">{{ section.settings.color_label }}</p>
        <div class="velin-pdp__swatches">
          <span
            class="velin-pdp__swatch is-active"
            style="background: {{ swatch_hex }};"
            aria-label="{{ own_color | escape }}"
            title="{{ own_color | escape }}"
          ></span>
        </div>
      </div>
    {% endif %}

    {%- comment -%} ---------- Offers (1 Sac / 2 Sac) ---------- {%- endcomment -%}
    {%- assign has_offers = false -%}
    {% for block in section.blocks %}{% if block.type == 'offer' %}{% assign has_offers = true %}{% endif %}{% endfor %}
    {% if has_offers and product.type != "Portefeuille" %}
      <div class="velin-pdp__offers">
        {% for block in section.blocks %}
          {% if block.type == 'offer' %}
            <label class="velin-pdp__offer{% if block.settings.preselected %} is-selected{% endif %}" data-offer data-qty="{{ block.settings.quantity }}" {{ block.shopify_attributes }}>
              <input type="radio" name="velin-offer-{{ section.id }}" value="{{ block.settings.quantity }}" {% if block.settings.preselected %}checked{% endif %}>
              <div class="velin-pdp__offer-body">
                <div class="velin-pdp__offer-row">
                  <span class="velin-pdp__offer-title">
                    <span class="velin-pdp__offer-dot" data-offer-dot></span>
                    {{ block.settings.title }}
                    {% if block.settings.badge_text != blank %}
                      <span class="velin-pdp__offer-badge">{{ block.settings.badge_text }}</span>
                    {% endif %}
                  </span>
                  {%- if block.settings.price_text != blank -%}
                    <span class="velin-pdp__offer-price">{{ block.settings.price_text }}</span>
                  {%- else -%}
                    <span class="velin-pdp__offer-price" data-offer-live-price data-offer-qty="{{ block.settings.quantity }}">{{ product.price | times: block.settings.quantity | money }}</span>
                  {%- endif -%}
                </div>
                {% if block.settings.sub_label != blank %}
                  <div class="velin-pdp__offer-sub">
                    <span>{{ block.settings.sub_label }}</span>
                    <s>{{ block.settings.sub_price }}</s>
                  </div>
                {% endif %}
                {% if block.settings.perks != blank %}
                  <ul class="velin-pdp__offer-perks">
                    {% assign perks = block.settings.perks | newline_to_br | split: '<br />' %}
                    {% for perk in perks %}<li>{{ perk }}</li>{% endfor %}
                  </ul>
                {% endif %}
                {% if block.settings.show_variant_picker %}
                  <div class="velin-pdp__variant-picker">
                    {% if color_coll != blank %}
                      <div class="velin-pdp__variant-group">
                        <select data-color-nav id="velin-color-nav-{{ block.id }}" aria-label="{{ section.settings.color_label }}">
                          {% for p in color_coll.products %}
                            {%- assign p_color = '' -%}
                            {%- for opt in p.options_with_values -%}
                              {%- assign od = opt.name | downcase -%}
                              {%- if od == section.settings.color_option_name or od == 'couleur' or od == 'color' -%}
                                {%- assign p_color = opt.values | first -%}
                              {%- endif -%}
                            {%- endfor -%}
                            {%- if p_color == '' -%}{%- assign p_color = p.title -%}{%- endif -%}
                            <option value="{{ p.url }}" {% if p.id == product.id %}selected{% endif %}>{{ p_color }}</option>
                          {% endfor %}
                        </select>
                        <label for="velin-color-nav-{{ block.id }}" class="velin-pdp__variant-label">{{ section.settings.color_label | upcase }}</label>
                      </div>
                    {% elsif color_option_index >= 0 %}
                      <div class="velin-pdp__variant-group">
                        <select data-color-select id="velin-color-select-{{ block.id }}" aria-label="{{ section.settings.color_label }}">
                          {% for value in color_option.values %}
                            <option value="{{ value | escape }}" {% if value == color_option.selected_value %}selected{% endif %}>{{ value }}</option>
                          {% endfor %}
                        </select>
                        <label for="velin-color-select-{{ block.id }}" class="velin-pdp__variant-label">{{ section.settings.color_label | upcase }}</label>
                      </div>
                    {% endif %}
                    {% if size_option_index >= 0 %}
                      <div class="velin-pdp__variant-group">
                        <select data-size-select id="velin-size-select-{{ block.id }}" aria-label="{{ section.settings.size_label }}">
                          {% for value in size_option.values %}
                            <option value="{{ value | escape }}" {% if value == size_option.selected_value %}selected{% endif %}>{{ value }}</option>
                          {% endfor %}
                        </select>
                        <label for="velin-size-select-{{ block.id }}" class="velin-pdp__variant-label">{{ section.settings.size_label | upcase }}</label>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </label>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {%- comment -%} ---------- Revy Bundle (manual embed, from the app's "Embed this bundle manually in any page via HTML" option) ---------- {%- endcomment -%}
    {% if section.settings.revy_bundle_id != blank %}
      <div data-revy-bundle-id="{{ section.settings.revy_bundle_id }}"></div>
    {% endif %}

    {%- comment -%} ---------- Free shipping line ---------- {%- endcomment -%}
    {% unless section.settings.hide_native_purchase %}
    {% if section.settings.show_free_shipping and section.settings.free_shipping_text != blank %}
      <div class="velin-pdp__free-shipping" data-free-shipping>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M2 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7Z" stroke="currentColor" stroke-width="1.6"/>
          <path d="M14 10h3.3a1 1 0 0 1 .8.4l2.4 3.2a1 1 0 0 1 .2.6V16a1 1 0 0 1-1 1H14v-7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          <circle cx="7" cy="18" r="1.6" stroke="currentColor" stroke-width="1.6"/>
          <circle cx="17.5" cy="18" r="1.6" stroke="currentColor" stroke-width="1.6"/>
        </svg>
        <span>{{ section.settings.free_shipping_text }}</span>
      </div>
    {% endif %}

    {%- comment -%} ---------- Add to cart ---------- {%- endcomment -%}
    {%- form 'product', product, id: 'VelinPDPForm' -%}
      <input type="hidden" name="items[0][id]" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>
      <input type="hidden" name="items[0][quantity]" value="1" data-qty-input>
      <button
        type="submit"
        class="velin-pdp__atc"
        style="background: {{ section.settings.atc_bg }}; color: {{ section.settings.atc_color }};{% if section.settings.hide_atc_button %} display: none;{% endif %}"
        data-atc-text="{{ section.settings.atc_text | escape }}"
        data-sold-out-text="{{ 'products.product.sold_out' | t | escape }}"
        {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
      >
        {% if product.selected_or_first_available_variant.available %}{{ section.settings.atc_text }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
      </button>
    {%- endform -%}
    {% endunless %}

    {%- comment -%} ---------- Stock bar ---------- {%- endcomment -%}
    {% if section.settings.show_stock %}
      <div class="velin-pdp__stock">
        <p class="velin-pdp__stock-title">{{ section.settings.stock_title }}</p>
        <p class="velin-pdp__stock-sub">{{ section.settings.stock_sub }}</p>
        <div class="velin-pdp__stock-bar">
          <div class="velin-pdp__stock-fill" style="width: {{ section.settings.sold_percent }}%; background: {{ section.settings.stock_bar_color }};"></div>
        </div>
        <div class="velin-pdp__stock-row">
          <span class="velin-pdp__stock-sold">{{ section.settings.sold_percent }} % {{ section.settings.sold_label }}</span>
          <span>{{ section.settings.countdown_label }} <span data-countdown data-hours="{{ section.settings.countdown_hours }}">--:--:--</span></span>
        </div>
      </div>
    {% endif %}

    {%- comment -%} ---------- Trust strip (3 icons) — used when trust_item_* are set ---------- {%- endcomment -%}
    {% if section.settings.trust_item_1 != blank or section.settings.trust_item_2 != blank or section.settings.trust_item_3 != blank or section.settings.trust_item_4 != blank %}
      <div class="velin-pdp__trust-strip">
        {% if section.settings.trust_item_1 != blank %}
          <div class="velin-pdp__trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"></rect><path d="M3 9.5h18"></path><path d="M8 2.5v4M16 2.5v4"></path><path d="M12 12.8c-1.4-1.4-3.6-1-3.6 1 0 1.6 1.8 2.9 3.6 4.4 1.8-1.5 3.6-2.8 3.6-4.4 0-2-2.2-2.4-3.6-1Z"></path></svg>
            <span>{{ section.settings.trust_item_1 }}</span>
          </div>
        {% endif %}
        {% if section.settings.trust_item_2 != blank %}
          <div class="velin-pdp__trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"></path><path d="M3 8l9 5 9-5"></path><path d="M12 13v8"></path></svg>
            <span>{{ section.settings.trust_item_2 }}</span>
          </div>
        {% endif %}
        {% if section.settings.trust_item_3 != blank %}
          <div class="velin-pdp__trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5"></path><path d="M2 18v2M22 18v2"></path><path d="M4 11V8a2 2 0 0 1 2-2h5a2 2 0 0 1 2 2v3"></path><path d="M13 11V9.5a1.5 1.5 0 0 1 1.5-1.5H18a2 2 0 0 1 2 2v1"></path></svg>
            <span>{{ section.settings.trust_item_3 }}</span>
          </div>
        {% endif %}
        {% if section.settings.trust_item_4 != blank %}
          <div class="velin-pdp__trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            <span>{{ section.settings.trust_item_4 }}</span>
          </div>
        {% endif %}
      </div>
    {% elsif section.settings.guarantee_heading != blank %}
      <div class="velin-pdp__guarantee">
        <div class="velin-pdp__guarantee-head">
          {% if section.settings.guarantee_image != blank %}
            <img src="{{ section.settings.guarantee_image | image_url: width: 80 }}" alt="">
          {% endif %}
          <span>{{ section.settings.guarantee_heading }}</span>
        </div>
        {% if section.settings.guarantee_text != blank %}
          <p>{{ section.settings.guarantee_text }}</p>
        {% endif %}
      </div>
    {% endif %}

    {%- comment -%} ---------- Approved videos ---------- {%- endcomment -%}

{%- assign has_videos = false -%}
{% for block in section.blocks %}
  {% if block.type == 'video_thumb' %}
    {% assign has_videos = true %}
  {% endif %}
{% endfor %}

{% if has_videos %}
  <div class="velin-pdp__approved">

    {% if section.settings.approved_heading != blank %}
      <p class="velin-pdp__approved-heading">
        {{ section.settings.approved_heading }}
      </p>
    {% endif %}

    <div class="velin-pdp__approved-wrap">
  <button type="button" class="velin-pdp__approved-arrow velin-pdp__approved-arrow--prev" data-approved-prev aria-label="Previous">
    <svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M7 1L1 7L7 13" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>

  <div class="velin-pdp__approved-grid" style="gap: {{ section.settings.video_gap }}px;">
{% for block in section.blocks %}
  {% if block.type == 'video_thumb' %}

    <div class="velin-pdp__approved-item" style="width: {{ section.settings.video_card_width }}px; height: {{ section.settings.video_card_height }}px;" {{ block.shopify_attributes }}>

      <div class="velin-video-card" data-lazy-video-card>

        {%- comment -%}
          Lightweight poster shown immediately; the real <video> (with its
          multi-MB source) stays inert inside a <template> — never fetched by
          the browser — until this card is scrolled near the viewport. See
          the IntersectionObserver below.
        {%- endcomment -%}
        <img class="velin-video-poster" src="{{ block.settings.video.preview_image | image_url: width: 400 }}" alt="" loading="lazy">

        <template data-lazy-video-template>
          {{
            block.settings.video
            | video_tag:
            image_size: '400x',
            autoplay: false,
            loop: false,
            controls: false,
            muted: false,
            playsinline: true,
            preload: 'metadata',
            class: 'velin-video'
          }}
        </template>

        <button type="button" class="velin-video-play">
          <svg width="10" height="12" viewBox="0 0 10 12" fill="none">
            <path d="M10 6L0 12V0L10 6Z" fill="#000"/>
          </svg>
        </button>

      </div>

    </div>

  {% endif %}
{% endfor %}

  </div>

  <button type="button" class="velin-pdp__approved-arrow velin-pdp__approved-arrow--next" data-approved-next aria-label="Next">
    <svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M1 1L7 7L1 13" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  </div>

  </div>
{% endif %}

    {%- comment -%} ---------- FAQ ---------- {%- endcomment -%}
    {%- assign has_faq = false -%}
    {% for block in section.blocks %}{% if block.type == 'faq_item' %}{% assign has_faq = true %}{% endif %}{% endfor %}
    {%- assign show_description_faq = false -%}
    {% if section.settings.show_description_faq and product.description != blank %}{% assign show_description_faq = true %}{% endif %}
    {% if has_faq or show_description_faq %}
      <div class="velin-faq{% if section.settings.faq_pill_style %} velin-faq--pill{% endif %}">
        {% if show_description_faq %}
          <div class="velin-faq__item" data-faq-default-open>
            <button type="button" class="velin-faq__row" data-faq-toggle>
              {% if section.settings.faq_pill_style %}
                <span class="velin-faq__icon">
                  {% case section.settings.description_faq_icon %}
                    {% when 'book' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                    {% when 'sliders' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21v-7"></path><path d="M4 10V3"></path><path d="M12 21v-9"></path><path d="M12 8V3"></path><path d="M20 21v-5"></path><path d="M20 12V3"></path><path d="M1 14h6"></path><path d="M9 8h6"></path><path d="M17 16h6"></path></svg>
                    {% when 'washer' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="2" width="18" height="20" rx="2"></rect><circle cx="12" cy="13" r="6"></circle></svg>
                    {% when 'season' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"></path></svg>
                    {% when 'truck' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                    {% when 'return' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"></path><path d="M21 17a9 9 0 0 0-15-6.7L3 13"></path></svg>
                    {% when 'star' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  {% endcase %}
                </span>
              {% endif %}
              <p class="velin-faq__question">{{ section.settings.description_faq_label }}</p>
              {% if section.settings.faq_pill_style %}
                <span class="velin-faq__chevron" data-faq-chevron><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
              {% else %}
                <span class="velin-faq__plus" data-faq-plus></span>
              {% endif %}
            </button>
            <div class="velin-faq__divider"></div>
            <div class="velin-faq__answer" data-faq-answer>
              <div class="velin-faq__answer-inner">
                {{ product.description }}
              </div>
            </div>
          </div>
        {% endif %}
        {% for block in section.blocks %}
          {% if block.type == 'faq_item' %}
            <div class="velin-faq__item" {{ block.shopify_attributes }}>
              <button type="button" class="velin-faq__row" data-faq-toggle>
                {% if section.settings.faq_pill_style %}
                  <span class="velin-faq__icon">
                    {% case block.settings.icon_type %}
                      {% when 'book' %}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                      {% when 'sliders' %}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21v-7"></path><path d="M4 10V3"></path><path d="M12 21v-9"></path><path d="M12 8V3"></path><path d="M20 21v-5"></path><path d="M20 12V3"></path><path d="M1 14h6"></path><path d="M9 8h6"></path><path d="M17 16h6"></path></svg>
                      {% when 'washer' %}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="2" width="18" height="20" rx="2"></rect><circle cx="12" cy="13" r="6"></circle></svg>
                      {% when 'season' %}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"></path></svg>
                      {% when 'truck' %}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                      {% when 'return' %}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"></path><path d="M21 17a9 9 0 0 0-15-6.7L3 13"></path></svg>
                      {% when 'star' %}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                    {% endcase %}
                  </span>
                {% endif %}
                <p class="velin-faq__question">{{ block.settings.question }}</p>
                {% if section.settings.faq_pill_style %}
                  <span class="velin-faq__chevron" data-faq-chevron><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
                {% else %}
                  <span class="velin-faq__plus" data-faq-plus></span>
                {% endif %}
              </button>
              <div class="velin-faq__divider"></div>
              <div class="velin-faq__answer" data-faq-answer>
                <div class="velin-faq__answer-inner">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

  </div>

  <script type="application/json" data-pdp-product>{{ product | json }}</script>
  <script type="application/json" data-pdp-color-media>{{ color_media_map }}</script>
</div>

{% unless section.settings.hide_native_purchase %}
<div class="velin-pdp__sticky-atc" data-sticky-atc>
  <div class="velin-pdp__sticky-atc-inner">
    <div class="velin-pdp__sticky-atc-info">
      {%- if product.featured_image -%}
        <img class="velin-pdp__sticky-atc-image" src="{{ product.featured_image | image_url: width: 100 }}" alt="" loading="lazy">
      {%- endif -%}
      <div class="velin-pdp__sticky-atc-text">
        <p class="velin-pdp__sticky-atc-title">{{ product.title }}</p>
        <p class="velin-pdp__sticky-atc-price" data-sticky-atc-price>{{ product.selected_or_first_available_variant.price | money }}</p>
      </div>
    </div>
    <button
      type="button"
      class="velin-pdp__sticky-atc-btn"
      data-sticky-atc-btn
      style="background: {{ section.settings.atc_bg }}; color: {{ section.settings.atc_color }};"
    >{{ section.settings.atc_text }}</button>
  </div>
</div>
{% endunless %}

<style>
  .velin-pdp {
    max-width: 1445px;
    margin: 0 auto;
    box-sizing: border-box;
    display: flex;
    align-items: flex-start;
    font-family: 'Merriweather', serif;
    color: #000;
    padding-top: 24px !important;
    padding-bottom: 24px !important;
  }

  .velin-pdp__media {
    flex: 0 0 auto;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 20px;
  }

  .velin-pdp__main-image {
    position: relative;
    width: 100%;
    max-height: 72vh;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .velin-pdp__main-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .velin-pdp__main-image img[hidden] {
    display: none;
  }

  .velin-pdp__main-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .velin-pdp__main-video[hidden] {
    display: none;
  }

  .velin-pdp__main-video-el {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    border: none;
  }

  .velin-pdp__thumb-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .velin-pdp__main-image.is-sold-out img {
    filter: grayscale(70%);
    opacity: 0.75;
  }

  .velin-pdp__sold-out-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 1;
    background: #1a1a1a;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 4px;
  }

  .velin-pdp__thumbs {
    display: flex;
    overflow-x: auto;
  }

  .velin-pdp__thumb {
    position: relative;
    flex: 0 0 auto;
    height: 100%;
    aspect-ratio: 1 / 1;
    border: none;
    padding: 0;
    background: #fff;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 2px 2px 6.5px 0px #00000040;
  }

  .velin-pdp__thumb.is-active {
    outline: 2px solid {{ section.settings.accent_color }};
  }

  .velin-pdp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .velin-pdp__media-grid {
    display: none;
  }

  @media screen and (min-width: 1101px) {
    .velin-pdp__media-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    {% if section.settings.show_media_grid %}
      .velin-pdp__thumbs {
        display: none;
      }
    {% endif %}
  }

  .velin-pdp__media-grid-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }

  .velin-pdp__info {
    max-width: 100%;
    display: flex;
    flex-direction: column;
  }

  .velin-pdp__badge {
    width: fit-content;
    min-width: 506px;
    max-width: 100%;
    box-sizing: border-box;
    padding: 12px 20px;
    border-radius: 6px;
    font-family: 'Lusitana', serif;
    font-weight: 400;
    line-height: 100%;
    text-transform: uppercase;
    text-align: center;
  }

  .velin-pdp__social {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .velin-pdp__avatars {
    display: inline-flex;
  }

  .velin-pdp__avatars img {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #fff;
    margin-left: -8px;
  }

  .velin-pdp__avatars img:first-child {
    margin-left: 0;
  }

  .velin-verified-badge {
    flex-shrink: 0;
  }

  .velin-pdp__social-text {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    font-weight: 400;
    font-size: 16px;
    line-height: 100%;
  }

  .velin-pdp__title-price-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .velin-pdp__title {
    font-family: 'Lusitana', serif;
    font-weight: 400;
    line-height: 100%;
    text-transform: uppercase;
    margin: 0;
    color: #201E50;
  }

  .velin-pdp__price-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .velin-pdp__launch-badge {
    display: inline-block;
    align-self: flex-start;
    width: fit-content;
    margin: 8px 0 0;
    padding: 6px 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 100%;
    white-space: nowrap;
  }

  .velin-pdp__free-shipping {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 10px;
    margin-bottom: 12px;
    font-family: 'Merriweather', serif;
    font-size: 13px;
    font-weight: 500;
    color: #1a1a1a;
    text-align: center;
  }

  .velin-pdp__free-shipping svg {
    flex: 0 0 auto;
    color: {{ section.settings.accent_color }};
  }

  .velin-pdp__compare {
    font-size: 14px;
    font-weight: 400;
    line-height: 100%;
  }

  .velin-pdp__price {
    font-weight: 700;
