{% comment %}
  VELIN — Hero Section (Background + Heading + Scroll down + Reviews with Drag Slider)
  Standalone section, Theme Customizer se editable.
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&family=Aldrich&display=swap" rel="stylesheet">

{%- assign sec_id = section.id -%}

<style>
  #velin-hero-{{ sec_id }} * { margin: 0; padding: 0; box-sizing: border-box; }

  #velin-hero-{{ sec_id }} .velin-main-container {
    width: 100%;
    min-height: 100vh;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    {% if section.settings.hero_image != blank %}
      background-image: url('{{ section.settings.hero_image | image_url: width: 2400 }}');
    {% else %}
      background: linear-gradient(135deg, #6b5442, #3d2f24);
    {% endif %}
    display: flex;
    flex-direction: column;
    position: relative;
  }

  /* ---------- Hero text ---------- */
  #velin-hero-{{ sec_id }} .velin-main-content {
    width: 100%;
    display: flex;
    padding-top: 74px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    transform: translateY({{ section.settings.heading_offset }}px);
  }
  #velin-hero-{{ sec_id }} .velin-main-content p {
    font-size: 28px;
    padding: 20px;
    font-family: "Manrope", sans-serif;
    color: #fff;
    font-weight: 500;
    letter-spacing: 2px;
  }
  #velin-hero-{{ sec_id }} .velin-main-content h1 {
    font-family: "Aldrich", sans-serif;
    font-size: 78px;
    color: #fff;
    line-height: 1.05;
    padding: 0 20px;
  }

  /* ---------- Scroll down button ---------- */
  #velin-hero-{{ sec_id }} .velin-main-content2 {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: {{ section.settings.scroll_btn_spacing }}px 0;
    transform: translateY({{ section.settings.scroll_btn_offset }}px);
  }
  #velin-hero-{{ sec_id }} .velin-scroll-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.scroll_btn_width }}px;
    height: {{ section.settings.scroll_btn_height }}px;
    box-sizing: border-box;
    padding: {{ section.settings.scroll_btn_padding_v }}px {{ section.settings.scroll_btn_padding_h }}px;
    border-radius: {{ section.settings.scroll_btn_radius }}px;
    border: {{ section.settings.scroll_btn_border_width }}px solid {{ section.settings.scroll_btn_border_color }};
    background: {{ section.settings.scroll_btn_bg_color }};
    background: color-mix(in srgb, {{ section.settings.scroll_btn_bg_color }} {{ section.settings.scroll_btn_bg_opacity }}%, transparent);
    color: {{ section.settings.scroll_btn_text_color }};
    font-family: "Manrope", sans-serif;
    font-weight: 500;
    font-size: {{ section.settings.scroll_btn_font_size }}px;
    line-height: 140%;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  #velin-hero-{{ sec_id }} .velin-scroll-btn:hover {
    background: color-mix(in srgb, {{ section.settings.scroll_btn_bg_color }} calc({{ section.settings.scroll_btn_bg_opacity }}% + 12%), transparent);
  }

  /* ---------- Reviews (Slider Setup) ---------- */
  #velin-hero-{{ sec_id }} .velin-main-content3 {
    width: 100%;
    display: flex;
    margin-top: auto;
    padding: 40px 20px 60px;
    overflow: hidden; /* Slider ko screen se baahar nikalne se rokne ke liye */
  }
  #velin-hero-{{ sec_id }} .velin-reviews-row {
    width: 100%;
    display: flex;
    align-items: stretch;
    justify-content: flex-start; /* Taake cards left se align ho kar scroll karein */
    gap: 40px;
    flex-wrap: nowrap; /* TAAKE CARDS EK HI LINE MEIN RAHEIN */
    overflow-x: auto; /* Scroll bar logic activate */
    cursor: grab; /* Mouse cursor hand jaisa banaye */
    scrollbar-width: none; /* Firefox ke liye scrollbar khayb */
    -webkit-overflow-scrolling: touch; /* Mobile touch smooth karne ke liye */
    padding-bottom: 10px;
    user-select: none; /* Drag karte waqt text select na ho */
    -webkit-user-select: none;
  }
  
  /* Chrome/Safari ke liye scrollbar chupane ke liye */
  #velin-hero-{{ sec_id }} .velin-reviews-row::-webkit-scrollbar {
    display: none;
  }

  #velin-hero-{{ sec_id }} .velin-reviews-row:active {
    cursor: grabbing; /* Jab drag karein to pakadne wala icon ban jaye */
  }

  #velin-hero-{{ sec_id }} .velin-review-card {
    width: 300px;
    flex-shrink: 0; /* TAAKE CARDS SQUEEZE/CHOTE NA HOIN */
    min-height: 150px;
    background-color: #00000047;
    backdrop-filter: blur(4px);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 18px 16px;
    gap: 10px;
  }
  #velin-hero-{{ sec_id }} .velin-stars {
    display: flex;
    justify-content: center;
    gap: 2px;
  }
  #velin-hero-{{ sec_id }} .velin-stars svg {
    width: 22px;
    height: 22px;
    fill: #fff;
  }
  #velin-hero-{{ sec_id }} .velin-review-text {
    color: #fff;
    font-family: "Manrope", sans-serif;
    font-size: 11px;
    font-weight: 500;
    text-align: center;
    line-height: 1.5;
  }
  #velin-hero-{{ sec_id }} .velin-review-author {
    font-family: "Manrope", sans-serif;
    font-size: 12px;
    color: #fff;
    text-align: center;
    letter-spacing: 1px;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1024px) {
    #velin-hero-{{ sec_id }} .velin-main-content h1 { font-size: 56px; }
    #velin-hero-{{ sec_id }} .velin-main-content p { font-size: 22px; }
    #velin-hero-{{ sec_id }} .velin-reviews-row { gap: 20px; }
  }
  @media (max-width: 860px) {
    #velin-hero-{{ sec_id }} .velin-review-card { width: 280px; } /* Mobile par b size control rakha */
  }
  @media (max-width: 600px) {
    #velin-hero-{{ sec_id }} .velin-main-content h1 { font-size: 36px; }
    #velin-hero-{{ sec_id }} .velin-main-content p { font-size: 15px; letter-spacing: 1px; }
  }
</style>

<div id="velin-hero-{{ sec_id }}">
  <div class="velin-main-container">

    <!-- ============ HERO TEXT ============ -->
    <div class="velin-main-content">
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1>{{ section.settings.heading }}</h1>
      {%- endif -%}
    </div>

    <!-- ============ SCROLL DOWN ============ -->
    {%- if section.settings.show_scroll -%}
      <div class="velin-main-content2">
        <a href="{{ section.settings.scroll_btn_link | default: '/collections/all' }}" class="velin-scroll-btn">{{ section.settings.scroll_text }}</a>
      </div>
    {%- endif -%}

    <!-- ============ REVIEWS ============ -->
    {%- if section.blocks.size > 0 -%}
      <div class="velin-main-content3">
        <div class="velin-reviews-row data-velin-drag-slider">
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              <div class="velin-review-card" {{ block.shopify_attributes }}>
                <div class="velin-stars">
                  {%- for i in (1..block.settings.stars) -%}
                    <svg viewBox="0 0 24 24"><path d="M12 2l3 6.6 7 .7-5.2 4.8 1.5 7L12 17.5 5.7 21l1.5-7L2 9.3l7-.7L12 2z"/></svg>
                  {%- endfor -%}
                </div>
                <p class="velin-review-text">{{ block.settings.text }}</p>
                <p class="velin-review-author">{{ block.settings.author }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('velin-hero-{{ sec_id }}');
    if (!root) return;

    // --- Mouse Drag-to-Scroll Slider Functionality ---
    var slider = root.querySelector('.data-velin-drag-slider');
    if (slider) {
      let isDown = false;
      let startX;
      let scrollLeft;

      slider.addEventListener('mousedown', function (e) {
        isDown = true;
        e.preventDefault(); // Text selection shuru hi na ho
        startX = e.pageX - slider.offsetLeft;
        scrollLeft = slider.scrollLeft;
      });

      slider.addEventListener('mouseleave', function () {
        isDown = false;
      });

      slider.addEventListener('mouseup', function () {
        isDown = false;
      });

      slider.addEventListener('mousemove', function (e) {
        if (!isDown) return;
        e.preventDefault();
        var x = e.pageX - slider.offsetLeft;
        var walk = (x - startX) * 2; // Drag ki speed barhane ke liye ye multiplier '2' use kiya hai
        slider.scrollLeft = scrollLeft - walk;
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Velin Hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero background image" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "PLUS DE 60,000 CLIENTS SATISFAITS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "CONÇU POUR LA MUSE MODERNE" },
    { "type": "range", "id": "heading_offset", "label": "Move headings up/down (px)", "info": "Negative = up, positive = down", "min": -200, "max": 200, "step": 5, "default": 0 },
    { "type": "checkbox", "id": "show_scroll", "label": "Show scroll down button", "default": true },
    { "type": "text", "id": "scroll_text", "label": "Scroll down button text", "default": "DÉCOUVRIR LA COLLECTION" },
    { "type": "url", "id": "scroll_btn_link", "label": "Button link", "info": "Khali chhodo toh /collections/all khulega." },
    { "type": "range", "id": "scroll_btn_spacing", "label": "Button top/bottom spacing (px)", "min": 0, "max": 100, "step": 2, "default": 30 },
    { "type": "range", "id": "scroll_btn_offset", "label": "Move button up/down (px)", "info": "Negative = up, positive = down", "min": -200, "max": 200, "step": 5, "default": 0 },
    { "type": "range", "id": "scroll_btn_width", "label": "Button width (px)", "min": 200, "max": 300, "step": 1, "default": 291 },
    { "type": "range", "id": "scroll_btn_height", "label": "Button height (px)", "min": 30, "max": 100, "step": 1, "default": 50 },
    { "type": "range", "id": "scroll_btn_padding_v", "label": "Button padding vertical (px)", "min": 6, "max": 30, "step": 1, "default": 14 },
    { "type": "range", "id": "scroll_btn_padding_h", "label": "Button padding horizontal (px)", "min": 10, "max": 60, "step": 1, "default": 20 },
    { "type": "range", "id": "scroll_btn_radius", "label": "Button corner radius (px)", "min": 0, "max": 40, "step": 1, "default": 8 },
    { "type": "range", "id": "scroll_btn_border_width", "label": "Button border width (px)", "min": 0, "max": 5, "step": 1, "default": 1 },
    { "type": "range", "id": "scroll_btn_font_size", "label": "Button text size (px)", "min": 10, "max": 22, "step": 1, "default": 16 },
    { "type": "color", "id": "scroll_btn_border_color", "label": "Button border color", "default": "#FFFFFF" },
    { "type": "color", "id": "scroll_btn_bg_color", "label": "Button background color", "default": "#FFFFFF" },
    { "type": "range", "id": "scroll_btn_bg_opacity", "label": "Button background opacity (%)", "min": 0, "max": 100, "step": 1, "default": 12 },
    { "type": "color", "id": "scroll_btn_text_color", "label": "Button text color", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review text", "default": "La qualité est exceptionnelle, je suis vraiment satisfait de mon achat, je recommande vivement !" },
        { "type": "text", "id": "author", "label": "Author", "default": "THOMAS M. ✓ CLIENT VÉRIFIÉ" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Velin Hero",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
