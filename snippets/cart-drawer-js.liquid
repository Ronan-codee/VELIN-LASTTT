<script>
  (function () {
    // Cart reservation timer: starts the first time the drawer shows a non-empty cart, survives page
    // changes (localStorage) and, once it has run out, stays on the stock message until the cart is emptied.
    var KEY = "velin_cart_timer_start";
    var DURATION = 10 * 60 * 1000;
    function read() { try { return parseInt(localStorage.getItem(KEY), 10) || 0; } catch (e) { return 0; } }
    function write(v) { try { if (v) localStorage.setItem(KEY, String(v)); else localStorage.removeItem(KEY); } catch (e) {} }
    function pad(n) { return (n < 10 ? "0" : "") + n; }

    function tick() {
      if (document.querySelector("[data-cart-urgency-reset]")) { write(0); return; }
      var box = document.querySelector("[data-cart-urgency]");
      if (!box) return;
      var start = read();
      if (!start) { start = Date.now(); write(start); }
      var left = DURATION - (Date.now() - start);
      var text = box.querySelector("[data-cart-urgency-text]");
      if (left <= 0) {
        box.classList.add("is-expired");
        text.textContent = "Finalise ta commande avant que les stocks partent !";
        return;
      }
      box.classList.remove("is-expired");
      var secs = Math.ceil(left / 1000);
      text.textContent = "Ton panier est réservé pendant " + pad(Math.floor(secs / 60)) + ":" + pad(secs % 60);
    }

    tick();
    setInterval(tick, 500);
    // The drawer is replaced after every cart change: refresh the fresh copy right away.
    var drawer = document.querySelector("[data-cart-drawer]");
    if (drawer && drawer.parentNode) new MutationObserver(tick).observe(drawer.parentNode, { childList: true });
  })();
</script>

<script>
  (function () {
    function drawerRoot() {
      return document.querySelector('[data-cart-drawer]');
    }

    function updateCounts(cart) {
      document.querySelectorAll('[data-cart-count]').forEach(function (el) {
        el.textContent = cart.item_count;
        el.classList.toggle('is-empty', cart.item_count === 0);
      });
    }

    function formatMoney(cents) {
      return (cents / 100).toLocaleString('fr-FR', {
        style: 'currency',
        currency: window.Shopify && Shopify.currency ? Shopify.currency.active : 'EUR',
      });
    }

    function open() {
      var root = drawerRoot();
      if (!root) return;
      root.classList.add('is-open');
      root.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden';
    }

    function close() {
      var root = drawerRoot();
      if (!root) return;
      root.classList.remove('is-open');
      root.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
    }

    function refresh(cart) {
      if (cart) updateCounts(cart);
      return fetch(window.location.pathname + '?section_id=cart-drawer', { cache: 'no-store' })
        .then(function (res) { return res.text(); })
        .then(function (html) {
          var tmp = document.createElement('div');
          tmp.innerHTML = html;
          var fresh = tmp.querySelector('[data-cart-drawer]');
          var root = drawerRoot();
          if (!fresh || !root) return;
          var wasOpen = root.classList.contains('is-open');
          root.replaceWith(fresh);
          if (wasOpen) open();
        });
    }


    // Adds are followed by /cart.js (counts) + the re-rendered drawer. Run both at once, open the drawer
    // as soon as the add succeeded (dimmed, with a spinner) and share one run between every caller, so
    // an add handled by both the page script and the fetch hook below does the work only once.
    var refreshing = null;
    function refreshAndOpen() {
      if (refreshing) return refreshing;
      var current = drawerRoot();
      if (current) {
        current.classList.add('is-loading');
        open();
      }
      refreshing = Promise.all([
        nativeFetch('/cart.js', { cache: 'no-store' }).then(function (res) { return res.json(); }).catch(function () { return null; }),
        nativeFetch(window.location.pathname + '?section_id=cart-drawer', { cache: 'no-store' }).then(function (res) { return res.text(); }),
      ])
        .then(function (results) {
          if (results[0]) updateCounts(results[0]);
          var tmp = document.createElement('div');
          tmp.innerHTML = results[1];
          var fresh = tmp.querySelector('[data-cart-drawer]');
          var root = drawerRoot();
          if (fresh && root) root.replaceWith(fresh);
          open();
        })
        .catch(function () {
          var root = drawerRoot();
          if (root) root.classList.remove('is-loading');
        })
        .then(function () { refreshing = null; });
      return refreshing;
    }

    function changeLine(line, quantity) {
      return fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ line: line, quantity: quantity }),
      })
        .then(function (res) { return res.json(); })
        .then(function (cart) { return refresh(cart); });
    }

    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-cart-drawer-toggle]')) {
        e.preventDefault();
        open();
        return;
      }

      if (e.target.closest('[data-cart-drawer-close]')) {
        var link = e.target.closest('a[data-cart-drawer-close]');
        if (!link) e.preventDefault();
        close();
        return;
      }

      var incBtn = e.target.closest('[data-cart-drawer-increase]');
      if (incBtn) {
        var incRow = incBtn.closest('[data-cart-drawer-line]');
        var incQtyEl = incRow.querySelector('[data-cart-drawer-qty-value]');
        var incPriceEl = incRow.querySelector('[data-cart-drawer-line-price]');
        var newIncQty = parseInt(incQtyEl.textContent, 10) + 1;
        incQtyEl.textContent = newIncQty;
        if (incPriceEl) {
          var incUnit = parseFloat(incPriceEl.getAttribute('data-cart-drawer-line-price'));
          incPriceEl.textContent = formatMoney(incUnit * newIncQty);
        }
        changeLine(parseInt(incRow.getAttribute('data-cart-drawer-line'), 10), newIncQty);
        return;
      }

      var decBtn = e.target.closest('[data-cart-drawer-decrease]');
      if (decBtn) {
        var decRow = decBtn.closest('[data-cart-drawer-line]');
        var decQtyEl = decRow.querySelector('[data-cart-drawer-qty-value]');
        var nextQty = parseInt(decQtyEl.textContent, 10) - 1;
        if (nextQty < 1) return;
        decQtyEl.textContent = nextQty;
        var decPriceEl = decRow.querySelector('[data-cart-drawer-line-price]');
        if (decPriceEl) {
          var decUnit = parseFloat(decPriceEl.getAttribute('data-cart-drawer-line-price'));
          decPriceEl.textContent = formatMoney(decUnit * nextQty);
        }
        changeLine(parseInt(decRow.getAttribute('data-cart-drawer-line'), 10), nextQty);
        return;
      }

      var rmBtn = e.target.closest('[data-cart-drawer-remove]');
      if (rmBtn) {
        var rmRow = rmBtn.closest('[data-cart-drawer-line]');
        var rmLine = parseInt(rmRow.getAttribute('data-cart-drawer-line'), 10);
        rmRow.remove();
        changeLine(rmLine, 0);
        return;
      }

      var wLineAdd = e.target.closest('[data-cart-drawer-upsell-line-add]');
      if (wLineAdd) {
        var wLineWrap = wLineAdd.closest('[data-cart-drawer-upsell-line]');
        var wVariantId = wLineWrap.getAttribute('data-variant-id');
        wLineAdd.disabled = true;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: wVariantId, quantity: 1 }] }),
        })
          .then(function (res) { return res.json(); })
          .then(function () { return fetch('/cart.js'); })
          .then(function (res) { return res.json(); })
          .then(function (cart) { return refresh(cart); })
          .finally(function () { wLineAdd.disabled = false; });
        return;
      }

      // Mode oreiller : choix du motif et de la taille de la taie.
      var taieChip = e.target.closest('[data-taie-chip]');
      if (taieChip && !taieChip.disabled) {
        var taieBox = taieChip.closest('[data-taie-upsell]');
        var axis = taieChip.getAttribute('data-axis');
        taieChip.parentNode.querySelectorAll('[data-taie-chip]').forEach(function (c) {
          var on = c === taieChip;
          c.classList.toggle('is-selected', on);
          c.setAttribute('aria-checked', on ? 'true' : 'false');
        });
        taieBox.setAttribute(axis === 'm' ? 'data-motif' : 'data-size', taieChip.getAttribute('data-value'));
        var list = [];
        try { list = JSON.parse(taieBox.getAttribute('data-variants')) || []; } catch (err) {}
        var pick = list.filter(function (v) { return v.s === taieBox.getAttribute('data-size') && v.m === taieBox.getAttribute('data-motif'); })[0];
        var addBtn = taieBox.querySelector('[data-taie-add]');
        taieBox.setAttribute('data-variant-id', pick && pick.a ? pick.id : '');
        if (addBtn) addBtn.disabled = !(pick && pick.a);
        var th = taieBox.querySelector('[data-taie-thumb]');
        if (th && pick && pick.i) { th.src = pick.i; th.hidden = false; }
        return;
      }

      // Mode oreiller : ajout d'une taie (une seule, à la taille choisie).
      var taieAdd = e.target.closest('[data-taie-add]');
      if (taieAdd) {
        var taieWrap = taieAdd.closest('[data-taie-upsell]');
        var taieId = taieWrap.getAttribute('data-variant-id');
        if (!taieId) return;
        taieAdd.disabled = true;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: taieId, quantity: 1 }] }),
        })
          .then(function (res) { return res.json(); })
          .then(function () { return fetch('/cart.js'); })
          .then(function (res) { return res.json(); })
          .then(function (cart) { return refresh(cart); })
          .finally(function () { taieAdd.disabled = false; });
        return;
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });

    window.VelinCartDrawer = { open: open, close: close, refresh: refresh, refreshAndOpen: refreshAndOpen };

    // Opens the drawer after ANY successful /cart/add call, including ones
    // triggered by third-party apps (e.g. the bundle picker) that don't know
    // about window.VelinCartDrawer. Our own quick-add flows already call
    // open()/refresh() directly; this just adds a safety net for the rest.
    var nativeFetch = window.fetch;
    window.fetch = function (input, init) {
      var url = typeof input === 'string' ? input : (input && input.url) || '';
      var isCartAdd = url.indexOf('/cart/add') !== -1;
      return nativeFetch.apply(this, arguments).then(function (response) {
        if (isCartAdd && response.ok) {
          refreshAndOpen();
        }
        return response;
      });
    };
  })();
</script>