{% comment %} Velin - Brand Story 2 (image left, text right, Figma: 1441 container, 30px gap) {% endcomment %}

<div class="velin-story2" style="
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_v }}px {{ section.settings.padding_h }}px;
  gap: {{ section.settings.column_gap }}px;
">

  <div class="velin-story2__image">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading_highlight | escape }}" loading="lazy">
    {% endif %}
  </div>

  <div class="velin-story2__text" style="gap: {{ section.settings.text_gap }}px;">

    <h2 class="velin-story2__heading" style="font-size: {{ section.settings.heading_size }}px;">
      {{ section.settings.heading_before }}
      <span class="velin-story2__highlight" style="background: {{ section.settings.highlight_bg }}; color: {{ section.settings.highlight_text_color }};">{{ section.settings.heading_highlight }}</span>
    </h2>

    {% if section.settings.body_text != blank %}
      <p class="velin-story2__body" style="font-size: {{ section.settings.body_size }}px;">
        {{ section.settings.body_text }}
      </p>
    {% endif %}

    {%- assign has_features = false -%}
    {% for block in section.blocks %}{% if block.type == 'feature_item' %}{% assign has_features = true %}{% endif %}{% endfor %}
    {% if has_features %}
      <div class="velin-story2__features" style="gap: {{ section.settings.feature_gap }}px;">
        {% for block in section.blocks %}
          {% if block.type == 'feature_item' %}
            <div class="velin-story2__feature" {{ block.shopify_attributes }}>
              <span class="velin-story2__feature-icon">
                {% if block.settings.icon_type == 'check' %}
                  <svg width="20" height="14" viewBox="0 0 20 14" fill="none"><path d="M1 7L7 13L19 1" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {% else %}
                  👜
                {% endif %}
              </span>
              <span class="velin-story2__feature-text">{{ block.settings.text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

  </div>

</div>

<style>
  .velin-story2 {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 1641px;
    margin: 0 auto;
    box-sizing: border-box;
    font-family: 'Merriweather', serif;
  }

  .velin-story2__image {
    flex: 1 1 505px;
    max-width: 505px;
  }

  .velin-story2__image img {
    width: 100%;
    height: {{ section.settings.image_height }}px;
    object-fit: cover;
    border-radius: {{ section.settings.image_radius }}px;
    display: block;
  }

  .velin-story2__text {
    display: flex;
    flex-direction: column;
    flex: 1 1 706px;
    max-width: 706px;
  }

  .velin-story2__heading {
    margin: 0;
    max-width: 1120px;
    font-family: 'Lusitana', serif;
    font-weight: 400;
    line-height: 100%;
    text-transform: capitalize;
    color: #000;
  }

  .velin-story2__highlight {
    padding: 2px 10px;
    border-radius: 6px;
  }

  .velin-story2__body {
    margin: 0;
    max-width: 690px;
    font-weight: 500;
    line-height: 150%;
    letter-spacing: 0.02em;
    text-transform: capitalize;
    color: rgba(0,0,0,0.7);
  }

  .velin-story2__features {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .velin-story2__feature {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .velin-story2__feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    font-size: 25px;
    flex: 0 0 30px;
  }

  .velin-story2__feature-text {
    font-weight: 500;
    font-size: 28px;
    line-height: 100%;
    text-transform: capitalize;
    color: #000;
    white-space: nowrap;
  }

  @media screen and (max-width: 1100px) {
    .velin-story2 {
      flex-direction: column;
      padding: 40px 20px !important;
      gap: 32px !important;
    }
    .velin-story2__text,
    .velin-story2__image {
      max-width: 100%;
      flex: 1 1 auto;
    }
    .velin-story2__feature-text {
      font-size: 18px;
      white-space: normal;
    }
  }
</style>

{% schema %}
{
  "name": "Velin Brand Story 2",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F7F7F7" },
    { "type": "range", "id": "padding_v", "label": "Padding top/bottom (px)", "min": 0, "max": 150, "step": 5, "default": 100 },
    { "type": "range", "id": "padding_h", "label": "Padding left/right (px)", "min": 0, "max": 150, "step": 5, "default": 100 },
    { "type": "range", "id": "column_gap", "label": "Gap image/text (px)", "min": 0, "max": 80, "step": 2, "default": 30 },
    { "type": "range", "id": "text_gap", "label": "Gap inside text column (px)", "min": 0, "max": 80, "step": 2, "default": 40 },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading_before", "label": "Heading - before highlight", "default": "Un Sac Conçu Pour Durer" },
    { "type": "text", "id": "heading_highlight", "label": "Heading - highlighted word", "default": "Sac Iconique" },
    { "type": "range", "id": "heading_size", "label": "Heading size (px)", "min": 20, "max": 60, "step": 1, "default": 40 },
    { "type": "color", "id": "highlight_bg", "label": "Highlight background", "default": "#AA8870" },
    { "type": "color", "id": "highlight_text_color", "label": "Highlight text color", "default": "#FFFFFF" },
    { "type": "header", "content": "Body text" },
    { "type": "textarea", "id": "body_text", "label": "Body text", "default": "Confectionné avec des matériaux de haute qualité et un savoir-faire expert, ce sac est pensé pour une élégance quotidienne. Il offre l'équilibre parfait entre style, durabilité et fonctionnalité, devenant votre compagnon idéal pour le travail, les voyages et le quotidien." },
    { "type": "range", "id": "body_size", "label": "Body text size (px)", "min": 14, "max": 36, "step": 1, "default": 28 },
    { "type": "header", "content": "Features" },
    { "type": "range", "id": "feature_gap", "label": "Gap between features (px)", "min": 0, "max": 60, "step": 1, "default": 28 },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "image_height", "label": "Image height (px)", "min": 300, "max": 800, "step": 5, "default": 600 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius (px)", "min": 0, "max": 40, "step": 1, "default": 14 }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature item",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Checkmark" },
            { "value": "bag", "label": "Bag emoji" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Cuir Premium" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Velin Brand Story 2",
      "blocks": [
        { "type": "feature_item", "settings": { "icon_type": "check", "text": "Cuir Premium" } },
        { "type": "feature_item", "settings": { "icon_type": "bag", "text": "Design Spacieux" } }
      ]
    }
  ]
}
{% endschema %}