[
  {
    "name": "theme_info",
    "theme_name": "Velin",
    "theme_version": "0.2.0",
    "theme_author": "Velin",
    "theme_documentation_url": "https://shopify.dev/docs/themes",
    "theme_support_url": "https://shopify.dev/docs/themes"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#241D16"
      },
      {
        "type": "color",
        "id": "color_brown",
        "label": "Brand brown",
        "info": "Features bar, footer",
        "default": "#8A7157"
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "Dark",
        "info": "Announcement bar, review cards",
        "default": "#2B241D"
      },
      {
        "type": "color",
        "id": "color_beige",
        "label": "Beige",
        "info": "Section backgrounds",
        "default": "#F4F1EC"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Gold",
        "info": "Review stars",
        "default": "#D9A441"
      },
      {
        "type": "color",
        "id": "color_cream",
        "label": "Cream",
        "info": "Text on brown backgrounds",
        "default": "#F1EAE0"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Button",
        "default": "#241D16"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Button text",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "playfair_display_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Logo & favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  }
]
