{% doc %}
  @prompt
    Create an announcement bar that rotates through 3 different text messages with a 2-second interval between each. The bar should smoothly transition between the messages in a loop. Each message should be customizable from the theme editor settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding }}px 20px;
    text-align: center;
    overflow: hidden;
    position: relative;
  }

  .ai-announcement-bar__container-{{ ai_gen_id }} {
    position: relative;
    display: grid;
    align-items: center;
    justify-items: center;
  }

  .ai-announcement-bar__message-{{ ai_gen_id }} {
    grid-area: 1 / 1;
    transform: translateY(14px);
    width: 100%;
    font-size: {{ block.settings.font_size }}px;
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 20px;
  }

  .ai-announcement-bar__message-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-announcement-bar__message-{{ ai_gen_id }}.is-promo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    text-align: left;
    overflow: visible;
    font-family: 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  }

  .ai-announcement-bar__promo-title-{{ ai_gen_id }} {
    font-size: 1.55em;
    font-weight: 700;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .ai-announcement-bar__promo-sub-{{ ai_gen_id }} {
    font-size: 1.1em;
    line-height: 1.3;
  }

  .ai-announcement-bar__countdown-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .ai-announcement-bar__unit-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 2.4em;
  }

  .ai-announcement-bar__num-{{ ai_gen_id }} {
    font-size: 2.1em;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .ai-announcement-bar__label-{{ ai_gen_id }} {
    font-size: 0.95em;
    line-height: 1.2;
  }

  .ai-announcement-bar__sep-{{ ai_gen_id }} {
    font-size: 1.6em;
    font-weight: 700;
    line-height: 1.6;
  }

  .ai-announcement-bar__message-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-announcement-bar__message-{{ ai_gen_id }} a:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar__message-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }

    .ai-announcement-bar__message-{{ ai_gen_id }}.is-promo {
      gap: 14px;
      padding: 0 8px;
    }

    .ai-announcement-bar__promo-title-{{ ai_gen_id }} {
      font-size: 1.25em;
    }

    .ai-announcement-bar__promo-sub-{{ ai_gen_id }} {
      font-size: 0.9em;
    }

    .ai-announcement-bar__num-{{ ai_gen_id }} {
      font-size: 1.7em;
    }
  }
{% endstyle %}

<announcement-bar-{{ ai_gen_id }}
  class="ai-announcement-bar-{{ ai_gen_id }}"
  data-interval="{{ block.settings.rotation_interval }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-announcement-bar__container-{{ ai_gen_id }}">
    {% if block.settings.message_1 != blank %}
      <div class="ai-announcement-bar__message-{{ ai_gen_id }}" data-message="1">
        {{ block.settings.message_1 }}
      </div>
    {% endif %}

    {% if block.settings.promo_title != blank %}
      <div class="ai-announcement-bar__message-{{ ai_gen_id }} is-promo" data-message="promo" data-end="{{ block.settings.countdown_end }}">
        <div class="ai-announcement-bar__promo-text-{{ ai_gen_id }}">
          <div class="ai-announcement-bar__promo-title-{{ ai_gen_id }}">{{ block.settings.promo_title }}</div>
          <div class="ai-announcement-bar__promo-sub-{{ ai_gen_id }}">{{ block.settings.promo_subtitle }}</div>
        </div>
        <div class="ai-announcement-bar__countdown-{{ ai_gen_id }}">
          <div class="ai-announcement-bar__unit-{{ ai_gen_id }}"><span class="ai-announcement-bar__num-{{ ai_gen_id }}" data-unit="h">00</span><span class="ai-announcement-bar__label-{{ ai_gen_id }}">Heures</span></div>
          <span class="ai-announcement-bar__sep-{{ ai_gen_id }}">:</span>
          <div class="ai-announcement-bar__unit-{{ ai_gen_id }}"><span class="ai-announcement-bar__num-{{ ai_gen_id }}" data-unit="m">00</span><span class="ai-announcement-bar__label-{{ ai_gen_id }}">Mins</span></div>
          <span class="ai-announcement-bar__sep-{{ ai_gen_id }}">:</span>
          <div class="ai-announcement-bar__unit-{{ ai_gen_id }}"><span class="ai-announcement-bar__num-{{ ai_gen_id }}" data-unit="s">00</span><span class="ai-announcement-bar__label-{{ ai_gen_id }}">Secs</span></div>
        </div>
      </div>
    {% endif %}

    {% if block.settings.message_2 != blank %}
      <div class="ai-announcement-bar__message-{{ ai_gen_id }}" data-message="2">
        {{ block.settings.message_2 }}
      </div>
    {% endif %}

    {% if block.settings.message_3 != blank %}
      <div class="ai-announcement-bar__message-{{ ai_gen_id }}" data-message="3">
        {{ block.settings.message_3 }}
      </div>
    {% endif %}

    {% if block.settings.message_4 != blank %}
      <div class="ai-announcement-bar__message-{{ ai_gen_id }}" data-message="4">
        {{ block.settings.message_4 }}
      </div>
    {% endif %}
  </div>
</announcement-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.messages = [];
        this.interval = null;
      }

      connectedCallback() {
        this.messages = Array.from(this.querySelectorAll('.ai-announcement-bar__message-{{ ai_gen_id }}'));
        
        if (this.messages.length === 0) return;

        const intervalSeconds = parseInt(this.dataset.interval) || 2;
        this.intervalDuration = intervalSeconds * 1000;

        this.messages[0].classList.add('active');

        if (this.messages.length > 1) {
          this.startRotation();
        }

        const promo = this.querySelector('[data-end]');
        if (promo) this.startCountdown(promo);
      }

      startCountdown(promo) {
        const pad = (n) => String(n).padStart(2, '0');
        const parsed = Date.parse(promo.dataset.end);
        const fixedEnd = isNaN(parsed) ? null : parsed;
        const nodes = {
          h: promo.querySelector('[data-unit="h"]'),
          m: promo.querySelector('[data-unit="m"]'),
          s: promo.querySelector('[data-unit="s"]')
        };

        const tick = () => {
          const now = Date.now();
          let end = fixedEnd;
          if (end === null || end <= now) {
            // Pas de date valide ou date dépassée : le compte à rebours se relance chaque jour à minuit
            const d = new Date();
            d.setHours(24, 0, 0, 0);
            end = d.getTime();
          }
          const total = Math.max(0, Math.floor((end - now) / 1000));
          nodes.h.textContent = pad(Math.floor(total / 3600));
          nodes.m.textContent = pad(Math.floor((total % 3600) / 60));
          nodes.s.textContent = pad(total % 60);
        };

        tick();
        this.countdownInterval = setInterval(tick, 1000);
      }

      startRotation() {
        this.interval = setInterval(() => {
          this.messages[this.currentIndex].classList.remove('active');
          
          this.currentIndex = (this.currentIndex + 1) % this.messages.length;
          
          this.messages[this.currentIndex].classList.add('active');
        }, this.intervalDuration);
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
        if (this.countdownInterval) {
          clearInterval(this.countdownInterval);
        }
      }
    }

    customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Rotating announcement bar",
  "settings": [
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "richtext",
      "id": "message_1",
      "label": "Message 1",
      "default": "<p>Livraison gratuite à partir de 50€</p>"
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "Slide promo : titre (laisser vide pour désactiver)",
      "default": "DÉSTOCKAGE"
    },
    {
      "type": "text",
      "id": "promo_subtitle",
      "label": "Slide promo : sous-titre",
      "default": "Jusqu'à -50% sur tout le site !"
    },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "Slide promo : fin du compte à rebours",
      "info": "Format 2026-10-05T23:59:00+02:00. Vide ou dépassé : relance chaque jour à minuit."
    },
    {
      "type": "richtext",
      "id": "message_2",
      "label": "Message 2",
      "default": "<p>Retours gratuits sous 30 jours</p>"
    },
    {
      "type": "richtext",
      "id": "message_3",
      "label": "Message 3",
      "default": "<p>Service client disponible 7j/7</p>"
    },
    {
      "type": "richtext",
      "id": "message_4",
      "label": "Message 4",
      "default": "<p>Livraison offerte</p>"
    },
    {
      "type": "range",
      "id": "rotation_interval",
      "label": "Rotation interval",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 2
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#2B241D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F1EAE0"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#F1EAE0"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Rotating announcement bar"
    }
  ]
}
{% endschema %}
