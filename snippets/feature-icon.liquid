{%- comment -%}
  Renders a feature icon by name. Accepts: icon (pin|mic|truck|note|thumbs_up|phone)
{%- endcomment -%}
{%- case icon -%}
  {%- when 'pin' -%}
    <svg width="20" height="26" viewBox="0 0 24 30" fill="currentColor" aria-hidden="true">
      <path d="M8.5 15 L4 29 L9 26.5 L11 30 Z"/>
      <path d="M15.5 15 L20 29 L15 26.5 L13 30 Z"/>
      <circle cx="12" cy="3.4" r="2.4"/>
      <circle cx="17.2" cy="5.1" r="2.4"/>
      <circle cx="19.8" cy="9.8" r="2.4"/>
      <circle cx="18.6" cy="15" r="2.4"/>
      <circle cx="14.6" cy="18.1" r="2.4"/>
      <circle cx="9.4" cy="18.1" r="2.4"/>
      <circle cx="5.4" cy="15" r="2.4"/>
      <circle cx="4.2" cy="9.8" r="2.4"/>
      <circle cx="6.8" cy="5.1" r="2.4"/>
      <circle cx="12" cy="10.5" r="7.2"/>
    </svg>
  {%- when 'mic' -%}
    <svg width="22" height="24" viewBox="0 0 24 26" fill="none" aria-hidden="true">
      <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"/>
      <ellipse cx="10" cy="10" rx="3.2" ry="8" stroke="currentColor" stroke-width="1.5"/>
      <path d="M2 10h16" stroke="currentColor" stroke-width="1.5"/>
      <path d="M3.5 5.5c1.8 1.2 4 1.9 6.5 1.9s4.7-.7 6.5-1.9M3.5 14.5c1.8-1.2 4-1.9 6.5-1.9s4.7.7 6.5 1.9" stroke="currentColor" stroke-width="1.3"/>
